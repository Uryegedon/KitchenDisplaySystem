@model IEnumerable<SelfOrderingSystemKiosk.Models.IngredientItem>
@using SelfOrderingSystemKiosk.Services
@using SelfOrderingSystemKiosk.Models
@using System.Net
@using System.Text.Encodings.Web
@using System.Text.Json
@{
    ViewData["Title"] = "Kitchen/Supplies inventory";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    var catFilter = ViewBag.CategoryFilter as string ?? "all";
    var expiryFilter = ViewBag.ExpiryFilter as string ?? "all";
    var expiryToday = ViewBag.ExpiryToday is DateTime expiryTodayValue ? expiryTodayValue : AppClock.LocalNow.Date;
    var expiryMaxDate = ViewBag.ExpiryMaxDate is DateTime expiryMaxValue ? expiryMaxValue : expiryToday.AddDays(14);
    var expiryUntil = ViewBag.ExpiryUntil is DateTime expiryUntilValue ? expiryUntilValue : (DateTime?)null;
    var actionView = ViewBag.ActionView as string ?? "needs";
    var usageByIngredient = ViewBag.InventoryUsageByIngredient as Dictionary<string, InventoryUsageImpact> ?? new(StringComparer.OrdinalIgnoreCase);
    var actionCounts = ViewBag.InventoryActionCounts as Dictionary<string, int> ?? new(StringComparer.OrdinalIgnoreCase);
    string ActionTabUrl(string tab) => Url.Action("Index", "Inventory", new
    {
        area = "Admin",
        categoryFilter = catFilter,
        branchFilter = ViewBag.BranchFilter,
        expiryFilter,
        expiryUntil = expiryUntil?.ToString("yyyy-MM-dd"),
        actionView = tab
    }) ?? "#";
    int ActionCount(string tab) => actionCounts.TryGetValue(tab, out var count) ? count : 0;
    var categories = IngredientCategoryRegistry.All;
    var branchName = ViewData["BranchName"] as string ?? "Unknown";
    var isOwner = ViewBag.IsOwner == true;
    var autoPrint = ViewBag.AutoPrint == true;
    var printRows = (Model ?? Enumerable.Empty<SelfOrderingSystemKiosk.Models.IngredientItem>()).ToList();
    var importRows = ViewBag.ImportIngredientOptions as IEnumerable<SelfOrderingSystemKiosk.Models.IngredientItem> ?? printRows;
    var importIngredientOptionsJson = JsonSerializer.Serialize(importRows
        .OrderBy(i => i.Item ?? "", StringComparer.OrdinalIgnoreCase)
        .Select(i => new
        {
            id = i.Id,
            name = i.Item ?? "",
            unit = i.Unit ?? ""
        }));
    var printStockStats = ViewBag.PrintStockStats as Dictionary<string, SelfOrderingSystemKiosk.Controllers.PrintStockSummary> ?? new();
    var printGroupedRows = printRows
        .GroupBy(i => string.IsNullOrWhiteSpace(i.IngredientCategory) ? "Uncategorized" : i.IngredientCategory)
        .Select(g => new
        {
            Category = g.Key,
            Items = g.OrderBy(i => i.Item ?? "", StringComparer.OrdinalIgnoreCase).ToList()
        })
        .OrderBy(g => g.Category, StringComparer.OrdinalIgnoreCase)
        .ToList();
    var printLeftGroups = printGroupedRows.Take(0).ToList();
    var printRightGroups = printGroupedRows.Take(0).ToList();
    var printTargetRows = (int)Math.Ceiling(printGroupedRows.Sum(g => g.Items.Count + 1) / 2m);
    var printRunningRows = 0;
    foreach (var group in printGroupedRows)
    {
        if (printRunningRows < printTargetRows || printLeftGroups.Count == 0)
        {
            printLeftGroups.Add(group);
            printRunningRows += group.Items.Count + 1;
        }
        else
        {
            printRightGroups.Add(group);
        }
    }
}

<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
    <h2 style="margin: 0; font-size: 1.5em;">@branchName</h2>
    @if (isOwner)
    {
        <div style="display: flex; gap: 10px; align-items: center;">
            <span style="color: #888; font-size: 0.9em;">Select branch:</span>
            <select id="branchFilter" onchange="filterByBranch()" style="padding: 8px 12px; border: 2px solid #ddd; border-radius: 6px; font-size: 0.9em; min-width: 200px;">
                @foreach (var branch in ViewBag.AllBranches as List<SelfOrderingSystemKiosk.Areas.Admin.Models.Branch> ?? new List<SelfOrderingSystemKiosk.Areas.Admin.Models.Branch>())
                {
                    <option value="@branch.Id" selected="@(ViewBag.BranchFilter == branch.Id)">@branch.BranchName</option>
                }
            </select>
        </div>
    }
    else
    {
        <span style="color: #888; font-size: 0.9em;">Viewing your branch</span>
    }
</div>

