@model IEnumerable<SelfOrderingSystemKiosk.Models.IngredientItem>
@using SelfOrderingSystemKiosk.Services
@{
    ViewData["Title"] = "Ingredients inventory";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    var catFilter = ViewBag.CategoryFilter as string ?? "all";
    var categories = IngredientCategoryRegistry.All;
}

<div class="content fade-in">
    <div class="header" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px;">
        <div>
            <p style="margin-top: 0;">Kitchen ingredients (not shown on the customer kiosk). Data is in MongoDB collection <strong>Ingredients</strong>.</p>
            @if (ViewBag.ItemCount != null)
            {
                <p style="color: #666; font-size: 0.9em;">Showing <strong>@ViewBag.ItemCount</strong> row(s) for this filter.</p>
            }
        </div>
        <div style="display: flex; gap: 10px; flex-wrap: wrap;">
            <a asp-area="Admin" asp-controller="Menu" asp-action="Index" class="btn btn-add" style="text-decoration: none; display: inline-block; padding: 12px 25px; font-size: 1rem;">
                <i class="bi bi-arrow-left"></i> Menu (foods)
            </a>
        </div>
    </div>

    <form method="get" asp-area="Admin" asp-controller="Inventory" asp-action="Index" style="margin-bottom: 16px; display: flex; align-items: center; gap: 10px; flex-wrap: wrap;">
        <label for="categoryFilter" style="font-weight: 600; margin: 0;">Category</label>
        <select name="categoryFilter" id="categoryFilter" onchange="this.form.submit()" style="padding: 8px 12px; min-width: 260px; border: 2px solid #ddd; border-radius: 5px;">
            @if (catFilter == "all")
            {
                <option value="all" selected>All categories</option>
            }
            else
            {
                <option value="all">All categories</option>
            }
            @foreach (var c in categories)
            {
                if (catFilter == c)
                {
                    <option value="@c" selected>@c</option>
                }
                else
                {
                    <option value="@c">@c</option>
                }
            }
        </select>
    </form>

    <div class="inventory-form" style="margin-bottom:1rem;">
        <h2>Add ingredient</h2>
        <form method="post" asp-action="Add" onsubmit="return confirmAction('Add this ingredient?')">
            <div class="form-row-horizontal" style="display:flex; flex-wrap:wrap; gap:0.5rem; align-items:center;">
                <input type="text" name="item" placeholder="Name" required />
                <select name="ingredientCategory" required style="padding: 8px; min-width: 200px;">
                    <option value="">— Category —</option>
                    @foreach (var c in categories)
                    {
                        <option value="@c">@c</option>
                    }
                </select>
                <input type="number" name="stock" placeholder="Current stock" value="0" required />
                <input type="text" name="unit" placeholder="Unit (g, ml, pcs)" value="g" required />
                <input type="number" name="reorderLevel" placeholder="Reorder level" value="10" required />
                <button type="submit" class="btn btn-add">Add</button>
            </div>
        </form>
    </div>

    <div class="table-container" id="inventoryTableContainer" style="margin-top:0; max-height: 600px !important; overflow-y: auto !important; overflow-x: auto !important;">
        @if (Model != null && Model.Any())
        {
            <table id="inventoryTable">
                <thead>
                    <tr>
                        <th class="sortable" data-column="item" onclick="sortTable(0, 'item'); return false;" style="cursor: pointer;">
                            Item <span class="sort-icon" style="margin-left: 5px;">⇅</span>
                        </th>
                        <th class="sortable" data-column="category" onclick="sortTable(1, 'category'); return false;" style="cursor: pointer;">
                            Category <span class="sort-icon" style="margin-left: 5px;">⇅</span>
                        </th>
                        <th class="sortable" data-column="stock" onclick="sortTable(2, 'stock'); return false;" style="cursor: pointer;">
                            Stock <span class="sort-icon" style="margin-left: 5px;">⇅</span>
                        </th>
                        <th class="sortable" data-column="unit" onclick="sortTable(3, 'unit'); return false;" style="cursor: pointer;">
                            Unit <span class="sort-icon" style="margin-left: 5px;">⇅</span>
                        </th>
                        <th class="sortable" data-column="reorder" onclick="sortTable(4, 'reorder'); return false;" style="cursor: pointer;">
                            Reorder <span class="sort-icon" style="margin-left: 5px;">⇅</span>
                        </th>
                        <th class="sortable" data-column="status" onclick="sortTable(5, 'status'); return false;" style="cursor: pointer;">
                            Status <span class="sort-icon" style="margin-left: 5px;">⇅</span>
                        </th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody id="inventoryTableBody">
                    @foreach (var i in Model)
                    {
                        <tr>
                            <td data-sort-value="@i.Item.ToLower()">@i.Item</td>
                            <td data-sort-value="@i.IngredientCategory.ToLower()">@i.IngredientCategory</td>
                            <td data-sort-value="@i.CurrentStock">@i.CurrentStock</td>
                            <td data-sort-value="@i.Unit.ToLower()">@i.Unit</td>
                            <td data-sort-value="@i.ReorderLevel">@i.ReorderLevel</td>
                            <td data-sort-value="@i.Status.ToLower()">
                                @if (i.Status == "Low Stock")
                                {
                                    <span class="status-badge low">@i.Status</span>
                                }
                                else if (i.Status == "Out of Stock")
                                {
                                    <span class="status-badge out">@i.Status</span>
                                }
                                else
                                {
                                    <span class="status-badge in">@i.Status</span>
                                }
                            </td>
                            <td>
                                <div class="action-buttons" style="display:flex; gap:6px; flex-wrap:wrap;">
                                    <a asp-action="Edit" asp-route-id="@i.Id" class="btn btn-edit">Edit</a>
                                    <form asp-area="Admin" asp-controller="Inventory" asp-action="Delete" asp-route-id="@i.Id" method="post" style="display:inline;" onsubmit="return confirm('Delete this ingredient?');">
                                        <button type="submit" class="btn btn-delete" style="padding:6px 12px;">Delete</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <p class="no-data">No ingredients for this filter.</p>
        }
    </div>
</div>

@if (TempData["Message"] != null)
{
    <div id="successPopup" class="confirm-popup active">
        <h3>@TempData["Message"]</h3>
        <div class="popup-buttons">
            <button id="closePopup" class="popup-btn confirm">OK</button>
        </div>
    </div>
}

@section Scripts {
    <script>
        function confirmAction(message) {
            return confirm(message);
        }

        document.addEventListener("DOMContentLoaded", function () {
            const popup = document.getElementById("successPopup");
            const closeBtn = document.getElementById("closePopup");
            if (popup && closeBtn) {
                closeBtn.addEventListener("click", () => popup.style.display = "none");
                setTimeout(() => popup.style.display = "none", 2500);
            }
        });

        let currentSortColumn = -1;
        let currentSortDirection = 'asc';

        function sortTable(columnIndex, columnType) {
            const table = document.getElementById('inventoryTable');
            if (!table) return;
            const tbody = document.getElementById('inventoryTableBody');
            if (!tbody) return;
            const rows = Array.from(tbody.querySelectorAll('tr'));
            if (rows.length === 0) return;
            const headers = table.querySelectorAll('thead th');

            headers.forEach(header => {
                const icon = header.querySelector('.sort-icon');
                if (icon) {
                    icon.textContent = '⇅';
                    icon.style.color = '';
                }
            });

            if (currentSortColumn === columnIndex) {
                currentSortDirection = currentSortDirection === 'asc' ? 'desc' : 'asc';
            } else {
                currentSortDirection = 'asc';
                currentSortColumn = columnIndex;
            }

            const currentHeader = headers[columnIndex];
            if (currentHeader) {
                const currentIcon = currentHeader.querySelector('.sort-icon');
                if (currentIcon) {
                    currentIcon.textContent = currentSortDirection === 'asc' ? '↑' : '↓';
                    currentIcon.style.color = '#d35400';
                }
            }

            rows.sort((a, b) => {
                const aCell = a.cells[columnIndex];
                const bCell = b.cells[columnIndex];
                if (!aCell || !bCell) return 0;
                const aValue = aCell.getAttribute('data-sort-value') || aCell.textContent.trim();
                const bValue = bCell.getAttribute('data-sort-value') || bCell.textContent.trim();
                let comparison = 0;
                if (columnType === 'stock' || columnType === 'reorder') {
                    const aNum = parseFloat(aValue) || 0;
                    const bNum = parseFloat(bValue) || 0;
                    comparison = aNum - bNum;
                } else {
                    comparison = aValue.localeCompare(bValue, undefined, { sensitivity: 'base' });
                }
                return currentSortDirection === 'asc' ? comparison : -comparison;
            });

            rows.forEach(row => {
                if (row.parentNode === tbody) tbody.removeChild(row);
            });
            rows.forEach(row => tbody.appendChild(row));
        }
    </script>
}
