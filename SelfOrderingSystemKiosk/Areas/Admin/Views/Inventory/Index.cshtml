        background-color: #d4edda;
        border-color: #c3e6cb;
        color: #155724;
    }
    .ingredient-add-row {
        border: 1px solid #eee;
        border-radius: 10px;
        padding: 12px;
        background: #fffaf4;
        display: grid;
        grid-template-columns: minmax(180px, 1.4fr) minmax(150px, 1fr) minmax(88px, 0.55fr) minmax(82px, 0.45fr) minmax(98px, 0.55fr) minmax(100px, 0.55fr) minmax(130px, 0.7fr) 36px;
        gap: 10px;
        align-items: end;
        max-width: 100%;
    }
    .ingredient-add-row label {
        margin: 0;
    }
    .ingredient-remove-row {
        width: 34px;
        height: 34px;
        border: 0;
        border-radius: 50%;
