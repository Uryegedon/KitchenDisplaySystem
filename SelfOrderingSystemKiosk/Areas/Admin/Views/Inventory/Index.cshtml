@model IEnumerable<SelfOrderingSystemKiosk.Models.IngredientItem>
@using SelfOrderingSystemKiosk.Services
@using SelfOrderingSystemKiosk.Models
@using System.Net
@using System.Text.Encodings.Web
@using System.Text.Json
@{
    ViewData["Title"] = "Kitchen/Supplies inventory";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    var catFilter = ViewBag.CategoryFilter as string ?? "all";
    var expiryFilter = ViewBag.ExpiryFilter as string ?? "all";
    var expiryToday = ViewBag.ExpiryToday is DateTime expiryTodayValue ? expiryTodayValue : AppClock.LocalNow.Date;
    var expiryMaxDate = ViewBag.ExpiryMaxDate is DateTime expiryMaxValue ? expiryMaxValue : expiryToday.AddDays(14);
    var expiryUntil = ViewBag.ExpiryUntil is DateTime expiryUntilValue ? expiryUntilValue : (DateTime?)null;
    var actionView = ViewBag.ActionView as string ?? "needs";
    var usageByIngredient = ViewBag.InventoryUsageByIngredient as Dictionary<string, InventoryUsageImpact> ?? new(StringComparer.OrdinalIgnoreCase);
    var actionCounts = ViewBag.InventoryActionCounts as Dictionary<string, int> ?? new(StringComparer.OrdinalIgnoreCase);
    string ActionTabUrl(string tab) => Url.Action("Index", "Inventory", new
    {
        area = "Admin",
        categoryFilter = catFilter,
        branchFilter = ViewBag.BranchFilter,
        expiryFilter,
        expiryUntil = expiryUntil?.ToString("yyyy-MM-dd"),
        actionView = tab
    }) ?? "#";
    int ActionCount(string tab) => actionCounts.TryGetValue(tab, out var count) ? count : 0;
    var categories = IngredientCategoryRegistry.All;
    var branchName = ViewData["BranchName"] as string ?? "Unknown";
    var isOwner = ViewBag.IsOwner == true;
    var autoPrint = ViewBag.AutoPrint == true;
    var printRows = (Model ?? Enumerable.Empty<SelfOrderingSystemKiosk.Models.IngredientItem>()).ToList();
    var importRows = ViewBag.ImportIngredientOptions as IEnumerable<SelfOrderingSystemKiosk.Models.IngredientItem> ?? printRows;
    var importIngredientOptionsJson = JsonSerializer.Serialize(importRows
        .OrderBy(i => i.Item ?? "", StringComparer.OrdinalIgnoreCase)
        .Select(i => new
        {
            id = i.Id,
            name = i.Item ?? "",
            unit = i.Unit ?? ""
        }));
    var printStockStats = ViewBag.PrintStockStats as Dictionary<string, SelfOrderingSystemKiosk.Controllers.PrintStockSummary> ?? new();
    var printGroupedRows = printRows
        .GroupBy(i => string.IsNullOrWhiteSpace(i.IngredientCategory) ? "Uncategorized" : i.IngredientCategory)
        .Select(g => new
        {
            Category = g.Key,
            Items = g.OrderBy(i => i.Item ?? "", StringComparer.OrdinalIgnoreCase).ToList()
        })
        .OrderBy(g => g.Category, StringComparer.OrdinalIgnoreCase)
        .ToList();
    var printLeftGroups = printGroupedRows.Take(0).ToList();
    var printRightGroups = printGroupedRows.Take(0).ToList();
    var printTargetRows = (int)Math.Ceiling(printGroupedRows.Sum(g => g.Items.Count + 1) / 2m);
    var printRunningRows = 0;
    foreach (var group in printGroupedRows)
    {
        if (printRunningRows < printTargetRows || printLeftGroups.Count == 0)
        {
            printLeftGroups.Add(group);
            printRunningRows += group.Items.Count + 1;
        }
        else
        {
            printRightGroups.Add(group);
        }
    }
}

<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
    <h2 style="margin: 0; font-size: 1.5em;">@branchName</h2>
    @if (isOwner)
    {
        <div style="display: flex; gap: 10px; align-items: center;">
            <span style="color: #888; font-size: 0.9em;">Select branch:</span>
            <select id="branchFilter" onchange="filterByBranch()" style="padding: 8px 12px; border: 2px solid #ddd; border-radius: 6px; font-size: 0.9em; min-width: 200px;">
                @foreach (var branch in ViewBag.AllBranches as List<SelfOrderingSystemKiosk.Areas.Admin.Models.Branch> ?? new List<SelfOrderingSystemKiosk.Areas.Admin.Models.Branch>())
                {
                    <option value="@branch.Id" selected="@(ViewBag.BranchFilter == branch.Id)">@branch.BranchName</option>
                }
            </select>
        </div>
    }
    else
    {
        <span style="color: #888; font-size: 0.9em;">Viewing your branch</span>
    }
</div>

<link rel="stylesheet" href="~/css/inventory.css" asp-append-version="true" />

<div>
    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success">@TempData["Message"]</div>
    }
    
    <div class="inv-page-toolbar" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px;">
        <div>
           
            @if (ViewBag.ItemCount != null)
            {
                <p style="color: #666; font-size: 0.9em;">Showing <strong>@ViewBag.ItemCount</strong> row(s) for this filter.</p>
            }
        </div>
        <div style="display: flex; gap: 10px; flex-wrap: wrap;">
            <button type="button" class="btn btn-add" onclick="openAddIngredientModal()">
                <i class="bi bi-plus-circle"></i> Add Ingredient
            </button>
            <button type="button" class="btn btn-edit" onclick="printAllSupplies()">
                <i class="bi bi-printer"></i> Print Table
            </button>
            <button type="button" class="btn-import-delivery" onclick="startDeliveryImport()">
                <i class="bi bi-phone"></i> Start Phone Scan
            </button>
            @if (isOwner)
            {
                <a class="btn btn-edit" asp-area="Admin" asp-controller="Inventory" asp-action="Transfer">
                    <i class="bi bi-arrow-left-right"></i> Transfer
                </a>
            }
        </div>
    </div>

    <form method="get" asp-area="Admin" asp-controller="Inventory" asp-action="Index" class="inventory-filters" style="margin-bottom: 16px; display: flex; align-items: center; gap: 10px; flex-wrap: wrap;">
        <input type="hidden" name="branchFilter" value="@ViewBag.BranchFilter" />
        <input type="hidden" name="actionView" value="@actionView" />
        <label for="categoryFilter" style="font-weight: 600; margin: 0;">Category</label>
        <select name="categoryFilter" id="categoryFilter" onchange="this.form.submit()" style="padding: 8px 12px; min-width: 260px; border: 2px solid #ddd; border-radius: 5px;">
            @if (catFilter == "all")
            {
                <option value="all" selected>All categories</option>
            }
            else
            {
                <option value="all">All categories</option>
            }
            @foreach (var c in categories)
            {
                if (catFilter == c)
                {
                    <option value="@c" selected>@c</option>
                }
                else
                {
                    <option value="@c">@c</option>
                }
            }
        </select>
        
        <input type="text" id="searchInput" placeholder="Search ingredients..." style="padding: 8px 12px; min-width: 220px; border: 2px solid #ddd; border-radius: 5px;" />
        <label for="expiryFilter" style="font-weight: 600; margin: 0;">Expiry</label>
        <select name="expiryFilter" id="expiryFilter" onchange="this.form.submit()" style="padding: 8px 12px; min-width: 180px; border: 2px solid #ddd; border-radius: 5px;">
            <option value="all" selected="@(expiryFilter == "all")">All</option>
            <option value="3days" selected="@(expiryFilter == "3days")">Next 3 days</option>
            <option value="7days" selected="@(expiryFilter == "7days" || expiryFilter == "near")">This week</option>
            <option value="14days" selected="@(expiryFilter == "14days")">Next 2 weeks</option>
            <option value="custom" selected="@(expiryFilter == "custom")">Until selected date</option>
            <option value="expired" selected="@(expiryFilter == "expired")">Expired</option>
        </select>
        <input type="date"
               name="expiryUntil"
               id="expiryUntil"
               value="@(expiryUntil?.ToString("yyyy-MM-dd") ?? "")"
               min="@expiryToday.ToString("yyyy-MM-dd")"
               max="@expiryMaxDate.ToString("yyyy-MM-dd")"
               onchange="applyExpiryUntil(this)"
               title="Expiration range is capped at 2 weeks"
               style="padding: 8px 12px; min-width: 165px; border: 2px solid #ddd; border-radius: 5px;" />
        <span style="color: #777; font-size: 0.85em;">Max 2 weeks</span>
    </form>

    <div class="inventory-action-tabs" aria-label="Kitchen supplies views">
        <a class="inventory-action-tab @(actionView == "needs" ? "active" : "")" href="@ActionTabUrl("needs")">
            Needs Action <span class="inventory-action-tab-count">@ActionCount("needs")</span>
        </a>
        <a class="inventory-action-tab @(actionView == "low" ? "active" : "")" href="@ActionTabUrl("low")">
            Low Stock <span class="inventory-action-tab-count">@ActionCount("low")</span>
        </a>
        <a class="inventory-action-tab @(actionView == "expiring" ? "active" : "")" href="@ActionTabUrl("expiring")">
            Expiring Soon <span class="inventory-action-tab-count">@ActionCount("expiring")</span>
        </a>
        <a class="inventory-action-tab @(actionView == "recipe" ? "active" : "")" href="@ActionTabUrl("recipe")">
            Recipe Usage <span class="inventory-action-tab-count">@ActionCount("recipe")</span>
        </a>
        <a class="inventory-action-tab @(actionView == "unused" ? "active" : "")" href="@ActionTabUrl("unused")">
            Unused <span class="inventory-action-tab-count">@ActionCount("unused")</span>
        </a>
        <a class="inventory-action-tab @(actionView == "all" ? "active" : "")" href="@ActionTabUrl("all")">
            All Supplies <span class="inventory-action-tab-count">@ActionCount("all")</span>
        </a>
    </div>

    <div class="inv-modal-overlay" id="addIngredientModal" aria-hidden="true">
        <div class="inv-modal-content" role="dialog" aria-labelledby="addIngredientTitle">
        <div class="inv-modal-header">
            <h2 id="addIngredientTitle">Add ingredient</h2>
            <button type="button" class="inv-close" onclick="closeAddIngredientModal()" aria-label="Close">&times;</button>
        </div>
        <form method="post" asp-action="Add" id="addIngredientForm">
            @Html.AntiForgeryToken()
            <input type="hidden" name="branchFilter" value="@ViewBag.BranchFilter" />
            <div class="inv-form-grid" id="ingredientRows">
                <div class="ingredient-add-row">
                    <label>Ingredient name<br />
                        <input type="text" name="item" placeholder="e.g., Chicken Breast" required title="Enter the name of the ingredient" />
                    </label>
                    <label>Category<br />
                    <select name="ingredientCategory" required title="Select the category this ingredient belongs to">
                        <option value="">— Select Category —</option>
                        @foreach (var c in categories)
                        {
                            <option value="@c">@c</option>
                        }
                    </select>
                    </label>
                    <label>Stock<br />
                        <input type="number" name="stock" value="0" required title="Current stock level (numbers only)" min="0" />
                    </label>
                    <label>Unit<br />
                    <select name="unit" required title="Unit of measurement">
                        <option value="g" selected>g</option>
                        <option value="ml">ml</option>
                        <option value="pcs">pcs</option>
                    </select>
                    </label>
                    <label>Reorder<br />
                        <input type="number" name="reorderLevel" value="10" required title="Stock level that triggers reorder alert" min="0" />
                    </label>
                    <label>Cost/unit<br />
                        <input type="number" name="costPerUnit" value="0" step="0.01" min="0" required title="Cost per stock unit" />
                    </label>
                    <label>Expiration<br />
                        <input type="date" name="expirationDate" title="Optional expiration date" />
                    </label>
                    <button type="button" class="ingredient-remove-row" title="Remove row" onclick="removeIngredientRow(this)">×</button>
                </div>
            </div>
            <button type="button" class="ingredient-add-more" onclick="addIngredientRow()">+ Add more</button>
            <div class="inv-modal-actions">
                <button type="button" class="inv-btn-cancel" onclick="closeAddIngredientModal()">Cancel</button>
                <button type="button" class="inv-btn-save" id="addIngredientBtn">Add ingredients</button>
            </div>
        </form>
        </div>
    </div>

    <div class="table-container" id="inventoryTableContainer" style="margin-top:0; max-height: 600px !important; overflow-y: auto !important; overflow-x: auto !important;">
        @if (Model != null && Model.Any())
        {
            <table id="inventoryTable">
                <thead>
                    <tr>
                        <th class="sortable" data-column="item" onclick="sortTable(0, 'item'); return false;" style="cursor: pointer;">
                            Item <span class="sort-icon" style="margin-left: 5px;">⇅</span>
                        </th>
                        <th class="sortable" data-column="category" onclick="sortTable(1, 'category'); return false;" style="cursor: pointer;">
                            Category <span class="sort-icon" style="margin-left: 5px;">⇅</span>
                        </th>
                        <th class="sortable" data-column="stock" onclick="sortTable(2, 'stock'); return false;" style="cursor: pointer;">
                            Stock <span class="sort-icon" style="margin-left: 5px;">⇅</span>
                        </th>
                        <th class="sortable" data-column="unit" onclick="sortTable(3, 'unit'); return false;" style="cursor: pointer;">
                            Unit <span class="sort-icon" style="margin-left: 5px;">⇅</span>
                        </th>
                        <th class="sortable" data-column="status" onclick="sortTable(4, 'status'); return false;" style="cursor: pointer;">
                            Status <span class="sort-icon" style="margin-left: 5px;">⇅</span>
                        </th>
                        <th class="sortable" data-column="cost" onclick="sortTable(5, 'stock'); return false;" style="cursor: pointer;">
                            Cost/unit <span class="sort-icon" style="margin-left: 5px;">⇅</span>
                        </th>
                        <th class="sortable" data-column="expiry" onclick="sortTable(6, 'expiry'); return false;" style="cursor: pointer;">
                            Expiration <span class="sort-icon" style="margin-left: 5px;">⇅</span>
                        </th>
                        <th class="sortable" data-column="usedIn" onclick="sortTable(7, 'stock'); return false;" style="cursor: pointer;">
                            Used In Menu <span class="sort-icon" style="margin-left: 5px;">⇅</span>
                        </th>
                        <th class="sortable" data-column="impact" onclick="sortTable(8, 'stock'); return false;" style="cursor: pointer;">
                            Menu Impact <span class="sort-icon" style="margin-left: 5px;">⇅</span>
                        </th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody id="inventoryTableBody">
                    @foreach (var i in Model)
                    {
                        var exp = i.ExpirationDate?.Date;
                        var today = AppClock.LocalNow.Date;
                        var expiryStyle = exp.HasValue && exp.Value < today
                            ? "background:#f8d7da;"
                            : exp.HasValue && exp.Value <= today.AddDays(7)
                                ? "background:#fff3cd;"
                                : "";
                        var canManageItem = isOwner || !string.IsNullOrWhiteSpace(i.BranchId);
                        var usage = !string.IsNullOrWhiteSpace(i.Id) && usageByIngredient.TryGetValue(i.Id.Trim(), out var matchedUsage)
                            ? matchedUsage
                            : new InventoryUsageImpact { IngredientId = i.Id ?? "" };
                        <tr style="@expiryStyle">
                            <td data-sort-value="@(i.Item ?? "").ToLower()">@i.Item</td>
                            <td data-sort-value="@(i.IngredientCategory ?? "").ToLower()">@i.IngredientCategory</td>
                            <td data-sort-value="@i.CurrentStock">@i.CurrentStock</td>
                            <td data-sort-value="@(i.Unit ?? "").ToLower()">@i.Unit</td>
                            <td data-sort-value="@i.Status.ToLower()">
                                @if (i.CurrentStock == 0)
                                {
                                    <span class="status-badge out">No Stock</span>
                                }
                                else if (i.CurrentStock <= i.ReorderLevel)
                                {
                                    <span class="status-badge low">Low Stock</span>
                                }
                                else
                                {
                                    <span class="status-badge in">In Stock</span>
                                }
                            </td>
                            <td data-sort-value="@i.CostPerUnit">@i.CostPerUnit.ToString("N2")</td>
                            <td data-sort-value="@(i.ExpirationDate?.ToString("yyyyMMdd") ?? "99999999")">
                                @(i.ExpirationDate.HasValue ? AppClock.ToLocal(i.ExpirationDate.Value).ToString("yyyy-MM-dd") : "No expiry")
                            </td>
                            <td data-sort-value="@usage.AffectedMenuItemCount">
                                @if (usage.UsedBy.Count > 0)
                                {
                                    <div class="recipe-usage-list">
                                        @foreach (var usedBy in usage.UsedBy.OrderBy(x => x.MenuItemName).Take(3))
                                        {
                                            <span>@usedBy.MenuItemName: @usedBy.QuantityPerUnit @usedBy.Unit</span>
                                        }
                                        @if (usage.UsedBy.Count > 3)
                                        {
                                            <span style="color:#777;">+@(usage.UsedBy.Count - 3) more</span>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <span style="color:#999;">Not used</span>
                                }
                            </td>
                            <td data-sort-value="@usage.ImpactSortValue">
                                <span class="impact-badge @usage.ImpactLevel">@usage.ImpactLabel</span>
                            </td>
                            <td>
                                @if (canManageItem)
                                {
                                    <div class="inventory-row-actions">
                                        <button type="button"
                                                class="inventory-action-btn inventory-action-edit inv-edit-btn"
                                                data-id="@i.Id"
                                                data-item="@WebUtility.HtmlEncode(i.Item ?? "")"
                                                data-category="@WebUtility.HtmlEncode(i.IngredientCategory ?? "")"
                                                data-stock="@i.CurrentStock"
                                                data-unit="@WebUtility.HtmlEncode(i.Unit ?? "")"
                                                data-cost="@i.CostPerUnit"
                                                data-expiration="@(i.ExpirationDate?.ToString("yyyy-MM-dd") ?? "")"
                                                data-reorder="@i.ReorderLevel">
                                            Edit
                                        </button>
                                        <button type="button" class="btn btn-restock restock-btn"
                                                data-id="@i.Id"
                                                data-current="@i.CurrentStock"
                                                data-reorder="@i.ReorderLevel"
                                                data-unit="@i.Unit">
                                            Restock
                                        </button>
                                        <form method="post" asp-area="Admin" asp-controller="Inventory" asp-action="ClearStock" class="inventory-clear-form">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@i.Id" />
                                            <input type="hidden" name="branchFilter" value="@ViewBag.BranchFilter" />
                                            <input type="hidden" name="actionView" value="@actionView" />
                                            <button type="submit" class="btn-clear-stock" onclick="return confirm('Set @JavaScriptEncoder.Default.Encode(i.Item ?? "this ingredient") stock quantity to 0?');">
                                                Clear
                                            </button>
                                        </form>
                                    </div>
                                }
                                else
                                {
                                    <span style="color:#999;font-size:0.85em;">Owner only</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <p class="no-data">No ingredients for this filter.</p>
        }
    </div>

    <div class="print-inventory-grid" aria-hidden="true">
        <div class="print-report-title">
            <h2>Stock usage report</h2>
            <p>@branchName</p>
        </div>
        <div class="print-table-pair">
            @foreach (var tableGroups in new[] { printLeftGroups, printRightGroups })
            {
                <table>
                    <thead>
                        <tr>
                            <th style="width: 34%;">Item</th>
                            <th style="width: 14%;">Beginning</th>
                            <th style="width: 14%;">Delivery</th>
                            <th style="width: 14%;">Used</th>
                            <th style="width: 14%;">Ending</th>
                            <th style="width: 10%;">Waste</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var categoryGroup in tableGroups)
                        {
                            <tr class="print-category-row">
                                <td colspan="6">@categoryGroup.Category</td>
                            </tr>
                            @foreach (var i in categoryGroup.Items)
                            {
                                var stats = printStockStats.TryGetValue(i.Id, out var itemStats)
                                    ? itemStats
                                    : new SelfOrderingSystemKiosk.Controllers.PrintStockSummary
                                    {
                                        BeginningStock = i.CurrentStock,
                                        DeliveredStock = 0,
                                        EndingStock = i.CurrentStock,
                                        UsedStockEstimate = 0
                                    };
                                <tr>
                                    <td>@i.Item</td>
                                    <td>@stats.BeginningStock</td>
                                    <td>@(stats.DeliveredStock == 0 ? "" : stats.DeliveredStock.ToString())</td>
                                    <td>@(stats.UsedStockEstimate == 0 ? "" : stats.UsedStockEstimate.ToString())</td>
                                    <td>@stats.EndingStock</td>
                                    <td></td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
</div>

<div class="inv-modal-overlay" id="invEditModal" aria-hidden="true">
    <div class="inv-modal-content" role="dialog" aria-labelledby="invEditTitle">
        <div class="inv-modal-header">
            <h2 id="invEditTitle">Edit ingredient</h2>
            <button type="button" class="inv-close" onclick="closeInvEditModal()" aria-label="Close">&times;</button>
        </div>
        <form asp-area="Admin" asp-controller="Inventory" asp-action="Edit" method="post" class="inv-form-grid" id="invEditForm">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" id="invEditId" />
            <input type="hidden" name="branchFilter" value="@ViewBag.BranchFilter" />
            <input type="hidden" name="actionView" value="@actionView" />
            <label>Name<br />
                <input type="text" name="item" id="invEditItem" required />
            </label>
            <label>Category<br />
                <select name="ingredientCategory" id="invEditCategory" required>
                    @foreach (var c in categories)
                    {
                        <option value="@c">@c</option>
                    }
                </select>
            </label>
            <label>Unit<br />
                <select name="unit" id="invEditUnit" required>
                    <option value="g">g</option>
                    <option value="ml">ml</option>
                    <option value="pcs">pcs</option>
                </select>
            </label>
            <label>Cost per unit<br />
                <input type="number" name="costPerUnit" id="invEditCost" min="0" step="0.01" required />
            </label>
            <label>Expiration<br />
                <input type="date" name="expirationDate" id="invEditExpiration" />
            </label>
            <div class="inv-modal-actions">
                <button type="button" class="inv-btn-cancel" onclick="closeInvEditModal()">Cancel</button>
                <button type="submit" class="inv-btn-save">Save</button>
            </div>
        </form>
    </div>
</div>

<div class="inv-modal-overlay" id="restockModal" aria-hidden="true">
    <div class="inv-modal-content" role="dialog" aria-labelledby="restockTitle">
        <div class="inv-modal-header">
            <h2 id="restockTitle">Add Stock Delivery</h2>
            <button type="button" class="inv-close" onclick="closeRestockModal()" aria-label="Close">&times;</button>
        </div>
        <div class="inv-form-grid">
            <div style="display: flex; gap: 10px; align-items: center;">
                <label>Current Stock:</label>
                <span id="currentStockDisplay" style="font-weight: bold;"></span>
            </div>
            <div style="display: flex; gap: 10px; align-items: center;">
                <label>Restock Amount:</label>
                <input type="number" id="restockAmount" min="1" value="10" style="width: 80px;" />
                <span id="unitDisplay"></span>
            </div>
            <div style="display: flex; gap: 10px; align-items: center;">
                <label>Total Stock:</label>
                <span id="totalStockDisplay" style="font-weight: bold; color: #28a745;"></span>
            </div>
            <label>Batch / delivery note<br />
                <input type="text" id="batchNote" placeholder="e.g., DR #, supplier, or delivery date" />
            </label>
        </div>
        <div class="inv-modal-actions">
            <button type="button" class="inv-btn-cancel" onclick="closeRestockModal()">Cancel</button>
            <button type="button" class="inv-btn-save" onclick="confirmRestock()">Add Stock</button>
        </div>
    </div>
</div>

<div class="inv-modal-overlay" id="deliveryImportModal" aria-hidden="true">
    <div class="inv-modal-content" role="dialog" aria-labelledby="deliveryImportTitle">
        <div class="inv-modal-header">
            <h2 id="deliveryImportTitle">Import Delivery Sheet</h2>
            <button type="button" class="inv-close" onclick="closeDeliveryImportModal()" aria-label="Close">&times;</button>
        </div>
        <div class="delivery-qr-wrap">
            <img id="deliveryImportQr" alt="Phone scan QR" />
            <div>
                <div class="delivery-import-status" id="deliveryImportStatus">Creating phone scan session...</div>
                <p style="margin: 12px 0 0; color: #666;">Scan the QR with a phone, take a photo of the delivery sheet, then return here to review before importing.</p>
                <p style="margin: 8px 0 0;"><a id="deliveryImportLink" href="#" target="_blank" rel="noopener">Open scanner link</a></p>
            </div>
        </div>
        <div class="inv-modal-actions">
            <button type="button" class="inv-btn-cancel" onclick="openManualDeliveryImport()">Enter Manually</button>
            <button type="button" class="inv-btn-cancel" onclick="closeDeliveryImportModal()">Cancel</button>
        </div>
    </div>
</div>

<div class="inv-modal-overlay" id="deliveryReviewModal" aria-hidden="true">
    <div class="inv-modal-content" role="dialog" aria-labelledby="deliveryReviewTitle">
        <div class="inv-modal-header">
            <h2 id="deliveryReviewTitle">Review Delivery Import</h2>
            <button type="button" class="inv-close" onclick="closeDeliveryReviewModal()" aria-label="Close">&times;</button>
        </div>
        <div class="delivery-import-status">Review each handwritten row. Match the read name to an ingredient and correct the amount before confirming.</div>
        <div style="overflow-x:auto;">
            <table class="delivery-review-table">
                <thead>
                    <tr>
                        <th>Read Name</th>
                        <th>Match Ingredient</th>
                        <th>Amount</th>
                        <th>Unit</th>
                        <th>Confidence</th>
                        <th>Note</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody id="deliveryReviewRows"></tbody>
            </table>
        </div>
        <div class="inv-modal-actions">
            <button type="button" class="inv-btn-cancel" onclick="addDeliveryReviewRow()">Add Row</button>
            <button type="button" class="inv-btn-cancel" onclick="closeDeliveryReviewModal()">Cancel</button>
            <button type="button" class="inv-btn-save" onclick="confirmDeliveryImport()">Confirm Import</button>
        </div>
    </div>
</div>



@section Scripts {
    <script>
        window.inventoryPageConfig = {
            deliveryImportIngredients: @Html.Raw(importIngredientOptionsJson),
            shouldAutoPrint: @Json.Serialize(autoPrint),
            branchFilter: @Html.Raw(JsonSerializer.Serialize(ViewBag.BranchFilter as string ?? "")),
            actionView: @Html.Raw(JsonSerializer.Serialize(actionView))
        };
    </script>
    <script src="~/js/inventory.js" asp-append-version="true"></script>
}

