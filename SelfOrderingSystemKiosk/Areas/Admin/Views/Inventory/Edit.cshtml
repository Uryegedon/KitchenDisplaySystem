@model SelfOrderingSystemKiosk.Models.IngredientItem
@using SelfOrderingSystemKiosk.Services
@{
    ViewData["Title"] = "Edit ingredient";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    var categories = ViewBag.IngredientCategories as string[] ?? IngredientCategoryRegistry.All;
}

<div class="content">
    <div class="header">
        <p style="margin-top: 0;">Update <strong>@Model.Item</strong></p>
    </div>

    <div class="form-container">
        <form asp-action="Edit" method="post" class="form-inline">
            <input type="hidden" name="Id" value="@Model.Id" />
            <div style="display:flex; flex-direction:column; gap:12px; max-width:480px;">
                <label>Name<br /><input type="text" name="Item" value="@Model.Item" required style="width:100%; padding:8px;" /></label>
                <label>Category<br />
                    <select name="IngredientCategory" required style="width:100%; padding:8px;">
                        @foreach (var c in categories)
                        {
                            if (c == Model.IngredientCategory)
                            {
                                <option value="@c" selected>@c</option>
                            }
                            else
                            {
                                <option value="@c">@c</option>
                            }
                        }
                    </select>
                </label>
                <label>Current stock<br /><input type="number" name="CurrentStock" value="@Model.CurrentStock" required style="width:100%; padding:8px;" /></label>
                <label>Unit<br /><input type="text" name="Unit" value="@Model.Unit" required style="width:100%; padding:8px;" /></label>
                <label>Reorder level<br /><input type="number" name="ReorderLevel" value="@Model.ReorderLevel" required style="width:100%; padding:8px;" /></label>
                <div class="btn-group" style="margin-top:8px;">
                    <button type="submit" class="btn btn-edit">Save</button>
                    <a asp-action="Index" class="btn btn-delete">Cancel</a>
                </div>
            </div>
        </form>
    </div>
</div>
