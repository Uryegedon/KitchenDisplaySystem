@using SelfOrderingSystemKiosk.Models
@using SelfOrderingSystemKiosk.Controllers
@{
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    var bestSellersAll = ViewBag.BestSellersAllTime as List<BestSeller> ?? new List<BestSeller>();
    var bestSellersToday = ViewBag.BestSellersToday as List<BestSeller> ?? new List<BestSeller>();
    var bestSellersMonthly = ViewBag.BestSellersMonthly as List<BestSeller> ?? new List<BestSeller>();
    var rangeStart = ViewBag.RangeStart != null ? (DateTime)ViewBag.RangeStart : AppClock.LocalNow.Date;
    var rangeEnd = ViewBag.RangeEnd != null ? (DateTime)ViewBag.RangeEnd : AppClock.LocalNow.Date;
    var rangeRevenue = ViewBag.RangeRevenue != null ? (decimal)ViewBag.RangeRevenue : 0m;
    var rangeCost = ViewBag.RangeCost != null ? (decimal)ViewBag.RangeCost : 0m;
    var rangeProfit = ViewBag.RangeProfit != null ? (decimal)ViewBag.RangeProfit : 0m;
    var rangeRevenueAlaCarte = ViewBag.RangeRevenueAlaCarte != null ? (decimal)ViewBag.RangeRevenueAlaCarte : 0m;
    var rangeRevenueUnlimited = ViewBag.RangeRevenueUnlimited != null ? (decimal)ViewBag.RangeRevenueUnlimited : 0m;
    var rangeRevenueDineIn = ViewBag.RangeRevenueDineIn != null ? (decimal)ViewBag.RangeRevenueDineIn : 0m;
    var rangeRevenueTakeOut = ViewBag.RangeRevenueTakeOut != null ? (decimal)ViewBag.RangeRevenueTakeOut : 0m;
    var rangeOrderCount = ViewBag.RangeOrderCount != null ? (int)ViewBag.RangeOrderCount : 0;
    var unpaidOrderCount = ViewBag.UnpaidOrderCount != null ? (int)ViewBag.UnpaidOrderCount : 0;
    var unpaidBillableRevenue = ViewBag.UnpaidBillableRevenue != null ? (decimal)ViewBag.UnpaidBillableRevenue : 0m;
    var canceledOrderCount = ViewBag.CanceledOrderCount != null ? (int)ViewBag.CanceledOrderCount : 0;
    var canceledRevenue = ViewBag.CanceledRevenue != null ? (decimal)ViewBag.CanceledRevenue : 0m;
    var completedOrderCount = ViewBag.CompletedOrderCount != null ? (int)ViewBag.CompletedOrderCount : 0;
    var paidOrderCount = ViewBag.PaidOrderCount != null ? (int)ViewBag.PaidOrderCount : 0;
    var averageOrderValue = ViewBag.AverageOrderValue != null ? (decimal)ViewBag.AverageOrderValue : 0m;
    var profitMarginPercent = ViewBag.ProfitMarginPercent != null ? (decimal)ViewBag.ProfitMarginPercent : 0m;
    var missingCostCount = ViewBag.MissingCostCount != null ? (int)ViewBag.MissingCostCount : 0;
    var chartData = ViewBag.ChartData as Dictionary<string, decimal> ?? new Dictionary<string, decimal>();
    var branchRevenueStats = ViewBag.BranchRevenueStats as List<BranchRevenueSummary> ?? new();
    var paymentBreakdown = ViewBag.PaymentBreakdown as List<SalesBreakdownSummary> ?? new();
    var statusBreakdown = ViewBag.StatusBreakdown as List<SalesBreakdownSummary> ?? new();
    var peakHourGroups = ViewBag.PeakHourGroups as List<PeakHourSummary> ?? new();
    var categoryStats = ViewBag.CategoryStats as List<CategorySalesSummary> ?? new();
    var topItemsByRevenue = ViewBag.TopItemsByRevenue as List<BestSeller> ?? new();
    var chartLabelsJson = System.Text.Json.JsonSerializer.Serialize(chartData.Keys.OrderBy(k => k).Select(k => DateTime.Parse(k).ToString("MMM dd")).ToList());
    var chartValuesJson = System.Text.Json.JsonSerializer.Serialize(chartData.Keys.OrderBy(k => k).Select(k => chartData[k]).ToList());
    var hasCustomRange = ViewBag.HasCustomRange != null && (bool)ViewBag.HasCustomRange;
    var isOwner = ViewBag.IsOwner == true;
    var branchName = ViewData["BranchName"] as string ?? "Unknown";
    var allBranches = ViewBag.AllBranches as List<SelfOrderingSystemKiosk.Areas.Admin.Models.Branch> ?? new();
    var branchFilter = ViewBag.BranchFilter as string ?? "all";
    var isSpecificBranch = isOwner && !string.Equals(branchFilter, "all", StringComparison.OrdinalIgnoreCase);
    var selectedBranchRevenue = branchRevenueStats.FirstOrDefault(b => string.Equals(b.BranchId, branchFilter, StringComparison.OrdinalIgnoreCase));
}

<div class="dashboard-container">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
        <h2 style="margin: 0; font-size: 1.5em;">@branchName</h2>
        @if (isOwner)
        {
            <form method="get" asp-area="Admin" asp-controller="Sales" asp-action="Index" style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;">
                <input type="hidden" name="startDate" value="@rangeStart.ToString("yyyy-MM-dd")" />
                <input type="hidden" name="endDate" value="@rangeEnd.ToString("yyyy-MM-dd")" />
                <label for="branchFilter" style="color:#666;font-weight:600;">Branch</label>
                <select name="branchFilter" id="branchFilter" onchange="this.form.submit()" style="padding:8px 12px;border:2px solid #ddd;border-radius:6px;min-width:220px;">
                    <option value="all" selected="@(branchFilter == "all")">All branches</option>
                    @foreach (var branch in allBranches)
                    {
                        <option value="@branch.Id" selected="@(branchFilter == branch.Id)">@branch.BranchName</option>
                    }
                </select>
            </form>
        }
    </div>
    
    <p style="margin-top: 0;">Revenue charts, date ranges, and best sellers</p>

    @if (missingCostCount > 0 || unpaidOrderCount > 0 || canceledOrderCount > 0)
    {
        <div class="report-warning-panel">
            @if (missingCostCount > 0)
            {
                <span><strong>@missingCostCount</strong> reported order@(missingCostCount == 1 ? "" : "s") have no recorded COGS yet.</span>
            }
            @if (unpaidOrderCount > 0)
            {
                <span><strong>@unpaidOrderCount</strong> unpaid billable order@(unpaidOrderCount == 1 ? "" : "s") total ₱@unpaidBillableRevenue.ToString("N2").</span>
            }
            @if (canceledOrderCount > 0)
            {
                <span><strong>@canceledOrderCount</strong> canceled order@(canceledOrderCount == 1 ? "" : "s") in this range.</span>
            }
        </div>
    }

    <div class="revenue-analytics-section" style="margin-top: 24px;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; flex-wrap: wrap; gap: 12px;">
            <h2 style="color: #e67e22; margin: 0; display: flex; align-items: center; gap: 10px;"><i class="bi bi-graph-up"></i> <span>Revenue analytics</span></h2>
            <div style="display: flex; gap: 10px; align-items: center; flex-wrap: wrap;">
                <button type="button" class="sales-filter-btn revenue-chart-filter @(!hasCustomRange ? "active" : "")" data-filter="week" onclick="filterSalesChart('week')">This week</button>
                <button type="button" class="sales-filter-btn revenue-chart-filter" data-filter="month" onclick="filterSalesChart('month')">This month</button>
                <button type="button" class="sales-filter-btn revenue-chart-filter" data-filter="year" onclick="filterSalesChart('year')">This year</button>
                <button type="button" class="sales-filter-btn date-range-btn revenue-chart-filter @(hasCustomRange ? "active" : "")" data-filter="custom" onclick="openDateRangePopup()" style="display: flex; align-items: center; gap: 6px;">
                    <i class="bi bi-calendar-range"></i> <span>Custom range</span>
                </button>
            </div>
        </div>
    </div>

    <div class="report-metric-grid">
        <div class="report-metric-card primary">
            <span>Sales revenue</span>
            <strong>₱@rangeRevenue.ToString("N2")</strong>
            <small>@rangeOrderCount non-canceled billable order@(rangeOrderCount == 1 ? "" : "s")</small>
        </div>
        <div class="report-metric-card">
            <span>Completed orders</span>
            <strong>@completedOrderCount</strong>
            <small>@paidOrderCount paid in this range</small>
        </div>
        <div class="report-metric-card">
            <span>Average order</span>
            <strong>₱@averageOrderValue.ToString("N2")</strong>
            <small>Sales revenue / billable orders</small>
        </div>
        <div class="report-metric-card">
            <span>COGS</span>
            <strong>₱@rangeCost.ToString("N2")</strong>
            <small>@missingCostCount missing cost record@(missingCostCount == 1 ? "" : "s")</small>
        </div>
        <div class="report-metric-card">
            <span>Gross profit</span>
            <strong class="@(rangeProfit < 0 ? "metric-negative" : "metric-positive")">₱@rangeProfit.ToString("N2")</strong>
            <small>@profitMarginPercent.ToString("N1")% margin</small>
        </div>
        <div class="report-metric-card">
            <span>Unpaid billable</span>
            <strong>₱@unpaidBillableRevenue.ToString("N2")</strong>
            <small>@unpaidOrderCount order@(unpaidOrderCount == 1 ? "" : "s") awaiting payment</small>
        </div>
        <div class="report-metric-card">
            <span>Canceled orders</span>
            <strong>@canceledOrderCount</strong>
            <small>₱@canceledRevenue.ToString("N2") canceled value</small>
        </div>
    </div>

    <div class="sales-top-grid">
        @if (isOwner)
        {
            <div class="chart-container branch-revenue-card">
                @if (isSpecificBranch)
                {
                    <h3 style="color:#e67e22;margin:0 0 15px;font-size:1.1em;">Branch revenue detail</h3>
                    @if (selectedBranchRevenue != null)
                    {
                        <div class="branch-detail-summary">
                            <div>
                                <span>Orders</span>
                                <strong>@selectedBranchRevenue.OrderCount</strong>
                            </div>
                            <div>
                                <span>Revenue</span>
                                <strong>₱@selectedBranchRevenue.Revenue.ToString("N2")</strong>
                            </div>
                            <div>
                                <span>COGS</span>
                                <strong>₱@selectedBranchRevenue.Cost.ToString("N2")</strong>
                            </div>
                            <div>
                                <span>Profit</span>
                                <strong class="@(selectedBranchRevenue.Profit < 0 ? "metric-negative" : "metric-positive")">₱@selectedBranchRevenue.Profit.ToString("N2")</strong>
                            </div>
                        </div>
                        <div class="branch-detail-breakdown">
                            <span class="pill warning">Ala Carte: ₱@rangeRevenueAlaCarte.ToString("N2")</span>
                            <span class="pill muted">Unlimited: ₱@rangeRevenueUnlimited.ToString("N2")</span>
                            <span class="pill" style="background: #D1ECF1; color: #0C5460; border: 1px solid #BEE5EB;">Dine In: ₱@rangeRevenueDineIn.ToString("N2")</span>
                            <span class="pill" style="background: #F8D7DA; color: #721C24; border: 1px solid #F5C6CB;">Take Out: ₱@rangeRevenueTakeOut.ToString("N2")</span>
                        </div>
                    }
                    else
                    {
                        <p style="color:#777;margin:0;">No branch revenue for this range.</p>
                    }
                }
                else
                {
                    <h3 style="color:#e67e22;margin:0 0 15px;font-size:1.1em;">Revenue per branch</h3>
                    @if (branchRevenueStats.Any())
                    {
                    <div class="branch-revenue-table-wrap">
                        <table class="branch-revenue-table">
                            <thead>
                                <tr>
                                    <th>Branch</th>
                                    <th>Orders</th>
                                    <th>Revenue</th>
                                    <th>COGS</th>
                                    <th>Profit</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var branch in branchRevenueStats)
                                {
                                    <tr>
                                        <td>
                                            <strong>@branch.BranchName</strong>
                                            <span style="color:#888;font-size:.85em;">@branch.BranchCode</span>
                                        </td>
                                        <td>@branch.OrderCount</td>
                                        <td>₱@branch.Revenue.ToString("N2")</td>
                                        <td>₱@branch.Cost.ToString("N2")</td>
                                        <td class="@(branch.Profit < 0 ? "metric-negative" : "metric-positive")">₱@branch.Profit.ToString("N2")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    }
                    else
                    {
                        <p style="color:#777;margin:0;">No branch revenue for this range.</p>
                    }
                }
            </div>
        }

        <div class="stat-card highlight-card clickable-card best-sellers-card" role="button" tabindex="0" onclick="showBestSellersModal()" onkeypress="if(event.key === 'Enter' || event.key === ' ') { showBestSellersModal(); }">
            <h3><i class="bi bi-trophy"></i> Best sellers</h3>
            <div class="stat-value" style="font-size: 1.2em;">Top 5</div>
            <div style="color: #666; font-size: 0.85em; margin-top: 5px;">All time, this month, or today</div>
        </div>
    </div>

    <div id="dateRangeModal" class="date-range-modal" aria-hidden="true">
        <div class="date-range-modal-content">
            <div class="date-range-modal-header">
                <h3><i class="bi bi-calendar-range"></i> Custom date range</h3>
                <button type="button" class="date-range-close" aria-label="Close date range" onclick="closeDateRangePopup()">&times;</button>
            </div>
            <form method="get" asp-area="Admin" asp-controller="Sales" asp-action="Index" class="date-range-form" onsubmit="closeDateRangePopup()">
                @if (isOwner)
                {
                    <input type="hidden" name="branchFilter" value="@branchFilter" />
                }
                <div class="date-range-fields">
                    <label>
                        From
                        <input type="date" name="startDate" value="@rangeStart.ToString("yyyy-MM-dd")" required />
                    </label>
                    <label>
                        To
                        <input type="date" name="endDate" value="@rangeEnd.ToString("yyyy-MM-dd")" required />
                    </label>
                </div>
                <div class="date-range-summary">
                    <div class="range-title">Revenue (@rangeStart.ToString("MMM dd, yyyy") - @rangeEnd.ToString("MMM dd, yyyy"))</div>
                    <div class="range-total">Total: ₱@rangeRevenue.ToString("N2")</div>
                    <div class="range-breakdown">
                        <span class="pill" style="background:#E2F0D9;color:#255625;border:1px solid #B7D7A8;">COGS: ₱@rangeCost.ToString("N2")</span>
                        <span class="pill" style="background:#D1ECF1;color:#0C5460;border:1px solid #BEE5EB;">Profit: ₱@rangeProfit.ToString("N2")</span>
                        <span class="pill warning">Ala Carte: ₱@rangeRevenueAlaCarte.ToString("N2")</span>
                        <span class="pill muted">Unlimited: ₱@rangeRevenueUnlimited.ToString("N2")</span>
                        <span class="pill" style="background: #D1ECF1; color: #0C5460; border: 1px solid #BEE5EB;">Dine In: ₱@rangeRevenueDineIn.ToString("N2")</span>
                        <span class="pill" style="background: #F8D7DA; color: #721C24; border: 1px solid #F5C6CB;">Take Out: ₱@rangeRevenueTakeOut.ToString("N2")</span>
                        <span class="pill info">Orders: @rangeOrderCount</span>
                    </div>
                </div>
                <div class="date-range-actions">
                    <button type="button" class="btn-cancel" onclick="closeDateRangePopup()">Cancel</button>
                    <button type="submit" class="range-filter-apply">Apply</button>
                </div>
            </form>
        </div>
    </div>

    <div class="chart-container">
        <h3 style="text-align: center; color: #e67e22; margin-bottom: 15px; font-size: 1.1em;">
            Revenue chart (@rangeStart.ToString("MMM dd, yyyy") - @rangeEnd.ToString("MMM dd, yyyy"))
        </h3>
        <div style="width: 100%; height: 350px; position: relative;">
            <canvas id="revenueChart"></canvas>
        </div>
    </div>

    <div class="report-breakdown-grid">
        <div class="report-table-card">
            <h3>Payment methods</h3>
            @if (paymentBreakdown.Any())
            {
                <table class="report-table">
                    <thead>
                        <tr>
                            <th>Method</th>
                            <th>Orders</th>
                            <th>Revenue</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in paymentBreakdown)
                        {
                            <tr>
                                <td>@row.Label</td>
                                <td>@row.OrderCount</td>
                                <td>₱@row.Revenue.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="lowstock-empty">No reported sales for this range.</p>
            }
        </div>

        <div class="report-table-card">
            <h3>Order status</h3>
            @if (statusBreakdown.Any())
            {
                <table class="report-table">
                    <thead>
                        <tr>
                            <th>Status</th>
                            <th>Orders</th>
                            <th>Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in statusBreakdown)
                        {
                            <tr>
                                <td>@row.Label</td>
                                <td>@row.OrderCount</td>
                                <td>₱@row.Revenue.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="lowstock-empty">No orders for this range.</p>
            }
        </div>

        <div class="report-table-card">
            <h3>Peak time blocks</h3>
            @if (peakHourGroups.Any())
            {
                <table class="report-table">
                    <thead>
                        <tr>
                            <th>Time block</th>
                            <th>Orders</th>
                            <th>Revenue</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in peakHourGroups)
                        {
                            <tr>
                                <td>@row.Label</td>
                                <td>@row.OrderCount</td>
                                <td>₱@row.Revenue.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="lowstock-empty">No reported sales for this range.</p>
            }
        </div>
    </div>

    <div class="report-breakdown-grid two-column">
        <div class="report-table-card">
            <h3>Category sales</h3>
            @if (categoryStats.Any())
            {
                <table class="report-table">
                    <thead>
                        <tr>
                            <th>Category</th>
                            <th>Qty</th>
                            <th>Revenue</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in categoryStats)
                        {
                            <tr>
                                <td>@row.Category</td>
                                <td>@row.Quantity</td>
                                <td>₱@row.Revenue.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="lowstock-empty">No category sales for this range.</p>
            }
        </div>

        <div class="report-table-card">
            <h3>Top items by revenue</h3>
            @if (topItemsByRevenue.Any())
            {
                <table class="report-table">
                    <thead>
                        <tr>
                            <th>Item</th>
                            <th>Qty</th>
                            <th>Revenue</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in topItemsByRevenue)
                        {
                            <tr>
                                <td>@row.ItemName</td>
                                <td>@row.Quantity</td>
                                <td>₱@row.Revenue.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="lowstock-empty">No item sales for this range.</p>
            }
        </div>
    </div>

    <div id="bestSellersModal" class="lowstock-modal" aria-hidden="true">
        <div class="lowstock-modal-content">
            <div class="lowstock-modal-header">
                <h3><i class="bi bi-trophy"></i> Best sellers</h3>
                <button type="button" class="lowstock-close" aria-label="Close best sellers" onclick="hideBestSellersModal()">&times;</button>
            </div>
            <div class="lowstock-modal-body">
                <div class="best-seller-filters" style="display: flex; gap: 10px; margin-bottom: 20px; justify-content: center; flex-wrap: wrap;">
                    <button type="button" class="sales-filter-btn active" data-bs-filter="all" onclick="filterBestSellers('all')">All time</button>
                    <button type="button" class="sales-filter-btn" data-bs-filter="month" onclick="filterBestSellers('month')">This month</button>
                    <button type="button" class="sales-filter-btn" data-bs-filter="today" onclick="filterBestSellers('today')">Today</button>
                </div>
                <span class="best-sellers-sub" style="display: block; text-align: center; margin-bottom: 15px;">Top 5 by quantity</span>

                <div id="best-sellers-all" class="best-sellers-list" style="display: flex; flex-direction: column;">
                    @if (bestSellersAll.Any())
                    {
                        @foreach (var item in bestSellersAll)
                        {
                            <div class="best-seller-row">
                                <div class="best-seller-name">@item.ItemName</div>
                                <div class="best-seller-meta">
                                    <span class="pill warning">Sold: @item.Quantity</span>
                                    <span class="pill muted">₱@item.Revenue.ToString("N2")</span>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="lowstock-empty">No sales yet to rank best sellers.</p>
                    }
                </div>

                <div id="best-sellers-month" class="best-sellers-list" style="display: none; flex-direction: column;">
                    @if (bestSellersMonthly.Any())
                    {
                        @foreach (var item in bestSellersMonthly)
                        {
                            <div class="best-seller-row">
                                <div class="best-seller-name">@item.ItemName</div>
                                <div class="best-seller-meta">
                                    <span class="pill warning">Sold: @item.Quantity</span>
                                    <span class="pill muted">₱@item.Revenue.ToString("N2")</span>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="lowstock-empty">No sales this month yet to rank best sellers.</p>
                    }
                </div>

                <div id="best-sellers-today" class="best-sellers-list" style="display: none; flex-direction: column;">
                    @if (bestSellersToday.Any())
                    {
                        @foreach (var item in bestSellersToday)
                        {
                            <div class="best-seller-row">
                                <div class="best-seller-name">@item.ItemName</div>
                                <div class="best-seller-meta">
                                    <span class="pill warning">Sold: @item.Quantity</span>
                                    <span class="pill muted">₱@item.Revenue.ToString("N2")</span>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="lowstock-empty">No sales today yet to rank best sellers.</p>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <style>
        .report-warning-panel {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
            margin: 0 0 18px;
            padding: 12px 14px;
            border: 1px solid #f0c36d;
            border-radius: 8px;
            background: #fff8e6;
            color: #8a5a00;
            font-size: 0.92rem;
        }

        .report-warning-panel span {
            padding-right: 10px;
            border-right: 1px solid #efdcad;
        }

        .report-warning-panel span:last-child {
            border-right: 0;
            padding-right: 0;
        }

        .report-metric-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
            grid-auto-rows: 1fr;
            gap: 14px;
            margin: 0 0 24px;
        }

        .report-metric-card {
            min-width: 0;
            min-height: 124px;
            padding: 16px;
            border: 1px solid #f0d7bf;
            border-radius: 8px;
            background: #fff;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        .report-metric-card.primary {
            border-color: #e67e22;
            background: #fff8ef;
        }

        .report-metric-card span,
        .report-metric-card small {
            display: block;
            color: #777;
            font-size: 0.82rem;
            line-height: 1.35;
        }

        .report-metric-card strong {
            display: block;
            color: #333;
            font-size: 1.12rem;
            line-height: 1.2;
            margin: 7px 0 5px;
            overflow-wrap: anywhere;
        }

        .sales-top-grid {
            display: grid;
            grid-template-columns: minmax(0, 4fr) minmax(180px, 1fr);
            gap: 18px;
            align-items: start;
            margin-bottom: 36px;
        }

        .sales-top-grid > .best-sellers-card:only-child {
            max-width: 260px;
        }

        .branch-revenue-card {
            margin: 0;
            align-items: stretch;
            justify-content: flex-start;
            max-height: none;
            width: 100%;
            box-sizing: border-box;
        }

        .branch-revenue-card h3 {
            text-align: center;
        }

        .branch-revenue-table-wrap {
            width: 100%;
            overflow-x: auto;
        }

        .branch-revenue-table {
            width: 100%;
            border-collapse: collapse;
            table-layout: fixed;
        }

        .branch-revenue-table th,
        .branch-revenue-table td {
            padding: 10px;
            border-bottom: 1px solid #f8e3cf;
            white-space: nowrap;
        }

        .branch-revenue-table th {
            border-bottom-color: #f0d7bf;
            color: #555;
            font-size: 0.86rem;
        }

        .branch-revenue-table th:first-child,
        .branch-revenue-table td:first-child {
            text-align: left;
            white-space: normal;
            width: 38%;
        }

        .branch-revenue-table th:not(:first-child),
        .branch-revenue-table td:not(:first-child) {
            text-align: right;
        }

        .branch-revenue-table td:last-child {
            font-weight: 700;
        }

        .branch-detail-summary {
            display: grid;
            grid-template-columns: repeat(4, minmax(120px, 1fr));
            gap: 12px;
        }

        .branch-detail-summary > div {
            border: 1px solid #f0d7bf;
            border-radius: 8px;
            padding: 12px;
            background: #fffaf5;
            min-width: 0;
        }

        .branch-detail-summary span {
            display: block;
            color: #777;
            font-size: 0.82rem;
            margin-bottom: 6px;
        }

        .branch-detail-summary strong {
            display: block;
            color: #333;
            font-size: 1.05rem;
            line-height: 1.2;
            overflow-wrap: anywhere;
        }

        .branch-detail-breakdown {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
            margin-top: 14px;
        }

        .metric-positive {
            color: #27ae60 !important;
        }

        .metric-negative {
            color: #c0392b !important;
        }

        .best-sellers-card {
            box-sizing: border-box;
            min-height: 132px;
            height: auto;
            justify-content: center;
            align-items: flex-start;
            flex-direction: column;
            margin: 0;
            overflow: visible;
            padding: 18px;
        }

        .report-breakdown-grid {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 18px;
            margin: 24px 0;
            align-items: stretch;
            clear: both;
        }

        .report-breakdown-grid.two-column {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .report-table-card {
            min-width: 0;
            min-height: 0;
            height: 100%;
            box-sizing: border-box;
            padding: 18px;
            border: 2px solid #f0d7bf;
            border-radius: 8px;
            background: #fff;
            overflow-x: auto;
            display: flex;
            flex-direction: column;
        }

        .report-table-card h3 {
            color: #e67e22;
            margin: 0 0 14px;
            font-size: 1.05rem;
        }

        .report-table {
            width: 100%;
            border-collapse: collapse;
        }

        .report-table th,
        .report-table td {
            padding: 9px 8px;
            border-bottom: 1px solid #f8e3cf;
            vertical-align: top;
        }

        .report-table th {
            color: #555;
            font-size: 0.84rem;
            text-align: left;
            white-space: nowrap;
        }

        .report-table td:not(:first-child),
        .report-table th:not(:first-child) {
            text-align: right;
            white-space: nowrap;
        }

        .report-table td:first-child {
            overflow-wrap: anywhere;
        }

        @@media (max-width: 900px) {
            .report-metric-grid,
            .report-breakdown-grid,
            .report-breakdown-grid.two-column {
                grid-template-columns: 1fr 1fr;
            }

            .sales-top-grid {
                grid-template-columns: 1fr;
            }

            .sales-top-grid > .best-sellers-card:only-child {
                max-width: none;
            }

            .branch-detail-summary {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }
        }

        @@media (max-width: 520px) {
            .report-metric-grid,
            .report-breakdown-grid,
            .report-breakdown-grid.two-column {
                grid-template-columns: 1fr;
            }

            .branch-detail-summary {
                grid-template-columns: 1fr;
            }
        }
    </style>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        const salesIndexUrl = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Url.Action("Index", "Sales", new { area = "Admin" })));
        const selectedBranchFilter = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(branchFilter));
        const ctx = document.getElementById('revenueChart');
        let revenueChart;
        const chartLabels = @Html.Raw(chartLabelsJson);
        const chartValues = @Html.Raw(chartValuesJson);

        function initChart(labels, values) {
            if (revenueChart) revenueChart.destroy();
            revenueChart = new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'Revenue (₱)',
                        data: values,
                        backgroundColor: 'rgba(230, 126, 34, 0.7)',
                        borderColor: 'rgba(230, 126, 34, 1)',
                        borderWidth: 2,
                        borderRadius: 8
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    layout: { padding: { top: 10, bottom: 10, left: 10, right: 10 } },
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: {
                                color: '#333',
                                font: { size: 11 },
                                maxTicksLimit: 8,
                                callback: function(value) {
                                    if (value >= 1000) return '₱' + (value / 1000).toFixed(1) + 'k';
                                    return '₱' + value.toLocaleString('en-US', { minimumFractionDigits: 0, maximumFractionDigits: 0 });
                                }
                            },
                            grid: { color: 'rgba(0,0,0,0.05)', drawBorder: false }
                        },
                        x: {
                            ticks: { color: '#333', font: { size: 10 }, maxRotation: 45, minRotation: 0, autoSkip: true, maxTicksLimit: 10 },
                            grid: { color: 'rgba(0,0,0,0.05)', display: false }
                        }
                    },
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            backgroundColor: '#fff',
                            borderColor: '#ccc',
                            borderWidth: 1,
                            titleColor: '#333',
                            bodyColor: '#333',
                            titleFont: { size: 12 },
                            bodyFont: { size: 12 },
                            padding: 10,
                            callbacks: {
                                label: function(context) {
                                    return 'Revenue: ₱' + context.parsed.y.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                                }
                            }
                        }
                    }
                }
            });
        }

        initChart(chartLabels, chartValues);

        function filterSalesChart(filterType) {
            document.querySelectorAll('.revenue-chart-filter').forEach(btn => btn.classList.remove('active'));
            const activeBtn = document.querySelector('.revenue-chart-filter[data-filter="' + filterType + '"]');
            if (activeBtn) activeBtn.classList.add('active');

            const url = new URL(salesIndexUrl, window.location.origin);
            url.searchParams.delete('startDate');
            url.searchParams.delete('endDate');

            const today = new Date();
            let startDate, endDate;

            if (filterType === 'week') {
                const dayOfWeek = today.getDay();
                startDate = new Date(today.getFullYear(), today.getMonth(), today.getDate() - dayOfWeek + (dayOfWeek === 0 ? -6 : 1));
                endDate = new Date(startDate);
                endDate.setDate(endDate.getDate() + 6);
            } else if (filterType === 'month') {
                startDate = new Date(today.getFullYear(), today.getMonth(), 1);
                endDate = new Date(today.getFullYear(), today.getMonth() + 1, 0);
            } else if (filterType === 'year') {
                startDate = new Date(today.getFullYear(), 0, 1);
                endDate = new Date(today.getFullYear(), 11, 31);
            }

            if (startDate && endDate) {
                url.searchParams.set('startDate', startDate.toISOString().split('T')[0]);
                url.searchParams.set('endDate', endDate.toISOString().split('T')[0]);
            }
            if (selectedBranchFilter) {
                url.searchParams.set('branchFilter', selectedBranchFilter);
            }

            window.location.href = url.toString();
        }

        function filterBestSellers(filterType) {
            const allList = document.getElementById('best-sellers-all');
            const monthList = document.getElementById('best-sellers-month');
            const todayList = document.getElementById('best-sellers-today');
            const buttons = document.querySelectorAll('.best-seller-filters .sales-filter-btn');
            allList.style.display = 'none';
            monthList.style.display = 'none';
            todayList.style.display = 'none';
            if (filterType === 'today') todayList.style.display = 'flex';
            else if (filterType === 'month') monthList.style.display = 'flex';
            else allList.style.display = 'flex';
            buttons.forEach(btn => btn.classList.remove('active'));
            const activeBtn = document.querySelector('.best-seller-filters .sales-filter-btn[data-bs-filter="' + filterType + '"]');
            if (activeBtn) activeBtn.classList.add('active');
        }

        const bestSellersModal = document.getElementById('bestSellersModal');
        function showBestSellersModal() {
            if (!bestSellersModal) return;
            bestSellersModal.classList.add('open');
            bestSellersModal.setAttribute('aria-hidden', 'false');
        }
        function hideBestSellersModal() {
            if (!bestSellersModal) return;
            bestSellersModal.classList.remove('open');
            bestSellersModal.setAttribute('aria-hidden', 'true');
        }
        if (bestSellersModal) {
            bestSellersModal.addEventListener('click', (event) => {
                if (event.target === bestSellersModal) hideBestSellersModal();
            });
            document.addEventListener('keydown', (event) => {
                if (event.key === 'Escape' && bestSellersModal.classList.contains('open')) hideBestSellersModal();
            });
        }

        const dateRangeModal = document.getElementById('dateRangeModal');
        function openDateRangePopup() {
            if (!dateRangeModal) return;
            dateRangeModal.classList.add('open');
            dateRangeModal.setAttribute('aria-hidden', 'false');
        }
        function closeDateRangePopup() {
            if (!dateRangeModal) return;
            dateRangeModal.classList.remove('open');
            dateRangeModal.setAttribute('aria-hidden', 'true');
        }
        if (dateRangeModal) {
            dateRangeModal.addEventListener('click', (event) => {
                if (event.target === dateRangeModal) closeDateRangePopup();
            });
            document.addEventListener('keydown', (event) => {
                if (event.key === 'Escape' && dateRangeModal.classList.contains('open')) closeDateRangePopup();
            });
        }
    </script>
}
