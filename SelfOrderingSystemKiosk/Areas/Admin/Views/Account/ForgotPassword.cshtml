@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Forgot Password - KDS Admin</title>
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
</head>
<body class="auth-body">
    <div class="auth-container">
        <div class="auth-card">
            <h2 class="auth-title">Forgot Password</h2>
            <form asp-action="ForgotPassword" method="post" class="auth-form">
                @Html.AntiForgeryToken()
                <p style="margin: 0 0 14px; color: #666; line-height: 1.45;">
                    Passwords are reset by an owner or branch manager. Enter your username or email to prepare a reset request.
                </p>
                <input type="text" name="account" placeholder="Enter username or email address" required />
                <button type="submit" class="auth-btn">Prepare Reset Request</button>

                @if (ViewBag.Error != null)
                {
                    <p class="auth-error">@ViewBag.Error</p>
                }

                @if (ViewBag.Message != null)
                {
                    <p class="auth-success">@ViewBag.Message</p>
                }

                @if (ViewBag.ResetMailto != null)
                {
                    <a class="auth-btn" href="@ViewBag.ResetMailto" style="display:block;text-align:center;text-decoration:none;margin-top:10px;">
                        Email Owner / Manager
                    </a>
                }

                @if (ViewBag.ResetContacts is List<string> contacts && contacts.Any())
                {
                    <p style="margin: 10px 0 0; color: #666; font-size: 0.9rem; line-height: 1.4;">
                        Send the request to: @string.Join(", ", contacts)
                    </p>
                }

                <div class="auth-links">
                    <a asp-action="Login" asp-controller="Account">Back to Login</a>
                </div>
            </form>
        </div>
    </div>
</body>
</html>
