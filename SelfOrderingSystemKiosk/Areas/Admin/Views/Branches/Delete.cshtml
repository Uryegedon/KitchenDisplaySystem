@model SelfOrderingSystemKiosk.Areas.Admin.Models.Branch
@{
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="branch-delete-container">
    <div class="delete-card">
        <div class="delete-icon">
            <i class="bi bi-exclamation-triangle"></i>
        </div>
        <h1>Delete Branch</h1>
        <p class="delete-warning">
            This action cannot be undone. All data associated with this branch will be affected.
        </p>

        <div class="branch-info">
            <div class="branch-info-header">
                <h2>@Model.BranchName</h2>
                <span class="branch-code">@Model.BranchCode</span>
            </div>
            @if (!string.IsNullOrEmpty(Model.Address))
            {
                <p class="branch-detail"><i class="bi bi-geo-alt"></i> @Model.Address</p>
            }
            @if (!string.IsNullOrEmpty(Model.Phone))
            {
                <p class="branch-detail"><i class="bi bi-telephone"></i> @Model.Phone</p>
            }
            @if (!string.IsNullOrEmpty(Model.Email))
            {
                <p class="branch-detail"><i class="bi bi-envelope"></i> @Model.Email</p>
            }
        </div>

        <form asp-action="DeleteConfirmed" method="post" class="delete-form">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            
            <div class="confirmation-input">
                <label for="confirmName">Type <strong>@Model.BranchName</strong> to confirm:</label>
                <input type="text" id="confirmName" name="confirmName" class="form-control" 
                       placeholder="Type branch name here..." autocomplete="off" />
            </div>

            <div class="form-actions">
                <button type="submit" id="deleteBtn" class="btn-delete" disabled>
                    <i class="bi bi-trash"></i> Yes, Delete This Branch
                </button>
                <a asp-action="Index" class="btn-cancel">No, Go Back</a>
            </div>
        </form>
    </div>
</div>

@section Styles {
    <style>
        .branch-delete-container {
            padding: 20px;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 80vh;
        }

        .delete-card {
            background: white;
            padding: 40px;
            border-radius: 16px;
            box-shadow: 0 4px 24px rgba(0,0,0,0.12);
            max-width: 500px;
            width: 100%;
            text-align: center;
        }

        .delete-icon {
            width: 80px;
            height: 80px;
            margin: 0 auto 20px;
            background: #fee;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .delete-icon i {
            font-size: 2.5rem;
            color: #e74c3c;
        }

        .delete-card h1 {
            margin: 0 0 12px 0;
            font-size: 1.6rem;
            color: #2c3e50;
        }

        .delete-warning {
            color: #e74c3c;
            font-weight: 600;
            margin-bottom: 24px;
        }

        .branch-info {
            background: #f8f9fa;
            padding: 20px;
            border-radius: 12px;
            margin-bottom: 24px;
            text-align: left;
        }

        .branch-info-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 12px;
            padding-bottom: 12px;
            border-bottom: 2px solid #e9ecef;
        }

        .branch-info-header h2 {
            margin: 0;
            font-size: 1.3rem;
            color: #2c3e50;
        }

        .branch-code {
            font-family: monospace;
            color: #667eea;
            font-weight: 600;
        }

        .branch-detail {
            margin: 8px 0;
            color: #555;
            font-size: 0.9rem;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .branch-detail i {
            color: #667eea;
            width: 18px;
        }

        .confirmation-input {
            margin-bottom: 20px;
            text-align: left;
        }

        .confirmation-input label {
            display: block;
            margin-bottom: 8px;
            font-weight: 600;
            color: #495057;
        }

        .form-control {
            width: 100%;
            padding: 12px 16px;
            border: 2px solid #e9ecef;
            border-radius: 8px;
            font-size: 1rem;
            transition: border-color 0.2s, box-shadow 0.2s;
            box-sizing: border-box;
        }

        .form-control:focus {
            outline: none;
            border-color: #e74c3c;
            box-shadow: 0 0 0 3px rgba(231, 76, 60, 0.15);
        }

        .form-actions {
            display: flex;
            gap: 12px;
            justify-content: center;
        }

        .btn-delete {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 12px 24px;
            background: #e74c3c;
            color: white;
            border: none;
            border-radius: 8px;
            font-weight: 600;
            font-size: 1rem;
            cursor: pointer;
            transition: all 0.2s;
            opacity: 0.5;
        }

        .btn-delete:not(:disabled) {
            opacity: 1;
        }

        .btn-delete:not(:disabled):hover {
            background: #c0392b;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(231, 76, 60, 0.4);
        }

        .btn-delete:disabled {
            cursor: not-allowed;
        }

        .btn-cancel {
            display: inline-flex;
            align-items: center;
            padding: 12px 24px;
            background: #f8f9fa;
            color: #495057;
            text-decoration: none;
            border-radius: 8px;
            font-weight: 600;
            border: 1px solid #dee2e6;
            transition: all 0.2s;
        }

        .btn-cancel:hover {
            background: #e9ecef;
        }
    </style>
}

@section Scripts {
    <script>
        const confirmInput = document.getElementById('confirmName');
        const deleteBtn = document.getElementById('deleteBtn');
        const expectedValue = '@Model.BranchName';

        confirmInput.addEventListener('input', function() {
            if (this.value === expectedValue) {
                deleteBtn.disabled = false;
            } else {
                deleteBtn.disabled = true;
            }
        });

        document.querySelector('.delete-form').addEventListener('submit', function(e) {
            if (confirmInput.value !== expectedValue) {
                e.preventDefault();
                alert('Please type the branch name exactly to confirm deletion.');
            }
        });
    </script>
}
