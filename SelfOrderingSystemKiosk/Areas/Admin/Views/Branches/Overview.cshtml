@{
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    var allBranches = ViewBag.AllBranches as List<SelfOrderingSystemKiosk.Areas.Admin.Models.Branch> ?? new List<SelfOrderingSystemKiosk.Areas.Admin.Models.Branch>();
    var selectedBranchId = ViewBag.SelectedBranchId as string;
    var selectedPeriod = ViewBag.SelectedPeriod as string ?? "today";
    var periodLabel = ViewBag.PeriodLabel as string ?? "Today";
    var selectedBranch = ViewBag.SelectedBranch as SelfOrderingSystemKiosk.Areas.Admin.Models.Branch;
    var selectedBranchManagers = ViewBag.SelectedBranchManagers as string ?? "Unassigned";
    var managerNamesByBranch = ViewBag.ManagerNamesByBranch as Dictionary<string, string> ?? new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
    var branchStats = ViewBag.BranchStats as List<SelfOrderingSystemKiosk.Controllers.BranchOverviewStats> ?? new List<SelfOrderingSystemKiosk.Controllers.BranchOverviewStats>();
    var branchOrders = ViewBag.BranchOrders as List<SelfOrderingSystemKiosk.Areas.Customer.Models.Order> ?? new List<SelfOrderingSystemKiosk.Areas.Customer.Models.Order>();
    string NormalizeMetricValue(string value) => new string((value ?? "").Where(char.IsLetterOrDigit).Select(char.ToLowerInvariant).ToArray());
}

<div class="branch-overview-container">
    <div class="overview-header">
        <div>
            <p class="overview-subtitle">Branch status and ordering channels</p>
        </div>
        <div style="display:flex;gap:10px;flex-wrap:wrap;">
            <a asp-action="Index" class="btn-secondary">
                <i class="bi bi-grid"></i> Manage Branches
            </a>
        </div>
    </div>

    <!-- Filters -->
    <div class="filters-card">
        <form method="get" class="filters-form">
            <div class="filter-group">
                <label for="branchId">Branch</label>
                <select name="branchId" id="branchId" class="form-select" onchange="this.form.submit()">
                    <option value="">All Branches</option>
                    @foreach (var b in allBranches.Where(b => b.IsActive))
                    {
                        <option value="@b.Id" selected="@(selectedBranchId == b.Id)">@b.BranchName (@b.BranchCode)</option>
                    }
                </select>
            </div>
            <div class="filter-group">
                <label for="period">Time Period</label>
                <select name="period" id="period" class="form-select" onchange="this.form.submit()">
                    <option value="today" selected="@(selectedPeriod == "today")">Today</option>
                    <option value="yesterday" selected="@(selectedPeriod == "yesterday")">Yesterday</option>
                    <option value="week" selected="@(selectedPeriod == "week")">This Week</option>
                    <option value="month" selected="@(selectedPeriod == "month")">This Month</option>
                </select>
            </div>
            <div class="filter-period-label">
                <span class="period-badge">@periodLabel</span>
            </div>
        </form>
    </div>

    @if (!string.IsNullOrEmpty(selectedBranchId) && selectedBranch != null)
    {
        <!-- Single Branch Detail View -->
        <div class="single-branch-view">
            <div class="branch-detail-header">
                <div>
                    <h2>@selectedBranch.BranchName <span class="branch-code">@selectedBranch.BranchCode</span></h2>
                    <p class="branch-manager-line">Managed by: <strong>@selectedBranchManagers</strong></p>
                </div>
                <span class="status-badge @(selectedBranch.IsActive ? "status-active" : "status-inactive")">
                    @(selectedBranch.IsActive ? "Active" : "Inactive")
                </span>
            </div>

            @{
                var billableOrders = branchOrders.Where(o => o.Total > 0).ToList();
                var totalRevenue = billableOrders.Sum(o => o.Total);
                var totalCost = billableOrders.Sum(o => o.OrderCost);
                var totalProfit = billableOrders.Sum(o => o.Profit);
                var totalOrders = branchOrders.Count;
                var dineInCount = branchOrders.Count(o => NormalizeMetricValue(o.DiningType) == "dinein");
                var takeOutCount = branchOrders.Count(o => NormalizeMetricValue(o.DiningType) == "takeout");
                var kioskCount = branchOrders.Count(o => NormalizeMetricValue(o.OrderChannel) == "kiosk");
                var qrCount = branchOrders.Count(o => NormalizeMetricValue(o.OrderChannel) == "qr");
            }

            <div class="stats-grid">
                <div class="stat-card">
                    <div class="stat-icon" style="background: linear-gradient(135deg, #27ae60, #1e8449);">
                        <i class="bi bi-cash-stack"></i>
                    </div>
                    <div class="stat-details">
                        <div class="stat-value">₱@totalRevenue.ToString("N2")</div>
                        <div class="stat-label">Revenue</div>
                    </div>
                </div>

                <div class="stat-card">
                    <div class="stat-icon" style="background: linear-gradient(135deg, #16a085, #117864);">
                        <i class="bi bi-graph-up-arrow"></i>
                    </div>
                    <div class="stat-details">
                        <div class="stat-value">₱@totalProfit.ToString("N2")</div>
                        <div class="stat-label">Profit after ₱@totalCost.ToString("N2") COGS</div>
                    </div>
                </div>

                <div class="stat-card">
                    <div class="stat-icon" style="background: linear-gradient(135deg, #f39c12, #e67e22);">
                        <i class="bi bi-receipt"></i>
                    </div>
                    <div class="stat-details">
                        <div class="stat-value">@totalOrders</div>
                        <div class="stat-label">Total Orders</div>
                    </div>
                </div>

                <div class="stat-card">
                    <div class="stat-icon" style="background: linear-gradient(135deg, #3498db, #2980b9);">
                        <i class="bi bi-house-door"></i>
                    </div>
                    <div class="stat-details">
                        <div class="stat-value">@dineInCount</div>
                        <div class="stat-label">Dine-In Orders</div>
                    </div>
                </div>

                <div class="stat-card">
                    <div class="stat-icon" style="background: linear-gradient(135deg, #95a5a6, #7f8c8d);">
                        <i class="bi bi-bag"></i>
                    </div>
                    <div class="stat-details">
                        <div class="stat-value">@takeOutCount</div>
                        <div class="stat-label">Take-Out Orders</div>
                    </div>
                </div>

                <div class="stat-card">
                    <div class="stat-icon" style="background: linear-gradient(135deg, #e67e22, #d35400);">
                        <i class="bi bi-tv"></i>
                    </div>
                    <div class="stat-details">
                        <div class="stat-value">@kioskCount</div>
                        <div class="stat-label">Kiosk Orders</div>
                    </div>
                </div>

                <div class="stat-card">
                    <div class="stat-icon" style="background: linear-gradient(135deg, #f39c12, #d35400);">
                        <i class="bi bi-qr-code"></i>
                    </div>
                    <div class="stat-details">
                        <div class="stat-value">@qrCount</div>
                        <div class="stat-label">QR Orders</div>
                    </div>
                </div>
            </div>

            <div class="recent-orders">
                <h3>Recent Orders (@branchOrders.Count)</h3>
                @if (branchOrders.Any())
                {
                    <div class="orders-table-container">
                        <table class="orders-table">
                            <thead>
                                <tr>
                                    <th>Order #</th>
                                    <th>Time</th>
                                    <th>Type</th>
                                    <th>Dining</th>
                                    <th>Channel</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var order in branchOrders.OrderByDescending(o => o.OrderDate).Take(20))
                                {
                                    <tr>
                                        <td><strong>@order.OrderNumber</strong></td>
                                        <td>@AppClock.ToLocal(order.OrderDate).ToString("MMM dd, HH:mm")</td>
                                        <td><span class="badge badge-type">@order.OrderType</span></td>
                                        <td><span class="badge badge-dining">@order.DiningType</span></td>
                                        <td><span class="badge badge-channel">@order.OrderChannel</span></td>
                                        <td><span class="badge badge-@order.Status.ToLower().Replace(" ", "-")">@order.Status</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="empty-message">No orders found for this period.</p>
                }
            </div>
        </div>
    }
    else
    {
        <!-- All Branches Overview -->
        @if (!allBranches.Any())
        {
            <div class="empty-state">
                <i class="bi bi-shop" style="font-size: 3rem; color: #ccc;"></i>
                <h3>No branches configured</h3>
                <p>Add branches to start viewing multi-branch statistics.</p>
                <a asp-action="Create" class="btn-primary">Add Your First Branch</a>
            </div>
        }
        else if (!branchStats.Any())
        {
            <div class="empty-state">
                <i class="bi bi-graph-down" style="font-size: 3rem; color: #ccc;"></i>
                <h3>No data for selected period</h3>
                <p>There are no orders across all branches for @periodLabel.ToLower().</p>
            </div>
        }
        else
        {
            <!-- Summary Cards -->
            <div class="summary-stats">
                <div class="summary-card">
                    <div class="summary-label">Active Branches</div>
                    <div class="summary-value">@allBranches.Count(b => b.IsActive)<span style="font-size: 0.5em; color: #888;">/@allBranches.Count</span></div>
                </div>
                <div class="summary-card">
                    <div class="summary-label">Total Orders</div>
                    <div class="summary-value">@branchStats.Sum(s => s.TotalOrders)</div>
                </div>
            </div>

            <!-- Branch Comparison Table -->
            <div class="branches-comparison">
                <h3>Branch Activity Comparison</h3>
                <div class="comparison-table-container">
                    <table class="comparison-table">
                        <thead>
                            <tr>
                                <th>Branch</th>
                                <th>Managed By</th>
                                <th>Status</th>
                                <th>Orders</th>
                                <th>Billable</th>
                                <th>Revenue</th>
                                <th>Profit</th>
                                <th>Dine-In</th>
                                <th>Take-Out</th>
                                <th>Kiosk</th>
                                <th>QR</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var stats in branchStats)
                            {
                                var branch = allBranches.FirstOrDefault(b => b.Id == stats.BranchId);
                                var managerNames = managerNamesByBranch.TryGetValue(stats.BranchId, out var names) && !string.IsNullOrWhiteSpace(names)
                                    ? names
                                    : "Unassigned";
                                <tr>
                                    <td>
                                        <div class="branch-name-cell">
                                            <strong>@stats.BranchName</strong>
                                            <small>@stats.BranchCode</small>
                                        </div>
                                    </td>
                                    <td class="manager-name-cell">@managerNames</td>
                                    <td>
                                        <span class="status-badge @(stats.IsActive ? "status-active" : "status-inactive")">
                                            @(stats.IsActive ? "Active" : "Inactive")
                                        </span>
                                    </td>
                                    <td><strong>@stats.TotalOrders</strong></td>
                                    <td>@stats.BillableOrders</td>
                                    <td class="metric-money">₱@stats.TotalRevenue.ToString("N2")</td>
                                    <td class="metric-money @(stats.Profit < 0 ? "metric-negative" : "metric-positive")">₱@stats.Profit.ToString("N2")</td>
                                    <td>@stats.DineInOrders</td>
                                    <td>@stats.TakeOutOrders</td>
                                    <td>@stats.KioskOrders</td>
                                    <td>@stats.QrOrders</td>
                                    <td>
                                        <a asp-action="Overview" asp-route-branchId="@stats.BranchId" asp-route-period="@selectedPeriod" class="btn-link">
                                            <i class="bi bi-eye"></i> Details
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    }
</div>

@section Styles {
    <style>
        .branch-overview-container {
            padding: 0;
        }

        .overview-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 24px;
        }

        .overview-subtitle {
            margin: 0;
            color: #7f8c8d;
            font-size: 0.95rem;
        }

        .btn-secondary {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 10px 20px;
            background-color: #95a5a6;
            color: white;
            text-decoration: none;
            border-radius: 10px;
            font-weight: 600;
            border: none;
            transition: background-color 0.3s;
        }

        .btn-secondary:hover {
            background-color: #7f8c8d;
        }

        .btn-primary {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 12px 25px;
            background-color: #e67e22;
            color: white;
            text-decoration: none;
            border-radius: 10px;
            font-weight: 600;
        }

        .filters-card {
            background: #fff;
            padding: 20px;
            border-radius: 12px;
            box-shadow: 0 2px 6px rgba(0, 0, 0, 0.05);
            border: 2px solid #f0d7bf;
            margin-bottom: 24px;
        }

        .filters-form {
            display: flex;
            gap: 20px;
            align-items: flex-end;
            flex-wrap: wrap;
        }

        .filter-group {
            display: flex;
            flex-direction: column;
            gap: 6px;
        }

        .filter-group label {
            font-weight: 600;
            color: #555;
            font-size: 0.9rem;
        }

        .form-select {
            padding: 10px 16px;
            border: 2px solid #f0d7bf;
            border-radius: 10px;
            font-size: 1rem;
            background: #fffaf5;
            cursor: pointer;
            min-width: 180px;
        }

        .form-select:focus {
            outline: none;
            border-color: #e67e22;
        }

        .period-badge {
            display: inline-block;
            padding: 8px 16px;
            background-color: #e67e22;
            color: white;
            border-radius: 20px;
            font-weight: 600;
            font-size: 0.9rem;
        }

        /* Stats Grid */
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 16px;
            margin-bottom: 24px;
        }

        .stat-card {
            background: #fff;
            padding: 20px;
            border-radius: 12px;
            box-shadow: 0 2px 6px rgba(0, 0, 0, 0.05);
            border: 2px solid #f0d7bf;
            display: flex;
            align-items: center;
            gap: 16px;
        }

        .stat-icon {
            width: 56px;
            height: 56px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

        .stat-icon i {
            font-size: 1.5rem;
            color: white;
        }

        .stat-details {
            flex: 1;
        }

        .stat-value {
            font-size: 1.5rem;
            font-weight: 700;
            color: #333;
        }

        .stat-label {
            font-size: 0.85rem;
            color: #7f8c8d;
            margin-top: 4px;
        }

        /* Summary Stats */
        .summary-stats {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 16px;
            margin-bottom: 24px;
        }

        .summary-card {
            background: #fff;
            padding: 20px;
            border-radius: 12px;
            box-shadow: 0 2px 6px rgba(0, 0, 0, 0.05);
            border: 2px solid #f0d7bf;
            text-align: center;
        }

        .summary-card.highlight {
            background: #fff6e5;
            color: #555;
            border-color: #f7b267;
        }

        .summary-card.highlight .summary-label {
            color: #d35400;
        }

        .summary-card.highlight .summary-value {
            color: #d35400;
        }

        .summary-label {
            font-size: 0.85rem;
            color: #7f8c8d;
            margin-bottom: 8px;
        }

        .summary-value {
            font-size: 1.8rem;
            font-weight: 700;
            color: #333;
        }

        /* Single Branch View */
        .single-branch-view {
            background: #fff;
            border-radius: 12px;
            box-shadow: 0 2px 6px rgba(0, 0, 0, 0.05);
            border: 2px solid #f0d7bf;
            overflow: hidden;
        }

        .branch-detail-header {
            padding: 20px 24px;
            background: #fff3e6;
            color: #555;
            border-bottom: 2px solid #f0d7bf;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .branch-detail-header h2 {
            margin: 0 0 6px;
            display: flex;
            align-items: center;
            gap: 12px;
            color: #d35400;
        }

        .branch-manager-line {
            margin: 0;
            color: #666;
            font-size: 0.92rem;
        }

        .branch-manager-line strong {
            color: #333;
        }

        .branch-code {
            font-family: monospace;
            color: #e67e22;
        }

        .status-badge {
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 0.75rem;
            font-weight: 600;
            text-transform: uppercase;
        }

        .status-active {
            background: rgba(39, 174, 96, 0.2);
            color: #27ae60;
        }

        .status-inactive {
            background: rgba(149, 165, 166, 0.2);
            color: #95a5a6;
        }

        .orders-breakdown, .recent-orders {
            padding: 24px;
            border-top: 1px solid #f0d7bf;
        }

        .orders-breakdown h3, .recent-orders h3 {
            margin: 0 0 16px 0;
            color: #d35400;
        }

        .breakdown-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 16px;
        }

        .breakdown-item {
            padding: 16px;
            background: #fffaf5;
            border: 1px solid #f0d7bf;
            border-radius: 10px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .breakdown-item.breakdown-total {
            background: #fff6e5;
            color: #555;
            border-color: #f7b267;
        }

        .breakdown-label {
            font-size: 0.9rem;
            color: #7f8c8d;
        }

        .breakdown-item.breakdown-total .breakdown-label {
            color: #d35400;
        }

        .breakdown-value {
            font-weight: 700;
            font-size: 1.1rem;
        }

        /* Orders Table */
        .orders-table-container {
            overflow-x: auto;
        }

        .orders-table {
            width: 100%;
            border-collapse: collapse;
        }

        .orders-table th, .orders-table td {
            padding: 12px;
            text-align: left;
            border-bottom: 1px solid #f0d7bf;
        }

        .orders-table th {
            background: #fff3e6;
            font-weight: 600;
            color: #d35400;
            font-size: 0.85rem;
            text-transform: uppercase;
        }

        .orders-table tr:hover {
            background: #fffaf5;
        }

        .badge {
            display: inline-block;
            padding: 4px 10px;
            border-radius: 20px;
            font-size: 0.75rem;
            font-weight: 600;
        }

        .badge-type { background: #e3f2fd; color: #1976d2; }
        .badge-dining { background: #fff3e0; color: #f57c00; }
        .badge-channel { background: #f3e5f5; color: #7b1fa2; }
        .badge-pending { background: #fff3e0; color: #f57c00; }
        .badge-in-progress { background: #e3f2fd; color: #1976d2; }
        .badge-completed { background: #e8f5e9; color: #388e3c; }
        .badge-canceled { background: #ffebee; color: #d32f2f; }

        /* Comparison Table */
        .branches-comparison {
            background: #fff;
            border-radius: 12px;
            box-shadow: 0 2px 6px rgba(0, 0, 0, 0.05);
            border: 2px solid #f0d7bf;
            margin-bottom: 24px;
            overflow: hidden;
        }

        .branches-comparison h3 {
            margin: 0;
            padding: 20px 24px;
            background: #fff3e6;
            color: #d35400;
        }

        .comparison-table-container {
            overflow-x: auto;
        }

        .comparison-table {
            width: 100%;
            border-collapse: collapse;
        }

        .comparison-table th, .comparison-table td {
            padding: 14px 16px;
            text-align: left;
            border-bottom: 1px solid #f0d7bf;
            white-space: nowrap;
        }

        .comparison-table th {
            background: #fff3e6;
            font-weight: 600;
            color: #d35400;
            font-size: 0.85rem;
        }

        .branch-name-cell {
            display: flex;
            flex-direction: column;
            gap: 4px;
        }

        .branch-name-cell small {
            color: #7f8c8d;
            font-family: monospace;
        }

        .manager-name-cell {
            color: #555;
            min-width: 130px;
            white-space: normal !important;
        }

        .metric-money {
            font-weight: 700;
            color: #333;
        }

        .metric-positive {
            color: #27ae60;
        }

        .metric-negative {
            color: #c0392b;
        }

        .btn-link {
            color: #e67e22;
            text-decoration: none;
            font-weight: 600;
            display: inline-flex;
            align-items: center;
            gap: 4px;
        }

        .btn-link:hover {
            color: #d35400;
        }

        /* Revenue Bars */
        .revenue-chart-card {
            background: #fff;
            border-radius: 12px;
            box-shadow: 0 2px 6px rgba(0, 0, 0, 0.05);
            border: 2px solid #f0d7bf;
            padding: 24px;
        }

        .revenue-chart-card h3 {
            margin: 0 0 20px 0;
            color: #d35400;
        }

        .revenue-bars {
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .revenue-bar-row {
            display: flex;
            align-items: center;
            gap: 16px;
        }

        .revenue-bar-label {
            width: 150px;
            font-weight: 600;
            color: #555;
            font-size: 0.9rem;
        }

        .revenue-bar-container {
            flex: 1;
            position: relative;
            height: 32px;
            background: #f0f0f0;
            border-radius: 8px;
            overflow: hidden;
        }

        .revenue-bar {
            height: 100%;
            background: linear-gradient(135deg, #f39c12, #e67e22);
            border-radius: 8px;
            transition: width 0.3s ease;
        }

        .revenue-bar-value {
            position: absolute;
            right: 12px;
            top: 50%;
            transform: translateY(-50%);
            font-weight: 700;
            color: #333;
            font-size: 0.9rem;
        }

        .empty-state {
            text-align: center;
            padding: 60px 20px;
            background: #fff;
            border-radius: 12px;
            box-shadow: 0 2px 6px rgba(0, 0, 0, 0.05);
            border: 2px solid #f0d7bf;
        }

        .empty-state h3 {
            margin: 16px 0 8px;
            color: #d35400;
        }

        .empty-state p {
            color: #7f8c8d;
            margin-bottom: 24px;
        }

        .empty-message {
            text-align: center;
            color: #7f8c8d;
            padding: 20px;
        }

        @@media (max-width: 768px) {
            .overview-header {
                flex-direction: column;
                align-items: flex-start;
                gap: 16px;
            }

            .stats-grid, .summary-stats {
                grid-template-columns: 1fr;
            }

            .breakdown-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
