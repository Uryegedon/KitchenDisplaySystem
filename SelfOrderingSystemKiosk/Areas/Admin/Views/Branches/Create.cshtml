@model SelfOrderingSystemKiosk.Areas.Admin.Models.Branch
@{
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="branch-form-container">
    <div class="form-header">
        <a asp-action="Index" class="back-link">
            <i class="bi bi-arrow-left"></i> Back to Branches
        </a>
        <h1>Add New Branch</h1>
    </div>

    <form asp-action="Create" method="post" class="branch-form">
        @Html.AntiForgeryToken()

        <div class="form-section">
            <h3>Basic Information</h3>
            
            <div class="form-group">
                <label asp-for="BranchCode">Branch Code <span class="required">*</span></label>
                <input asp-for="BranchCode" class="form-control" placeholder="e.g., MAIN1, B2, NOVA9" />
                <span asp-validation-for="BranchCode" class="text-danger"></span>
                <small class="form-text">The last digit in the code becomes the first number in that branch's order references, e.g. BR001 uses 1.</small>
            </div>

            <div class="form-group">
                <label asp-for="BranchName">Branch Name <span class="required">*</span></label>
                <input asp-for="BranchName" class="form-control" placeholder="e.g., Main Branch, Downtown Location" />
                <span asp-validation-for="BranchName" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="IsActive">Status</label>
                <div class="checkbox-wrapper">
                    <input type="checkbox" asp-for="IsActive" checked />
                    <label for="IsActive">Branch is active and accepting orders</label>
                </div>
            </div>
        </div>

        <div class="form-section">
            <h3>Contact Information</h3>
            
            <div class="form-group">
                <label asp-for="Address">Address</label>
                <input asp-for="Address" class="form-control" placeholder="Street address, city, province" />
                <span asp-validation-for="Address" class="text-danger"></span>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label asp-for="Phone">Phone Number</label>
                    <input asp-for="Phone" class="form-control" placeholder="+63 XX XXX XXXX" />
                    <span asp-validation-for="Phone" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Email">Email Address</label>
                    <input asp-for="Email" type="email" class="form-control" placeholder="branch&#64;example.com" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
            </div>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn-submit">
                <i class="bi bi-check-circle"></i> Create Branch
            </button>
            <a asp-action="Index" class="btn-cancel">Cancel</a>
        </div>
    </form>
</div>

@section Styles {
    <style>
        .branch-form-container {
            padding: 0;
            max-width: 700px;
        }

        .form-header {
            margin-bottom: 24px;
        }

        .back-link {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            color: #e67e22;
            text-decoration: none;
            font-weight: 600;
            margin-bottom: 12px;
            transition: color 0.3s;
        }

        .back-link:hover {
            color: #d35400;
        }

        .form-header h1 {
            margin: 0;
            font-size: 1.5em;
            color: #d35400;
        }

        .branch-form {
            background: #fff;
            padding: 32px;
            border-radius: 12px;
            box-shadow: 0 2px 6px rgba(0, 0, 0, 0.05);
            border: 2px solid #f0d7bf;
        }

        .form-section {
            margin-bottom: 32px;
        }

        .form-section h3 {
            margin: 0 0 20px 0;
            padding-bottom: 12px;
            border-bottom: 2px solid #f0d7bf;
            color: #d35400;
            font-size: 1.2em;
        }

        .form-group {
            margin-bottom: 20px;
        }

        .form-group label {
            display: block;
            margin-bottom: 8px;
            font-weight: 600;
            color: #555;
        }

        .required {
            color: #e74c3c;
        }

        .form-control {
            width: 100%;
            padding: 12px 15px;
            border: 2px solid #f0d7bf;
            border-radius: 10px;
            font-size: 1em;
            transition: border-color 0.3s, box-shadow 0.3s;
            box-sizing: border-box;
            background: #fffaf5;
        }

        .form-control:focus {
            outline: none;
            border-color: #e67e22;
            box-shadow: 0 0 6px rgba(230, 126, 34, 0.3);
        }

        .form-text {
            display: block;
            margin-top: 6px;
            color: #666;
            font-size: 0.85em;
        }

        .form-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 16px;
        }

        .checkbox-wrapper {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .checkbox-wrapper input[type="checkbox"] {
            width: 20px;
            height: 20px;
            cursor: pointer;
        }

        .checkbox-wrapper label {
            margin: 0;
            font-weight: normal;
            cursor: pointer;
        }

        .form-actions {
            display: flex;
            gap: 12px;
            padding-top: 20px;
            border-top: 2px solid #f0d7bf;
        }

        .btn-submit {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 12px 25px;
            background-color: #e67e22;
            color: white;
            border: none;
            border-radius: 10px;
            font-weight: 600;
            font-size: 1em;
            cursor: pointer;
            transition: background-color 0.3s, transform 0.2s;
            box-shadow: 0 4px 10px rgba(230, 126, 34, 0.2);
        }

        .btn-submit:hover {
            background-color: #d35400;
            transform: translateY(-2px);
            box-shadow: 0 4px 15px rgba(211, 84, 0, 0.3);
        }

        .btn-cancel {
            display: inline-flex;
            align-items: center;
            padding: 12px 25px;
            background-color: #95a5a6;
            color: white;
            text-decoration: none;
            border-radius: 10px;
            font-weight: 600;
            border: none;
            transition: background-color 0.3s;
        }

        .btn-cancel:hover {
            background-color: #7f8c8d;
        }

        .text-danger {
            color: #e74c3c;
            font-size: 0.85rem;
            margin-top: 4px;
            display: block;
        }

        @@media (max-width: 600px) {
            .form-row {
                grid-template-columns: 1fr;
            }
        }
    </style>
}

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
