@model IEnumerable<SelfOrderingSystemKiosk.Areas.Admin.Models.Branch>
@using SelfOrderingSystemKiosk.Services
@{
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    var branches = Model?.ToList() ?? new List<SelfOrderingSystemKiosk.Areas.Admin.Models.Branch>();
    var referenceDigitCounts = branches
        .Select(BranchService.GetEffectiveReferenceDigit)
        .Where(d => d.HasValue)
        .GroupBy(d => d!.Value)
        .ToDictionary(g => g.Key, g => g.Count());
}

<div class="branches-container">
    <div class="page-header">
        <h1>Branch Management</h1>
        <a asp-action="Create" class="btn-primary">
            <i class="bi bi-plus-circle"></i> Add Branch
        </a>
    </div>

    @if (!string.IsNullOrEmpty(ViewBag.Message))
    {
        <div class="alert alert-success">@ViewBag.Message</div>
    }

    @if (!branches.Any())
    {
        <div class="empty-state">
            <i class="bi bi-shop" style="font-size: 3rem; color: #ccc;"></i>
            <h3>No branches yet</h3>
            <p>Get started by adding your first branch location.</p>
            <a asp-action="Create" class="btn-primary">Add Your First Branch</a>
        </div>
    }
    else
    {
        <div class="branches-grid">
            @foreach (var branch in branches)
            {
                var referenceDigit = BranchService.GetEffectiveReferenceDigit(branch);
                var hasReferenceConflict = referenceDigit.HasValue
                    && referenceDigitCounts.TryGetValue(referenceDigit.Value, out var referenceCount)
                    && referenceCount > 1;
                var hasInvalidBranchCode = !branch.BranchCode.Any(char.IsDigit);
                <div class="branch-card @(branch.IsActive ? "" : "branch-inactive")">
                    <div class="branch-card-header">
                        <div>
                            <h3>@branch.BranchName</h3>
                            <span class="branch-code">@branch.BranchCode</span>
                            @if (referenceDigit.HasValue)
                            {
                                <span class="reference-digit">Ref @($"{referenceDigit.Value}xxxxx")</span>
                            }
                            @if (hasInvalidBranchCode || hasReferenceConflict)
                            {
                                <span class="reference-warning">Fix reference digit</span>
                            }
                        </div>
                        <span class="status-badge @(branch.IsActive ? "status-active" : "status-inactive")">
                            @(branch.IsActive ? "Active" : "Inactive")
                        </span>
                    </div>
                    <div class="branch-card-body">
                        @if (!string.IsNullOrEmpty(branch.Address))
                        {
                            <p class="branch-detail">
                                <i class="bi bi-geo-alt"></i> @branch.Address
                            </p>
                        }
                        @if (!string.IsNullOrEmpty(branch.Phone))
                        {
                            <p class="branch-detail">
                                <i class="bi bi-telephone"></i> @branch.Phone
                            </p>
                        }
                        @if (!string.IsNullOrEmpty(branch.Email))
                        {
                            <p class="branch-detail">
                                <i class="bi bi-envelope"></i> @branch.Email
                            </p>
                        }
                    </div>
                    <div class="branch-card-footer">
                        <a asp-action="Overview" asp-route-branchId="@branch.Id" class="btn-secondary btn-sm">
                            <i class="bi bi-graph-up"></i> Overview
                        </a>
                        <a asp-action="Edit" asp-route-id="@branch.Id" class="btn-secondary btn-sm">
                            <i class="bi bi-pencil"></i> Edit
                        </a>
                        <form asp-action="ToggleStatus" asp-route-id="@branch.Id" method="post" style="display: inline;">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn-secondary btn-sm" style="background: @(branch.IsActive ? "#f39c12" : "#27ae60"); border: none; color: white; padding: 6px 12px; border-radius: 6px; cursor: pointer;">
                                <i class="bi bi-toggle-@((branch.IsActive ? "on" : "off"))"></i> @(branch.IsActive ? "Deactivate" : "Activate")
                            </button>
                        </form>
                        <form asp-action="Delete" asp-route-id="@branch.Id" method="post" style="display: inline;">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn-danger btn-sm" onclick="return confirm('Are you sure you want to delete branch \'@branch.BranchName\'? This cannot be undone.');">
                                <i class="bi bi-trash"></i> Delete
                            </button>
                        </form>
                    </div>
                </div>
            }
        </div>
    }

    <div class="branch-overview-link" style="margin-top: 24px; padding: 16px; background: #fff6e5; border: 2px solid #f0d7bf; border-radius: 12px; color: #555;">
        <div style="display: flex; justify-content: space-between; align-items: center;">
            <div>
                <h3 style="margin: 0 0 8px 0; color: #d35400;"><i class="bi bi-graph-up-arrow"></i> Multi-Branch Overview</h3>
                <p style="margin: 0; color: #666;">View consolidated statistics and performance metrics across all branches.</p>
            </div>
            <a asp-action="Overview" class="btn-primary" style="text-decoration: none; font-weight: 600;">
                View Overview <i class="bi bi-arrow-right"></i>
            </a>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .branches-container {
            padding: 0;
        }

        .page-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 24px;
        }

        .page-header h1 {
            margin: 0;
            font-size: 1.5em;
            color: #d35400;
        }

        .btn-primary {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 12px 25px;
            background-color: #e67e22;
            color: white;
            text-decoration: none;
            border-radius: 10px;
            font-weight: 600;
            border: none;
            cursor: pointer;
            transition: background-color 0.3s, transform 0.2s;
            box-shadow: 0 4px 10px rgba(230, 126, 34, 0.2);
        }

        .btn-primary:hover {
            background-color: #d35400;
            transform: translateY(-2px);
            box-shadow: 0 4px 15px rgba(211, 84, 0, 0.3);
        }

        .btn-secondary {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 6px 12px;
            background: #fffaf5;
            color: #555;
            text-decoration: none;
            border-radius: 6px;
            font-weight: 500;
            border: 1px solid #f0d7bf;
            cursor: pointer;
            transition: all 0.3s;
        }

        .btn-secondary:hover {
            background: #fff3e6;
            border-color: #f7b267;
        }

        .btn-danger {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 6px 12px;
            background: #fee;
            color: #c0392b;
            text-decoration: none;
            border-radius: 6px;
            font-weight: 500;
            border: 1px solid #f5c6cb;
            cursor: pointer;
            transition: all 0.2s;
        }

        .btn-danger:hover {
            background: #f8d7da;
            border-color: #f1aeb5;
        }

        .btn-sm {
            font-size: 0.85rem;
            padding: 6px 10px;
        }

        .branches-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
            gap: 20px;
            margin-bottom: 24px;
        }

        .branch-card {
            background: #fff;
            border-radius: 12px;
            box-shadow: 0 2px 6px rgba(0, 0, 0, 0.05);
            overflow: hidden;
            transition: transform 0.3s, box-shadow 0.3s;
            border: 2px solid #f0d7bf;
        }

        .branch-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 8px 24px rgba(230, 126, 34, 0.15);
        }

        .branch-card.branch-inactive {
            opacity: 0.75;
            border-color: #e0e0e0;
        }

        .branch-card-header {
            padding: 16px;
            background: #fff3e6;
            color: #555;
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
        }

        .branch-card-header h3 {
            margin: 0 0 4px 0;
            font-size: 1.2em;
            color: #d35400;
        }

        .branch-code {
            font-size: 0.85rem;
            color: #e67e22;
            font-family: monospace;
        }

        .reference-digit {
            display: inline-flex;
            margin-left: 8px;
            padding: 2px 8px;
            border-radius: 999px;
            background: #eef7ff;
            color: #21618c;
            font-size: 0.78rem;
            font-weight: 600;
        }

        .reference-warning {
            display: block;
            margin-top: 6px;
            color: #c0392b;
            font-size: 0.78rem;
            font-weight: 700;
        }

        .status-badge {
            padding: 4px 10px;
            border-radius: 20px;
            font-size: 0.75rem;
            font-weight: 600;
            text-transform: uppercase;
        }

        .status-active {
            background: rgba(39, 174, 96, 0.2);
            color: #27ae60;
        }

        .status-inactive {
            background: rgba(149, 165, 166, 0.2);
            color: #95a5a6;
        }

        .branch-card-body {
            padding: 16px;
        }

        .branch-detail {
            margin: 8px 0;
            color: #555;
            font-size: 0.9rem;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .branch-detail i {
            color: #e67e22;
            width: 18px;
        }

        .branch-card-footer {
            padding: 12px 16px;
            background: #fffaf5;
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
        }

        .empty-state {
            text-align: center;
            padding: 60px 20px;
            background: #fff;
            border-radius: 12px;
            box-shadow: 0 2px 6px rgba(0, 0, 0, 0.05);
            border: 2px solid #f0d7bf;
        }

        .empty-state h3 {
            margin: 16px 0 8px;
            color: #d35400;
        }

        .empty-state p {
            color: #7f8c8d;
            margin-bottom: 24px;
        }

        .alert {
            padding: 12px 16px;
            border-radius: 8px;
            margin-bottom: 20px;
        }

        .alert-success {
            background: #d4edda;
            color: #155724;
            border: 1px solid #c3e6cb;
        }
    </style>
}
