@model IEnumerable<SelfOrderingSystemKiosk.Models.MenuItem>
@using SelfOrderingSystemKiosk.Models
@using SelfOrderingSystemKiosk.Services
@inject KpItemsImageResolver KpImages
@{
    ViewData["Title"] = "Menu (foods)";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    var menuCats = ViewBag.MenuCategories as IEnumerable<MenuCategoryOption>;
    var menuFormCats = ViewBag.MenuCategoryFormList as IEnumerable<MenuCategoryOption>;
    var catFilter = ViewBag.CategoryFilter as string ?? "all";
    var ingredientsForRecipe = ViewBag.Ingredients as IEnumerable<IngredientItem> ?? Array.Empty<IngredientItem>();
}

<div class="header" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 15px; margin-bottom: 20px;">
        <div>
            <p style="margin-top: 0;">Sellable dishes shown on the kiosk (stored in <strong>MenuItems</strong>). Ingredients are under <a asp-area="Admin" asp-controller="Inventory" asp-action="Index">Ingredients</a>.</p>
            <p style="color: #666; font-size: 0.9em; margin-top: 5px;">
                <i class="bi bi-info-circle"></i> Kiosk tab = Wings / Appetizer / Add-Ons. <strong>Recipe</strong> links each dish to ingredients: when the kitchen marks an order completed, those ingredient amounts are deducted (qty per <em>one</em> sold × line quantity in the order).
            </p>
        </div>
        <div style="display: flex; gap: 10px; flex-wrap: wrap;">
            <button type="button" class="btn btn-add" onclick="openAddModal()" style="padding: 12px 25px; font-size: 1rem;">
                <i class="bi bi-plus-circle"></i> Add New Item
            </button>
        </div>
    </div>

    @if (ViewBag.Message != null)
    {
        <div class="alert alert-success">@ViewBag.Message</div>
    }

    <form method="get" asp-area="Admin" asp-controller="Menu" asp-action="Index" style="margin-bottom: 18px; display: flex; align-items: center; gap: 12px; flex-wrap: wrap;">
        <label for="categoryFilter" style="font-weight: 600; margin: 0;">Kiosk tab</label>
        <select name="categoryFilter" id="categoryFilter" onchange="this.form.submit()" style="padding: 8px 12px; min-width: 220px; border: 2px solid #ddd; border-radius: 5px;">
            @if (catFilter == "all")
            {
                <option value="all" selected>All categories</option>
            }
            else
            {
                <option value="all">All categories</option>
            }
            @if (menuCats != null)
            {
                foreach (var c in menuCats)
                {
                    if (catFilter == c.Key)
                    {
                        <option value="@c.Key" selected>@c.DisplayName</option>
                    }
                    else
                    {
                        <option value="@c.Key">@c.DisplayName</option>
                    }
                }
            }
        </select>
    </form>

    <div class="table-container">
        @if (Model != null && Model.Any())
        {
            <table>
                <thead>
                    <tr>
                        <th>Menu Item</th>
                        <th>Kiosk tab</th>
                        <th>Food type</th>
                        <th>Price (₱)</th>
                        <th>Stock</th>
                        <th>Status</th>
                        <th>Availability</th>
                        <th>Recipe</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var i in Model)
                    {
                        var (menuLabel, thumbSrc) = KpImages.ResolveForMenu(i.Item, i.Image);
                        <tr>
                            <td>
                                <div style="display: flex; align-items: center; gap: 10px;">
                                    @if (!string.IsNullOrEmpty(thumbSrc))
                                    {
                                        <img src="@Url.Content(thumbSrc)" alt="@menuLabel" style="width: 40px; height: 40px; object-fit: cover; border-radius: 5px;" />
                                    }
                                    <strong>@menuLabel</strong>
                                </div>
                            </td>
                            <td>@i.Category</td>
                            <td>@(i.FoodCategory ?? "—")</td>
                            <td>₱@i.Price.ToString("0.00")</td>
                            <td>
                                <span class="@(i.CurrentStock <= i.ReorderLevel ? "text-danger" : "text-success")">
                                    @i.CurrentStock @i.Unit
                                </span>
                                @if (i.CurrentStock <= i.ReorderLevel)
                                {
                                    <br /><small style="color: #dc3545;">Reorder: @i.ReorderLevel</small>
                                }
                            </td>
                            <td>
                                <span class="status @(i.Status?.ToLower().Replace(" ", "-") ?? "in-stock")">@i.Status</span>
                            </td>
                            <td>
                                <label class="availability-toggle" style="cursor: pointer; display: inline-flex; align-items: center; gap: 8px;">
                                    <input type="checkbox" 
                                           class="availability-switch" 
                                           data-id="@i.Id"
                                           @(i.Availability == "Available" ? "checked" : "")
                                           onchange="toggleAvailability('@i.Id', this.checked)" />
                                    <span class="toggle-slider"></span>
                                    <span class="availability-label" id="label-@i.Id">
                                        @i.Availability
                                    </span>
                                </label>
                            </td>
                            <td style="font-size:0.9em;">@(i.Recipe?.Count ?? 0) ingredient(s)</td>
                            <td>
                                <div class="action-buttons">
                                    <button type="button"
                                            class="btn btn-edit edit-item-btn"
                                            data-id="@i.Id"
                                            data-name="@menuLabel"
                                            data-category="@i.Category"
                                            data-price="@i.Price"
                                            data-image="@thumbSrc">
                                        Edit
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <p>No menu items found.</p>
        }
    </div>

<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">

<script>
    const RECIPE_JSON_URL = '@Url.Action("RecipeJson", "Menu", new { area = "Admin" })';
    const INGREDIENT_OPTIONS = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
        ingredientsForRecipe.Select(x => new { id = x.Id, name = x.Item })));
</script>

<style>
    /* Availability Toggle Switch */
    .availability-toggle {
        position: relative;
        display: inline-flex;
        align-items: center;
        gap: 10px;
    }

    .availability-switch {
        position: relative;
        width: 50px;
        height: 26px;
        appearance: none;
        background: #ccc;
        border-radius: 13px;
        outline: none;
        cursor: pointer;
        transition: background 0.3s;
        margin: 0;
    }

    .availability-switch:checked {
        background: #28a745;
    }

    .availability-switch:not(:checked) {
        background: #dc3545;
    }

    .toggle-slider {
        position: absolute;
        top: 3px;
        left: 3px;
        width: 20px;
        height: 20px;
        background: white;
        border-radius: 50%;
        transition: transform 0.3s;
        pointer-events: none;
    }

    .availability-switch:checked ~ .toggle-slider {
        transform: translateX(24px);
    }

    .availability-label {
        font-weight: 600;
        font-size: 0.9rem;
        min-width: 90px;
    }

    .availability-label.available {
        color: #28a745;
    }

    .availability-label.unavailable {
        color: #dc3545;
    }

    /* Modal Styles */
    .modal-overlay {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.5);
        z-index: 10000;
        justify-content: center;
        align-items: center;
    }

    .modal-overlay.active {
        display: flex;
    }

    .modal-content {
        background: white;
        padding: 30px;
        border-radius: 15px;
        max-width: 600px;
        width: 90%;
        max-height: 90vh;
        overflow-y: auto;
        box-shadow: 0 10px 40px rgba(0,0,0,0.3);
        position: relative;
    }

    .modal-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 25px;
        padding-bottom: 15px;
        border-bottom: 2px solid #eee;
    }

    .modal-header h2 {
        margin: 0;
        color: #333;
    }

    .close-modal {
        background: none;
        border: none;
        font-size: 2rem;
        cursor: pointer;
        color: #999;
        padding: 0;
        width: 35px;
        height: 35px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        transition: all 0.3s;
    }

    .close-modal:hover {
        background: #f0f0f0;
        color: #333;
    }

    .modal-form {
        display: grid;
        gap: 15px;
    }

    .form-group {
        display: flex;
        flex-direction: column;
    }

    .form-group label {
        margin-bottom: 5px;
        font-weight: 600;
        color: #555;
    }

    .form-group input,
    .form-group select {
        padding: 10px;
        border: 2px solid #ddd;
        border-radius: 5px;
        font-size: 1rem;
        transition: border-color 0.3s;
    }

    .form-group input:focus,
    .form-group select:focus {
        outline: none;
        border-color: #ff6b35;
    }

    .form-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 15px;
    }

    .modal-actions {
        display: flex;
        gap: 10px;
        justify-content: flex-end;
        margin-top: 20px;
        padding-top: 20px;
        border-top: 2px solid #eee;
    }

    .btn-cancel {
        padding: 10px 20px;
        background: #6c757d;
        color: white;
        border: none;
        border-radius: 5px;
        cursor: pointer;
        font-size: 1rem;
    }

    .btn-cancel:hover {
        background: #5a6268;
    }
</style>

<script>
    function toggleAvailability(itemId, isAvailable) {
        const availability = isAvailable ? 'Available' : 'Unavailable';
        const label = document.getElementById('label-' + itemId);
        
        // Optimistic label until server responds (reload on success)
        label.textContent = availability;
        label.className = 'availability-label ' + availability.toLowerCase();
        
        fetch('/Admin/Menu/ToggleAvailability', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
            },
            body: 'id=' + encodeURIComponent(itemId) + '&availability=' + encodeURIComponent(availability)
        })
        .then(response => {
            if (response.ok) {
                // Full reload so list order matches server (unavailable rows at bottom)
                window.location.reload();
            } else {
                // Revert on error
                const checkbox = document.querySelector(`[data-id="${itemId}"]`);
                checkbox.checked = !isAvailable;
                label.textContent = isAvailable ? 'Unavailable' : 'Available';
                label.className = 'availability-label ' + (isAvailable ? 'unavailable' : 'available');
                
                alert('Failed to update availability. Please try again.');
            }
        })
        .catch(error => {
            console.error('Error:', error);
            // Revert on error
            const checkbox = document.querySelector(`[data-id="${itemId}"]`);
            checkbox.checked = !isAvailable;
            label.textContent = isAvailable ? 'Unavailable' : 'Available';
            label.className = 'availability-label ' + (isAvailable ? 'unavailable' : 'available');
            
            alert('An error occurred. Please try again.');
        });
    }

    function clearRecipeContainer(containerId) {
        const el = document.getElementById(containerId);
        if (el) el.innerHTML = '';
    }

    function addRecipeRow(containerId, ingredientId = '', qty = '') {
        const container = document.getElementById(containerId);
        if (!container) return;
        const row = document.createElement('div');
        row.className = 'recipe-row';
        row.style.cssText = 'display:flex; gap:8px; margin-bottom:8px; align-items:center; flex-wrap:wrap;';

        const sel = document.createElement('select');
        sel.name = 'recipeIngredientId';
        sel.style.cssText = 'flex:2; min-width:140px; padding:10px; border:2px solid #ddd; border-radius:5px;';
        const opt0 = document.createElement('option');
        opt0.value = '';
        opt0.textContent = '— Ingredient —';
        sel.appendChild(opt0);
        (INGREDIENT_OPTIONS || []).forEach(o => {
            const opt = document.createElement('option');
            opt.value = o.id;
            opt.textContent = o.name;
            if (o.id === ingredientId) opt.selected = true;
            sel.appendChild(opt);
        });

        const inp = document.createElement('input');
        inp.type = 'number';
        inp.name = 'recipeQtyPerUnit';
        inp.min = '0';
        inp.value = (qty === '' || qty === null || qty === undefined) ? '0' : String(qty);
        inp.placeholder = 'Qty / 1 sold';
        inp.title = 'Amount in ingredient unit (g, ml, pcs) per one menu item';
        inp.style.cssText = 'width:120px; padding:10px; border:2px solid #ddd; border-radius:5px;';

        const btn = document.createElement('button');
        btn.type = 'button';
        btn.textContent = '×';
        btn.style.cssText = 'padding:8px 12px; background:#dc3545; color:white; border:none; border-radius:5px; cursor:pointer;';
        btn.addEventListener('click', () => row.remove());

        row.appendChild(sel);
        row.appendChild(inp);
        row.appendChild(btn);
        container.appendChild(row);
    }

    async function loadRecipeForEdit(menuItemId) {
        const container = document.getElementById('recipeLinesEdit');
        if (!container || !menuItemId) return;
        container.innerHTML = '';
        try {
            const r = await fetch(RECIPE_JSON_URL + '?id=' + encodeURIComponent(menuItemId));
            const recipe = await r.json();
            if (recipe && recipe.length > 0) {
                recipe.forEach(line => addRecipeRow('recipeLinesEdit', line.ingredientId, line.quantityPerUnit));
            } else {
                addRecipeRow('recipeLinesEdit');
            }
        } catch (e) {
            console.error(e);
            addRecipeRow('recipeLinesEdit');
        }
    }

    // Modal Functions
    function openAddModal() {
        document.getElementById('addItemModal').classList.add('active');
        document.getElementById('addItemForm').reset();
        clearRecipeContainer('recipeLinesAdd');
        addRecipeRow('recipeLinesAdd');
    }

    function closeAddModal() {
        document.getElementById('addItemModal').classList.remove('active');
        document.getElementById('addItemForm').reset();
        clearImagePreview('addImageFile', 'addImagePreview');
        clearRecipeContainer('recipeLinesAdd');
    }

    // Close modal when clicking outside
    function setupAddModal() {
        const addModal = document.getElementById('addItemModal');
        if (addModal) {
            addModal.addEventListener('click', function(e) {
                if (e.target === this) {
                    closeAddModal();
                }
            });
        }
    }

    // Close modal on ESC key
    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') {
            closeAddModal();
            closeEditModal();
        }
    });

    // Image Preview Functions
    function previewImage(input, previewContainerId) {
        const previewContainer = document.getElementById(previewContainerId);
        const previewImg = document.getElementById(previewContainerId + 'Img');
        
        if (input.files && input.files[0]) {
            const reader = new FileReader();
            reader.onload = function(e) {
                previewImg.src = e.target.result;
                previewContainer.style.display = 'block';
            };
            reader.readAsDataURL(input.files[0]);
        }
    }
    
    function clearImagePreview(inputId, previewContainerId) {
        const input = document.getElementById(inputId);
        const previewContainer = document.getElementById(previewContainerId);
        if (input) input.value = '';
        if (previewContainer) previewContainer.style.display = 'none';
    }

    // Edit Modal Functions
    function openEditModal(id, name, category, price, image) {
        try {
            const modal = document.getElementById('editItemModal');
            if (!modal) {
                console.error('Edit modal not found');
                return;
            }
            
            modal.classList.add('active');
            
            const idField = document.getElementById('editItemId');
            const nameField = document.getElementById('editItemName');
            const categoryField = document.getElementById('editCategory');
            const priceField = document.getElementById('editPrice');
            const imageField = document.getElementById('editItemImage');
            const currentImageImg = document.getElementById('editCurrentImageImg');
            
            if (idField) idField.value = id || '';
            if (nameField) nameField.value = name || '';
            if (categoryField) categoryField.value = category || 'Wings';
            if (priceField) priceField.value = price || '0';
            if (imageField) imageField.value = image || '';
            
            // Show current image if exists
            if (image && currentImageImg) {
                currentImageImg.src = image;
                currentImageImg.style.display = 'block';
            } else if (currentImageImg) {
                currentImageImg.style.display = 'none';
            }
            
            // Clear any preview
            clearImagePreview('editImageFile', 'editImagePreview');

            if (idField && idField.value)
                loadRecipeForEdit(idField.value);
        } catch (error) {
            console.error('Error opening edit modal:', error);
            alert('Error opening edit form. Please refresh the page and try again.');
        }
    }

    // Use event delegation for edit buttons (works even if buttons are added dynamically)
    document.addEventListener('click', function(e) {
        // Check if clicked element or its parent has the edit-item-btn class
        const button = e.target.closest('.edit-item-btn');
        if (button) {
            e.preventDefault();
            e.stopPropagation();
            console.log('Edit button clicked:', button);
            const id = button.getAttribute('data-id');
            const name = button.getAttribute('data-name');
            console.log('Opening edit modal for:', id, name);
            openEditModal(
                id,
                name,
                button.getAttribute('data-category'),
                button.getAttribute('data-price'),
                button.getAttribute('data-image')
            );
        }
    });

    function closeEditModal() {
        const modal = document.getElementById('editItemModal');
        if (modal) {
            modal.classList.remove('active');
            const form = document.getElementById('editItemForm');
            if (form) {
                form.reset();
            }
            clearImagePreview('editImageFile', 'editImagePreview');
            clearRecipeContainer('recipeLinesEdit');
        }
    }

    // Set up edit modal click outside handler when DOM is ready
    function setupEditModal() {
        const editModal = document.getElementById('editItemModal');
        if (editModal) {
            editModal.addEventListener('click', function(e) {
                if (e.target === this) {
                    closeEditModal();
                }
            });
        }
    }

    // Initialize when DOM is ready
    function initializeModals() {
        setupAddModal();
        setupEditModal();
        
        // Setup form submission handlers
        const addForm = document.getElementById('addItemForm');
        if (addForm) {
            addForm.addEventListener('submit', function() {
                setTimeout(function() {
                    closeAddModal();
                }, 100);
            });
        }
        
        const editForm = document.getElementById('editItemForm');
        if (editForm) {
            editForm.addEventListener('submit', function() {
                setTimeout(function() {
                    closeEditModal();
                }, 100);
            });
        }
    }
    
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initializeModals);
    } else {
        initializeModals();
    }
</script>

<!-- Add Item Modal -->
<div class="modal-overlay" id="addItemModal">
    <div class="modal-content">
        <div class="modal-header">
            <h2><i class="bi bi-plus-circle"></i> Add New Menu Item</h2>
            <button type="button" class="close-modal" onclick="closeAddModal()">&times;</button>
        </div>
        <form method="post" asp-action="Add" id="addItemForm" class="modal-form" enctype="multipart/form-data">
            <div class="form-group">
                <label>Menu Item Name *</label>
                <input type="text" name="name" placeholder="e.g., Buffalo Wings" required />
            </div>
            
            <div class="form-group">
                <label>Item Picture (Optional)</label>
                <input type="file" name="imageFile" id="addImageFile" accept="image/*" onchange="previewImage(this, 'addImagePreview')" />
                <div id="addImagePreview" class="image-preview" style="margin-top: 10px; display: none;">
                    <img id="addImagePreviewImg" src="" alt="Preview" style="max-width: 200px; max-height: 200px; border-radius: 5px; border: 2px solid #ddd;" />
                    <button type="button" onclick="clearImagePreview('addImageFile', 'addImagePreview')" style="margin-top: 5px; padding: 5px 10px; background: #dc3545; color: white; border: none; border-radius: 3px; cursor: pointer;">Remove</button>
                </div>
            </div>
            
            <div class="form-row">
                <div class="form-group">
                    <label>Kiosk tab *</label>
                    <select name="category" required>
                        @if (menuCats != null)
                        {
                            foreach (var c in menuCats)
                            {
                                <option value="@c.Key">@c.DisplayName</option>
                            }
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label>Price (₱) *</label>
                    <input type="number" step="0.01" name="price" placeholder="0.00" required min="0" />
                </div>
            </div>

            <div class="form-group" style="border-top:1px solid #eee; padding-top:16px; margin-top:8px;">
                <label style="font-weight:700; color:#d35400;">Recipe (ingredients per 1 sold)</label>
                <p style="font-size:0.85em; color:#666; margin:4px 0 10px;">When the kitchen completes an order: <code>quantityPerUnit × order qty</code> per ingredient. New items start at 0 stock; use the table availability toggle to show on the kiosk after restocking.</p>
                <div id="recipeLinesAdd"></div>
                <button type="button" class="btn-cancel" style="margin-top:6px;" onclick="addRecipeRow('recipeLinesAdd')">+ Add ingredient line</button>
            </div>
            
            <div class="modal-actions">
                <button type="button" class="btn-cancel" onclick="closeAddModal()">Cancel</button>
                <button type="submit" class="btn btn-edit" onclick="document.getElementById('addItemForm').onsubmit = function() { setTimeout(closeAddModal, 100); }">Add Item</button>
            </div>
        </form>
    </div>
</div>


<!-- Edit Item Modal -->
<div class="modal-overlay" id="editItemModal">
    <div class="modal-content">
        <div class="modal-header">
            <h2><i class="bi bi-pencil-square"></i> Edit Menu Item</h2>
            <button type="button" class="close-modal" onclick="closeEditModal()">&times;</button>
        </div>
        <form method="post" asp-action="Edit" id="editItemForm" class="modal-form" enctype="multipart/form-data">
            <input type="hidden" name="Id" id="editItemId" />
            <input type="hidden" name="Image" id="editItemImage" value="" />
            
            <div class="form-group">
                <label>Menu Item Name *</label>
                <input type="text" name="Item" id="editItemName" placeholder="e.g., Buffalo Wings" required />
            </div>
            
            <div class="form-group">
                <label>Item Picture (Optional)</label>
                <div id="editCurrentImage" class="current-image" style="margin-bottom: 10px;">
                    <img id="editCurrentImageImg" src="" alt="Current image" style="max-width: 200px; max-height: 200px; border-radius: 5px; border: 2px solid #ddd; display: none;" />
                </div>
                <input type="file" name="imageFile" id="editImageFile" accept="image/*" onchange="previewImage(this, 'editImagePreview')" />
                <div id="editImagePreview" class="image-preview" style="margin-top: 10px; display: none;">
                    <img id="editImagePreviewImg" src="" alt="Preview" style="max-width: 200px; max-height: 200px; border-radius: 5px; border: 2px solid #ddd;" />
                    <button type="button" onclick="clearImagePreview('editImageFile', 'editImagePreview')" style="margin-top: 5px; padding: 5px 10px; background: #dc3545; color: white; border: none; border-radius: 3px; cursor: pointer;">Remove</button>
                </div>
            </div>
            
            <div class="form-row">
                <div class="form-group">
                    <label>Kiosk tab *</label>
                    <select name="Category" id="editCategory" required>
                        @if (menuFormCats != null)
                        {
                            foreach (var c in menuFormCats)
                            {
                                <option value="@c.Key">@c.DisplayName</option>
                            }
                        }
                        else if (menuCats != null)
                        {
                            foreach (var c in menuCats)
                            {
                                <option value="@c.Key">@c.DisplayName</option>
                            }
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label>Price (₱) *</label>
                    <input type="number" step="0.01" name="Price" id="editPrice" placeholder="0.00" required min="0" />
                </div>
            </div>

            <div class="form-group" style="border-top:1px solid #eee; padding-top:16px; margin-top:8px;">
                <label style="font-weight:700; color:#d35400;">Recipe (ingredients per 1 sold)</label>
                <p style="font-size:0.85em; color:#666; margin:4px 0 10px;">Stock, unit, reorder, and kiosk availability stay unchanged here; edit them from the dashboard restock or the table toggle.</p>
                <div id="recipeLinesEdit"></div>
                <button type="button" class="btn-cancel" style="margin-top:6px;" onclick="addRecipeRow('recipeLinesEdit')">+ Add ingredient line</button>
            </div>
            
            <div class="modal-actions">
                <button type="button" class="btn-cancel" onclick="closeEditModal()">Cancel</button>
                <button type="submit" class="btn btn-edit">Save Changes</button>
            </div>
        </form>
    </div>
</div>

