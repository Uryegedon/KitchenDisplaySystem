@model SelfOrderingSystemKiosk.Controllers.ChangePasswordViewModel
@{
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="password-form-container">
    <div class="form-header">
        <a asp-action="Index" class="back-link">
            <i class="bi bi-arrow-left"></i> Back to Users
        </a>
        <h1>Change Password</h1>
    </div>

    <div class="user-info-box">
        <div class="user-info-item">
            <strong>Username:</strong> @ViewBag.Username
        </div>
        <div class="user-info-item">
            <strong>Full Name:</strong> @ViewBag.FullName
        </div>
    </div>

    <form asp-action="ChangePassword" method="post" class="password-form">
        @Html.AntiForgeryToken()
        <input type="hidden" name="UserId" value="@Model.UserId" />

        <div class="form-section">
            <h3>New Password</h3>

            <div class="form-group">
                <label for="NewPassword">New Password <span class="required">*</span></label>
                <input type="password" id="NewPassword" name="NewPassword" class="form-control" placeholder="Minimum 10 characters" required minlength="10" />
                <span asp-validation-for="NewPassword" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label for="ConfirmPassword">Confirm Password <span class="required">*</span></label>
                <input type="password" id="ConfirmPassword" name="ConfirmPassword" class="form-control" placeholder="Re-enter the new password" required minlength="10" />
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>
        </div>

        <div class="warning-box">
            <i class="bi bi-exclamation-triangle"></i>
            <div>
                <strong>Warning:</strong> This will immediately change the user's password. The user will need to use the new password for their next login.
            </div>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn-submit">
                <i class="bi bi-check-circle"></i> Change Password
            </button>
            <a asp-action="Index" class="btn-cancel">Cancel</a>
        </div>
    </form>
</div>

@section Styles {
    <style>
        .password-form-container {
            padding: 0;
            max-width: 600px;
        }

        .form-header {
            margin-bottom: 24px;
        }

        .back-link {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            color: #e67e22;
            text-decoration: none;
            font-weight: 600;
            margin-bottom: 12px;
            transition: color 0.3s;
        }

        .back-link:hover {
            color: #d35400;
        }

        .form-header h1 {
            margin: 0;
            font-size: 1.5em;
            color: #d35400;
        }

        .user-info-box {
            background: #fff;
            padding: 20px;
            border-radius: 12px;
            box-shadow: 0 2px 6px rgba(0, 0, 0, 0.05);
            border: 2px solid #f0d7bf;
            margin-bottom: 24px;
        }

        .user-info-item {
            padding: 8px 0;
            color: #555;
        }

        .user-info-item strong {
            color: #d35400;
            margin-right: 8px;
        }

        .password-form {
            background: #fff;
            padding: 32px;
            border-radius: 12px;
            box-shadow: 0 2px 6px rgba(0, 0, 0, 0.05);
            border: 2px solid #f0d7bf;
        }

        .form-section {
            margin-bottom: 24px;
        }

        .form-section h3 {
            margin: 0 0 20px 0;
            padding-bottom: 12px;
            border-bottom: 2px solid #f0d7bf;
            color: #d35400;
            font-size: 1.2em;
        }

        .form-group {
            margin-bottom: 20px;
        }

        .form-group label {
            display: block;
            margin-bottom: 8px;
            font-weight: 600;
            color: #555;
        }

        .required {
            color: #e74c3c;
        }

        .form-control {
            width: 100%;
            padding: 12px 15px;
            border: 2px solid #f0d7bf;
            border-radius: 10px;
            font-size: 1em;
            transition: border-color 0.3s, box-shadow 0.3s;
            box-sizing: border-box;
            background: #fffaf5;
        }

        .form-control:focus {
            outline: none;
            border-color: #e67e22;
            box-shadow: 0 0 6px rgba(230, 126, 34, 0.3);
        }

        .form-text {
            display: block;
            margin-top: 6px;
            color: #666;
            font-size: 0.85em;
        }

        .warning-box {
            background: #fff6e5;
            padding: 16px;
            border-radius: 8px;
            margin-bottom: 24px;
            display: flex;
            align-items: flex-start;
            gap: 12px;
            color: #d35400;
            border: 1px solid #f7b267;
        }

        .warning-box i {
            font-size: 1.2em;
            flex-shrink: 0;
        }

        .warning-box strong {
            display: block;
            margin-bottom: 4px;
        }

        .form-actions {
            display: flex;
            gap: 12px;
            padding-top: 20px;
            border-top: 2px solid #f0d7bf;
        }

        .btn-submit {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 12px 25px;
            background-color: #e67e22;
            color: white;
            border: none;
            border-radius: 10px;
            font-weight: 600;
            font-size: 1em;
            cursor: pointer;
            transition: background-color 0.3s, transform 0.2s;
            box-shadow: 0 4px 10px rgba(230, 126, 34, 0.2);
        }

        .btn-submit:hover {
            background-color: #d35400;
            transform: translateY(-2px);
            box-shadow: 0 4px 15px rgba(211, 84, 0, 0.3);
        }

        .btn-cancel {
            display: inline-flex;
            align-items: center;
            padding: 12px 25px;
            background-color: #95a5a6;
            color: white;
            text-decoration: none;
            border-radius: 10px;
            font-weight: 600;
            border: none;
            transition: background-color 0.3s;
        }

        .btn-cancel:hover {
            background-color: #7f8c8d;
        }

        .text-danger {
            color: #e74c3c;
            font-size: 0.85em;
            margin-top: 4px;
            display: block;
        }
    </style>
}

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
