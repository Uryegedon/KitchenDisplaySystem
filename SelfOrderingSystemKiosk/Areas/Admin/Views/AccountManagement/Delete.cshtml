@model SelfOrderingSystemKiosk.Models.AdminUser
@{
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    var branchNames = ViewBag.BranchNames as Dictionary<string, string> ?? new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
    var branchDisplay = string.IsNullOrEmpty(Model.BranchId)
        ? "All Branches"
        : branchNames.TryGetValue(Model.BranchId, out var branchName)
            ? branchName
            : $"Unknown Branch ({Model.BranchId})";
}

<div class="user-delete-container">
    <div class="delete-card">
        <div class="delete-icon">
            <i class="bi bi-exclamation-triangle"></i>
        </div>
        <h1>Delete User Account</h1>
        <p class="delete-warning">
            This action cannot be undone. The user will lose access immediately.
        </p>

        <div class="user-info">
            <div class="user-info-header">
                <div class="user-details">
                    <h2>@Model.FullName</h2>
                    <span class="username">@@@Model.Username</span>
                </div>
            </div>
            <div class="user-meta">
                <div class="meta-item">
                    <i class="bi bi-envelope"></i>
                    <span>@(string.IsNullOrEmpty(Model.Email) ? "No email" : Model.Email)</span>
                </div>
                <div class="meta-item">
                    <i class="bi bi-shield-check"></i>
                    <span class="role-badge role-@Model.Role.ToLower()">@Model.Role</span>
                </div>
                <div class="meta-item">
                    <i class="bi bi-diagram-3"></i>
                    <span>@branchDisplay</span>
                </div>
            </div>
        </div>

        @if (Model.Role == "Owner")
        {
            <div class="owner-warning">
                <i class="bi bi-exclamation-circle"></i>
                <div>
                    <strong>Owner Account:</strong> This is an Owner account. Ensure there is at least one other Owner in the system before deleting.
                </div>
            </div>
        }

        <form asp-action="DeleteConfirmed" method="post" class="delete-form">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.Id" />

            <div class="confirmation-input">
                <label for="confirmUsername">Type the username <strong>@Model.Username</strong> to confirm:</label>
                <input type="text" id="confirmUsername" name="confirmUsername" class="form-control"
                       placeholder="Type username here..." autocomplete="off" />
            </div>

            <div class="form-actions">
                <button type="submit" id="deleteBtn" class="btn-delete" disabled>
                    <i class="bi bi-trash"></i> Yes, Delete This User
                </button>
                <a asp-action="Index" class="btn-cancel">No, Go Back</a>
            </div>
        </form>
    </div>
</div>

@section Styles {
    <style>
        .user-delete-container {
            padding: 0;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 80vh;
        }

        .delete-card {
            background: #fff;
            padding: 40px;
            border-radius: 12px;
            box-shadow: 0 2px 6px rgba(0, 0, 0, 0.05);
            border: 2px solid #f0d7bf;
            max-width: 550px;
            width: 100%;
            text-align: center;
        }

        .delete-icon {
            width: 80px;
            height: 80px;
            margin: 0 auto 20px;
            background: #fde8e8;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .delete-icon i {
            font-size: 2.5rem;
            color: #e74c3c;
        }

        .delete-card h1 {
            margin: 0 0 12px 0;
            font-size: 1.5em;
            color: #d35400;
        }

        .delete-warning {
            color: #e74c3c;
            font-weight: 600;
            margin-bottom: 24px;
        }

        .user-info {
            background: #fffaf5;
            padding: 24px;
            border-radius: 12px;
            margin-bottom: 24px;
            text-align: left;
            border: 2px solid #f0d7bf;
        }

        .user-info-header {
            display: flex;
            align-items: center;
            gap: 16px;
            margin-bottom: 20px;
            padding-bottom: 20px;
            border-bottom: 2px solid #f0d7bf;
        }

        .user-details h2 {
            margin: 0 0 4px 0;
            font-size: 1.4em;
            color: #d35400;
        }

        .username {
            font-family: monospace;
            color: #e67e22;
            font-weight: 600;
            font-size: 1em;
        }

        .user-meta {
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .meta-item {
            display: flex;
            align-items: center;
            gap: 10px;
            color: #555;
            font-size: 0.95em;
        }

        .meta-item i {
            color: #e67e22;
            width: 20px;
        }

        .role-badge {
            padding: 6px 12px;
            border-radius: 999px;
            font-size: 0.85em;
            font-weight: 600;
            text-transform: uppercase;
            display: inline-block;
        }

        .role-owner {
            background: #fff6e5;
            color: #d35400;
            border: 1px solid #f7b267;
        }

        .role-branchmanager {
            background: #e8f8f5;
            color: #27ae60;
            border: 1px solid #27ae60;
        }

        .role-kitchen {
            background: #f5f5f5;
            color: #666;
            border: 1px solid #e0e0e0;
        }

        .owner-warning {
            background: #fff6e5;
            padding: 16px;
            border-radius: 8px;
            margin-bottom: 24px;
            display: flex;
            align-items: flex-start;
            gap: 12px;
            color: #d35400;
            border: 1px solid #f7b267;
            text-align: left;
        }

        .owner-warning i {
            font-size: 1.2em;
            flex-shrink: 0;
        }

        .owner-warning strong {
            display: block;
            margin-bottom: 4px;
        }

        .confirmation-input {
            margin-bottom: 20px;
            text-align: left;
        }

        .confirmation-input label {
            display: block;
            margin-bottom: 8px;
            font-weight: 600;
            color: #555;
        }

        .form-control {
            width: 100%;
            padding: 12px 15px;
            border: 2px solid #f0d7bf;
            border-radius: 10px;
            font-size: 1em;
            transition: border-color 0.3s, box-shadow 0.3s;
            box-sizing: border-box;
            background: #fffaf5;
        }

        .form-control:focus {
            outline: none;
            border-color: #e74c3c;
            box-shadow: 0 0 6px rgba(231, 76, 60, 0.3);
        }

        .form-actions {
            display: flex;
            gap: 12px;
            justify-content: center;
        }

        .btn-delete {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 12px 25px;
            background-color: #e74c3c;
            color: white;
            border: none;
            border-radius: 10px;
            font-weight: 600;
            font-size: 1em;
            cursor: pointer;
            transition: background-color 0.3s, transform 0.2s;
            opacity: 0.5;
        }

        .btn-delete:not(:disabled) {
            opacity: 1;
        }

        .btn-delete:not(:disabled):hover {
            background-color: #c0392b;
            transform: translateY(-2px);
        }

        .btn-delete:disabled {
            cursor: not-allowed;
        }

        .btn-cancel {
            display: inline-flex;
            align-items: center;
            padding: 12px 25px;
            background-color: #95a5a6;
            color: white;
            text-decoration: none;
            border-radius: 10px;
            font-weight: 600;
            border: none;
            transition: background-color 0.3s;
        }

        .btn-cancel:hover {
            background-color: #7f8c8d;
        }
    </style>
}

@section Scripts {
    <script>
        const confirmInput = document.getElementById('confirmUsername');
        const deleteBtn = document.getElementById('deleteBtn');
        const expectedValue = '@Model.Username';

        confirmInput.addEventListener('input', function() {
            if (this.value === expectedValue) {
                deleteBtn.disabled = false;
            } else {
                deleteBtn.disabled = true;
            }
        });

        document.querySelector('.delete-form').addEventListener('submit', function(e) {
            if (confirmInput.value !== expectedValue) {
                e.preventDefault();
                alert('Please type the username exactly to confirm deletion.');
            }
        });
    </script>
}
