        <h3 id="rulesTitle"><i class="bi bi-clipboard-check-fill text-warning"></i> Rules & Regulations</h3>

        <!-- Add this container for JS -->
        <p id="rulesBody" style="margin-top:10px;">
            <!-- Dynamic message will be injected here -->
        </p>

        <!-- Optional: keep your static list if you want -->
        <ul id="rulesListEnglish" style="text-align:left; padding-left:20px;">
            <li><i class="bi bi-hourglass-split text-danger"></i> 2-hour time limit for Orders per table.</li>
