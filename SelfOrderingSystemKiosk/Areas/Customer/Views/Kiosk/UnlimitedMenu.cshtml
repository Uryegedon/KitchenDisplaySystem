@model IEnumerable<SelfOrderingSystemKiosk.Models.MenuItem>
@using System.Text.Json
@inject SelfOrderingSystemKiosk.Services.KpItemsImageResolver KpImages
@{
    Layout = "~/Areas/Customer/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Unlimited Menu";
    var allMenuItems = (Model ?? Enumerable.Empty<SelfOrderingSystemKiosk.Models.MenuItem>()).ToList();
    var rememberedPersonCount = ViewBag.PersonCount is int count && count > 0
        ? count.ToString(System.Globalization.CultureInfo.InvariantCulture)
        : "null";
    var orderingSessionKey = ViewBag.IsQrFlow == true && ViewBag.ServiceTable != null
        ? $"qr:{ViewBag.ServiceFloor ?? ""}:{ViewBag.ServiceTable}"
        : "kiosk-unlimited";
    var variantGroups = allMenuItems
        .Where(i => !string.IsNullOrWhiteSpace(i.Item)
            && !IsSulitWingRiceMeal(i)
            && (i.Item.Contains(" - ", StringComparison.Ordinal)
                || i.Item.StartsWith("Potato Thins ", StringComparison.OrdinalIgnoreCase)
                || i.Item.Equals("Plain Rice", StringComparison.OrdinalIgnoreCase)
                || i.Item.Equals("Garlic Rice", StringComparison.OrdinalIgnoreCase)))
        .GroupBy(i => i.Item.StartsWith("Potato Thins ", StringComparison.OrdinalIgnoreCase)
            ? "Potato Thins"
            : i.Item.Equals("Plain Rice", StringComparison.OrdinalIgnoreCase) || i.Item.Equals("Garlic Rice", StringComparison.OrdinalIgnoreCase)
            ? "Rice"
            : i.Item[..i.Item.IndexOf(" - ", StringComparison.Ordinal)].Trim())
        .Where(g => g.Count() > 1)
        .ToDictionary(g => g.Key, g => g.OrderByDescending(i => i.MenuOrder).ToList(), StringComparer.OrdinalIgnoreCase);
    var variantMemberNames = variantGroups.Values.SelectMany(g => g).Select(i => i.Item).ToHashSet(StringComparer.OrdinalIgnoreCase);
    var renderedVariantBases = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
    var renderedSulitMealBases = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
    var renderedUnlimitedIncludedBoard = false;
    var wingFlavors = allMenuItems
        .Where(i => string.Equals(i.Category, "Wings", StringComparison.Ordinal) && !string.IsNullOrWhiteSpace(i.Item))
        .OrderByDescending(i => i.MenuOrder)
        .ThenBy(i => i.Item)
        .Select(i => i.Item)
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .ToList();
    if (wingFlavors.Count == 0)
    {
        wingFlavors = new List<string>
        {
            "Buffalo Cong",
            "Chief Parm",
            "Colonel Mustard",
            "Konsi Honey Soy",
            "Konsi Soy Garlic",
            "Konsi Soy Spicy",
            "Mayora Sriracha Honey",
            "Mayora Sriracha Mayo",
            "Mayora Sriracha Original",
            "SK Salt and Pepper",
            "Teriyaki Sen",
            "Usec Salted Egg",
            "Usec Salted Egg Spicy",
            "Vice Thai"
        };
    }

    static string VariantBaseName(string itemName) =>
        itemName.StartsWith("Potato Thins ", StringComparison.OrdinalIgnoreCase)
            ? "Potato Thins"
            : itemName.Equals("Plain Rice", StringComparison.OrdinalIgnoreCase) || itemName.Equals("Garlic Rice", StringComparison.OrdinalIgnoreCase)
            ? "Rice"
            : itemName.Contains(" - ", StringComparison.Ordinal)
            ? itemName[..itemName.IndexOf(" - ", StringComparison.Ordinal)].Trim()
            : itemName;

    static string VariantLabel(string itemName) =>
        itemName.StartsWith("Potato Thins ", StringComparison.OrdinalIgnoreCase)
            ? itemName["Potato Thins ".Length..].Trim()
            : itemName.Equals("Plain Rice", StringComparison.OrdinalIgnoreCase)
            ? "Plain"
            : itemName.Equals("Garlic Rice", StringComparison.OrdinalIgnoreCase)
            ? "Garlic"
            : itemName.Contains(" - ", StringComparison.Ordinal)
            ? itemName[(itemName.IndexOf(" - ", StringComparison.Ordinal) + 3)..].Trim()
            : itemName;

    static bool IsCoffeeItem(string itemName) =>
        itemName.Equals("Coffee", StringComparison.OrdinalIgnoreCase);

    static bool IsSulitWingRiceMeal(SelfOrderingSystemKiosk.Models.MenuItem item) =>
        string.Equals(item.Category, "Sulit Kap Meals", StringComparison.Ordinal)
        && !string.IsNullOrWhiteSpace(item.Item)
        && item.Item.Contains("Chicken Wings With Rice - ", StringComparison.OrdinalIgnoreCase);

    static bool IsUnlimitedIncludedMenuItem(SelfOrderingSystemKiosk.Models.MenuItem item)
    {
        if (item == null || string.IsNullOrWhiteSpace(item.Item))
            return false;

        var name = item.Item.Trim();
        if (string.Equals(item.Category, "Unlimited Inclusions", StringComparison.Ordinal))
            return true;

        if (string.Equals(item.Category, "Wings", StringComparison.Ordinal))
            return true;

        if (string.Equals(item.Category, "Drinks", StringComparison.Ordinal))
            return true;

        if (string.Equals(item.Category, "Add Ons", StringComparison.Ordinal))
        {
            return name.Equals("Plain Rice", StringComparison.OrdinalIgnoreCase)
                || name.Equals("Garlic Rice", StringComparison.OrdinalIgnoreCase)
                || name.Equals("Extra Gravy", StringComparison.OrdinalIgnoreCase);
        }

        if (string.Equals(item.Category, "Appetizer", StringComparison.Ordinal))
        {
            return name.Equals("Nachos", StringComparison.OrdinalIgnoreCase)
                || name.StartsWith("Potato Thins", StringComparison.OrdinalIgnoreCase);
        }

        return false;
    }

    static bool IsUnlimitedRice(SelfOrderingSystemKiosk.Models.MenuItem item) =>
        string.Equals(item.Category, "Add Ons", StringComparison.Ordinal)
        && (item.Item.Equals("Plain Rice", StringComparison.OrdinalIgnoreCase)
            || item.Item.Equals("Garlic Rice", StringComparison.OrdinalIgnoreCase));

    static bool IsUnlimitedSauce(SelfOrderingSystemKiosk.Models.MenuItem item) =>
        string.Equals(item.Category, "Add Ons", StringComparison.Ordinal)
        && item.Item.Equals("Extra Gravy", StringComparison.OrdinalIgnoreCase);

    static bool IsUnlimitedSide(SelfOrderingSystemKiosk.Models.MenuItem item) =>
        string.Equals(item.Category, "Appetizer", StringComparison.Ordinal)
        && (item.Item.Equals("Nachos", StringComparison.OrdinalIgnoreCase)
            || item.Item.StartsWith("Potato Thins", StringComparison.OrdinalIgnoreCase));

    static bool IsUnlimitedPasta(SelfOrderingSystemKiosk.Models.MenuItem item) =>
        string.Equals(item.Category, "Unlimited Inclusions", StringComparison.Ordinal)
        && (string.Equals(item.FoodCategory, "pasta", StringComparison.OrdinalIgnoreCase)
            || item.Item.Contains("Pasta", StringComparison.OrdinalIgnoreCase));

    static bool IsUnlimitedDrink(SelfOrderingSystemKiosk.Models.MenuItem item) =>
        (string.Equals(item.Category, "Drinks", StringComparison.Ordinal)
            || string.Equals(item.Category, "Unlimited Inclusions", StringComparison.Ordinal))
        && !IsUnlimitedPasta(item)
        && (string.Equals(item.FoodCategory, "drink", StringComparison.OrdinalIgnoreCase)
            || item.Item.Contains("Tea", StringComparison.OrdinalIgnoreCase)
            || item.Item.Contains("Coffee", StringComparison.OrdinalIgnoreCase)
            || item.Item.Contains("Drink", StringComparison.OrdinalIgnoreCase)
            || item.Item.Contains("Softdrinks", StringComparison.OrdinalIgnoreCase)
            || item.Item.Equals("Water", StringComparison.OrdinalIgnoreCase));

    static string SulitMealBaseName(string itemName) =>
        itemName.Contains(" - ", StringComparison.Ordinal)
            ? itemName[..itemName.IndexOf(" - ", StringComparison.Ordinal)].Trim()
            : itemName;
}

<link rel="stylesheet" href="~/css/Kiosk.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/Menu.css" />
@await Html.PartialAsync("_Loader")
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
@Html.AntiForgeryToken()

<div class="container">
    <div class="kiosk-page-actions">
        <form asp-action="ChooseExperience" method="get" class="kiosk-back-form">
            <button type="submit" class="back-btn" title="Back to Experience Selection">
                <i class="bi bi-arrow-left-circle-fill" style="font-size: 2rem;"></i>
            </button>
        </form>
    </div>

    <div class="menu-container">
        <!-- LEFT: MENU LIST -->
        <div class="menu-list">
            <div class="menu-header">
                @if (ViewBag.IsQrFlow == true && ViewBag.LocationLabel != null)
                {
                    <div style="background: rgba(255,107,53,0.12); border: 1px solid #ff6b35; border-radius: 10px; padding: 8px 12px; margin-bottom: 12px; font-size: 0.95rem;">
                        <i class="bi bi-qr-code" style="color: #ff6b35;"></i> <strong>Deliver to:</strong> @ViewBag.LocationLabel
                    </div>
                }
                <h1>CHICKEN WINGS MENU</h1>
                <p>Endless Wings — ₱477 per head</p>
                <h2 style="margin-top:20px;">UNLIMITED MENU</h2>
                <p>Choose wings, rice, sides, regular pasta, and drinks</p>
                <div style="background: rgba(255,255,255,0.95); border: 1px solid rgba(255,107,53,0.35); border-radius: 10px; padding: 9px 13px; margin: 12px auto; max-width: 360px; font-size: 0.92rem;">
                    <i class="bi bi-hourglass-split" style="color:#ff6b35;"></i>
                    Ordering session: @ViewBag.OrderingSessionHours hours after staff starts your first Unlimited order.
                </div>
                <div style="background: rgba(255,255,255,0.95); border: 1px solid rgba(255,107,53,0.4); border-radius: 10px; padding: 12px 14px; margin: 14px auto; max-width: 520px; text-align: left; font-size: 0.92rem;">
                    <strong style="color:#ff6b35; display:block; margin-bottom:6px;">Ala Carte add-ons</strong>
                    <span>Items with prices are charged on top of the unlimited rate. Items marked Included stay part of the unlimited order.</span>
                </div>
                <div id="session-timer" style="background: #e8f5e9; border: 2px solid #4caf50; border-radius: 10px; padding: 10px 15px; margin: 15px auto; display: none; max-width: 300px;">
                    <i class="bi bi-clock" style="color: #2e7d32; margin-right: 5px;"></i>
                    <strong style="color: #2e7d32;">Session Time: <span id="timer-display">--:--:--</span></strong>
                </div>
                <div id="session-timer-expired" style="background: #ffebee; border: 2px solid #f44336; border-radius: 10px; padding: 10px 15px; margin: 15px auto; display: none; max-width: 300px;">
                    <i class="bi bi-exclamation-triangle" style="color: #c62828; margin-right: 5px;"></i>
                    <strong style="color: #c62828;">Session Expired - Please start a new order</strong>
                </div>
            </div>

            <div class="menu-tabs">
                <button type="button" class="active" data-filter="Unlimited"><i class="bi bi-infinity"></i> Unlimited</button>
                <button type="button" data-filter="Ala Carte"><i class="bi bi-menu-button-wide"></i> Ala Carte</button>
            </div>

            <!-- Scrollable Menu Items -->
            <div class="menu-scroll">
                @foreach (var item in allMenuItems)
                {
                    var menuLabel = item.Item ?? "";
                    var baseName = VariantBaseName(menuLabel);
                    if (IsUnlimitedIncludedMenuItem(item))
                    {
                        if (renderedUnlimitedIncludedBoard)
                        {
                            continue;
                        }

                        renderedUnlimitedIncludedBoard = true;
                        var includedItems = allMenuItems
                            .Where(IsUnlimitedIncludedMenuItem)
                            .Where(i => !string.IsNullOrWhiteSpace(i.Item))
                            .ToList();
                        var unlimitedGroups = new[]
                        {
                            new
                            {
                                key = "wings",
                                title = "Chicken flavors",
                                hint = "4 pcs each",
                                maxSelections = 4,
                                defaultQuantity = 4,
                                options = includedItems
                                    .Where(i => string.Equals(i.Category, "Wings", StringComparison.Ordinal))
                                    .GroupBy(i => i.Item.Trim(), StringComparer.OrdinalIgnoreCase)
                                    .Select(g => g.OrderByDescending(i => i.MenuOrder).First())
                                    .OrderByDescending(i => i.MenuOrder)
                                    .ThenBy(i => i.Item)
                                    .Select(i => new
                                    {
                                        name = i.Item,
                                        label = i.Item,
                                        image = Url.Content(KpImages.ResolveDisplayPath(i.Item, i.Image))
                                    })
                                    .ToList()
                            },
                            new
                            {
                                key = "rice",
                                title = "Rice",
                                hint = "Included",
                                maxSelections = 0,
                                defaultQuantity = 1,
                                options = includedItems
                                    .Where(IsUnlimitedRice)
                                    .GroupBy(i => i.Item.Trim(), StringComparer.OrdinalIgnoreCase)
                                    .Select(g => g.OrderByDescending(i => i.MenuOrder).First())
                                    .OrderByDescending(i => i.MenuOrder)
                                    .ThenBy(i => i.Item)
                                    .Select(i => new
                                    {
                                        name = i.Item,
                                        label = i.Item,
                                        image = Url.Content(KpImages.ResolveDisplayPath(i.Item, i.Image))
                                    })
                                    .ToList()
                            },
                            new
                            {
                                key = "sides",
                                title = "Sides and gravy",
                                hint = "Included",
                                maxSelections = 0,
                                defaultQuantity = 1,
                                options = includedItems
                                    .Where(i => IsUnlimitedSide(i) || IsUnlimitedSauce(i))
                                    .GroupBy(i => i.Item.Trim(), StringComparer.OrdinalIgnoreCase)
                                    .Select(g => g.OrderByDescending(i => i.MenuOrder).First())
                                    .OrderByDescending(i => i.MenuOrder)
                                    .ThenBy(i => i.Item)
                                    .Select(i => new
                                    {
                                        name = i.Item,
                                        label = VariantLabel(i.Item),
                                        image = Url.Content(KpImages.ResolveDisplayPath(i.Item, i.Image))
                                    })
                                    .ToList()
                            },
                            new
                            {
                                key = "pasta",
                                title = "Pasta",
                                hint = "Included",
                                maxSelections = 0,
                                defaultQuantity = 1,
                                options = includedItems
                                    .Where(IsUnlimitedPasta)
                                    .GroupBy(i => i.Item.Trim(), StringComparer.OrdinalIgnoreCase)
                                    .Select(g => g.OrderByDescending(i => i.MenuOrder).First())
                                    .OrderByDescending(i => i.MenuOrder)
                                    .ThenBy(i => i.Item)
                                    .Select(i => new
                                    {
                                        name = i.Item,
                                        label = i.Item.StartsWith("Unli Pasta ", StringComparison.OrdinalIgnoreCase)
                                            ? i.Item["Unli Pasta ".Length..].Trim()
                                            : i.Item,
                                        image = Url.Content(KpImages.ResolveDisplayPath(i.Item, i.Image))
                                    })
                                    .ToList()
                            },
                            new
                            {
                                key = "drinks",
                                title = "Drinks",
                                hint = "Included",
                                maxSelections = 0,
                                defaultQuantity = 1,
                                options = includedItems
                                    .Where(IsUnlimitedDrink)
                                    .GroupBy(i => i.Item.Trim(), StringComparer.OrdinalIgnoreCase)
                                    .Select(g => g.OrderByDescending(i => i.MenuOrder).First())
                                    .OrderByDescending(i => i.MenuOrder)
                                    .ThenBy(i => i.Item)
                                    .Select(i => new
                                    {
                                        name = i.Item,
                                        label = i.Item,
                                        image = Url.Content(KpImages.ResolveDisplayPath(i.Item, i.Image))
                                    })
                                    .ToList()
                            }
                        }
                        .Where(g => g.options.Count > 0)
                        .ToList();

                        if (unlimitedGroups.Count > 0)
                        {
                            var featuredImage = unlimitedGroups.SelectMany(g => g.options).FirstOrDefault()?.image ?? Url.Content("~/images/unlimited.png");
                            var includedOptionsJson = JsonSerializer.Serialize(unlimitedGroups);
                            <div class="menu-row" data-category="Unlimited">
                                <img src="@featuredImage" alt="Unlimited selections" />
                                <div class="menu-details">
                                    <h4>UNLIMITED SELECTIONS</h4>
                                    <p class="wing-order-note">Customize all included items in one order</p>
                                    <p style="color:#2e7d32;font-weight:700;margin:4px 0 0;">Included</p>
                                </div>
                                <button type="button"
                                        class="customize-unlimited-included"
                                        data-image="@featuredImage"
                                        data-groups='@includedOptionsJson'>
                                    Customize
                                </button>
                            </div>
                        }
                        continue;
                    }

                    if (IsSulitWingRiceMeal(item))
                    {
                        var sulitBaseName = SulitMealBaseName(menuLabel);
                        if (!renderedSulitMealBases.Add(sulitBaseName))
                        {
                            continue;
                        }

                        var sulitItems = allMenuItems
                            .Where(IsSulitWingRiceMeal)
                            .Where(i => string.Equals(SulitMealBaseName(i.Item), sulitBaseName, StringComparison.OrdinalIgnoreCase))
                            .OrderBy(i => i.Price)
                            .ToList();
                        var selectedSulit = sulitItems.First();
                        var sulitImage = KpImages.ResolveDisplayPath(selectedSulit.Item, selectedSulit.Image);
                        var sulitVariantsJson = JsonSerializer.Serialize(sulitItems.Select(v => new
                        {
                            name = v.Item,
                            label = VariantLabel(v.Item),
                            price = v.Price,
                            image = Url.Content(KpImages.ResolveDisplayPath(v.Item, v.Image))
                        }));
                        var minPrice = sulitItems.Min(i => i.Price);
                        var maxPrice = sulitItems.Max(i => i.Price);
                        <div class="menu-row" data-category="Ala Carte">
                            <img src="@Url.Content(sulitImage)" alt="@sulitBaseName" />
                            <div class="menu-details">
                                <h4>@sulitBaseName.ToUpper()</h4>
                                <p class="wing-order-note">Customize flavor, rice, and rice service</p>
                                <p style="color:#ff6b35;font-weight:700;margin:4px 0 0;">₱@(minPrice == maxPrice ? minPrice.ToString("0.00") : $"{minPrice:0.00} - ₱{maxPrice:0.00}")</p>
                            </div>
                            <button type="button"
                                    class="customize-sulit-meal"
                                    data-base-name="@sulitBaseName"
                                    data-image="@Url.Content(sulitImage)"
                                    data-variants='@sulitVariantsJson'>
                                Customize
                            </button>
                        </div>
                        continue;
                    }

                    if (variantMemberNames.Contains(menuLabel))
                    {
                        if (!renderedVariantBases.Add(baseName))
                        {
                            continue;
                        }

                        var groupItems = variantGroups[baseName];
                        var selected = groupItems.First();
                        var groupImage = KpImages.ResolveDisplayPath(selected.Item, selected.Image);
                        <div class="menu-row" data-category="Ala Carte">
                            <img src="@Url.Content(groupImage)" alt="@baseName" />
                            <div class="menu-details">
                                <h4>@baseName.ToUpper()</h4>
                                <select class="menu-option-select variant-select" aria-label="Choose option">
                                    @foreach (var variant in groupItems)
                                    {
                                        var variantImage = KpImages.ResolveDisplayPath(variant.Item, variant.Image);
                                        <option value="@variant.Item" data-price="@variant.Price" data-image="@Url.Content(variantImage)">@VariantLabel(variant.Item) @(variant.Price <= 0 ? "- Included" : $"- ₱{variant.Price:0.00}")</option>
                                    }
                                </select>
                                <p class="menu-price" style="color:@(selected.Price <= 0 ? "#2e7d32" : "#ff6b35");font-weight:700;margin:4px 0 0;">@(selected.Price <= 0 ? "Included" : $"₱{selected.Price:0.00}")</p>
                            </div>
                            <button class="add-to-cart"
                                    data-name="@selected.Item"
                                    data-price="@selected.Price"
                                    data-image="@Url.Content(groupImage)"
                                    data-is-wing-flavor="false">
                                Add to cart
                            </button>
                        </div>
                        continue;
                    }

                    var displayImage = KpImages.ResolveDisplayPath(item.Item, item.Image);
                    var isWingFlavor = string.Equals(item.Category, "Wings", StringComparison.Ordinal);
                    var isCoffee = IsCoffeeItem(menuLabel);
                    var coffeeVariantsJson = isCoffee
                        ? JsonSerializer.Serialize(new[]
                        {
                            new { name = "Coffee - Black (Hot)", label = "Black - Hot", price = item.Price, image = Url.Content(displayImage) },
                            new { name = "Coffee - White (Cold)", label = "White - Cold", price = item.Price, image = Url.Content(displayImage) }
                        })
                        : "[]";
                    <div class="menu-row" data-category="Ala Carte">
                        <img src="@Url.Content(displayImage)" alt="@menuLabel" />
                        <div class="menu-details">
                            <h4>@menuLabel.ToUpper()</h4>
                            @if (isCoffee)
                            {
                                <select class="menu-option-select variant-select" aria-label="Choose coffee option">
                                    <option value="Coffee - Black (Hot)" data-price="@item.Price" data-image="@Url.Content(displayImage)">Black - Hot @(item.Price <= 0 ? "- Included" : $"- ₱{item.Price:0.00}")</option>
                                    <option value="Coffee - White (Cold)" data-price="@item.Price" data-image="@Url.Content(displayImage)">White - Cold @(item.Price <= 0 ? "- Included" : $"- ₱{item.Price:0.00}")</option>
                                </select>
                            }
                            @if (isWingFlavor)
                            {
                                <p class="wing-order-note">Max 4 pieces per flavor</p>
                            }
                            <p style="color:@(item.Price <= 0 ? "#2e7d32" : "#ff6b35");font-weight:700;margin:4px 0 0;">@(item.Price <= 0 ? "Included" : $"₱{item.Price:0.00}")</p>
                        </div>
                        @if (isWingFlavor)
                        {
                            <div class="menu-quantity-control" data-max-quantity="4">
                                <button type="button" class="menu-qty-btn menu-qty-minus" aria-label="Decrease quantity">-</button>
                                <span class="menu-qty-value">4</span>
                                <button type="button" class="menu-qty-btn menu-qty-plus" aria-label="Increase quantity" disabled>+</button>
                            </div>
                        }
                        <button class="add-to-cart"
                                data-name="@item.Item"
                                data-price="@item.Price"
                                data-image="@Url.Content(displayImage)"
                                data-variants='@coffeeVariantsJson'
                                data-is-wing-flavor="@(isWingFlavor ? "true" : "false")">
                            Add to cart
                        </button>
                    </div>
                }
            </div>
        </div>

        <!-- RIGHT: ORDER SUMMARY -->
        <div class="order-summary">
            <div class="summary-header">
                <h3>Order Summary</h3>
                <p class="item-count">0 Items</p>
                <p class="person-count">0 Person(s)</p>
                <button type="button" class="add-person-btn">
                    <i class="bi bi-person-plus"></i> Add Person
                </button>
                <p class="serving-note"><i class="bi bi-stopwatch"></i> Serving time: 8 - 12 minutes</p>
            </div>

            <div class="summary-list">
                <div class="empty-cart">
                    <i class="bi bi-cart-x-fill" style="font-size: 3rem;"></i>
                    <p>Your cart is empty<br>Add items from the menu to get started</p>
                </div>
            </div>

            <div class="summary-footer">
                <div class="order-breakdown">
                    <div class="breakdown-row">
                        <span>Per Person (₱477 × <span id="person-count-display">0</span>):</span>
                        <span id="per-person-subtotal">₱0.00</span>
                    </div>
                    <div class="breakdown-row">
                        <span>Ala Carte add-ons:</span>
                        <span id="ala-carte-subtotal">₱0.00</span>
                    </div>
                    <div class="breakdown-row total-row">
                        <span><strong>TOTAL:</strong></span>
                        <span class="order-total"><strong>₱0.00</strong></span>
                    </div>
                </div>
                <button class="confirm-btn">CONFIRM ORDER</button>
            </div>
        </div>
    </div>
</div>

<div id="notificationContainer" style="
    position: fixed;
    top: 20px;
    right: 20px;
    z-index: 10000;
    display: flex;
    flex-direction: column;
    gap: 10px;
"></div>

<section id="unlimitedIncludedScreen" class="sulit-screen" aria-hidden="true">
    <div class="sulit-screen-shell">
        <div class="sulit-screen-topbar">
            <button type="button" class="unlimited-included-back-btn sulit-back-btn" aria-label="Back to menu">
                <i class="bi bi-arrow-left"></i>
            </button>
            <h2>Customize Unlimited Selections</h2>
        </div>

        <div class="sulit-screen-grid">
            <div class="sulit-preview">
                <img id="unlimitedIncludedImage" src="" alt="Unlimited selections" />
                <h3>Unlimited Selections</h3>
                <p>Included</p>
            </div>

            <div class="sulit-options">
                <div id="unlimitedIncludedGroups" class="unlimited-included-groups"></div>

                <button type="button" id="addUnlimitedIncludedToCart" class="sulit-confirm-btn">
                    <i class="bi bi-cart-plus"></i> Add selections
                </button>
            </div>
        </div>
    </div>
</section>

<section id="sulitMealScreen" class="sulit-screen" aria-hidden="true">
    <div class="sulit-screen-shell">
        <div class="sulit-screen-topbar">
            <button type="button" class="sulit-meal-back-btn sulit-back-btn" aria-label="Back to menu">
                <i class="bi bi-arrow-left"></i>
            </button>
            <h2>Customize Sulit Kap Meal</h2>
        </div>

        <div class="sulit-screen-grid">
            <div class="sulit-preview">
                <img id="sulitMealImage" src="" alt="Sulit Kap Meal" />
                <h3 id="sulitMealTitle"></h3>
                <p id="sulitMealPrice">₱0.00</p>
            </div>

            <div class="sulit-options">
                <div class="sulit-option-block">
                    <h4>Chicken flavor</h4>
                    <div id="sulitFlavorGrid" class="sulit-choice-grid">
                        @foreach (var flavor in wingFlavors)
