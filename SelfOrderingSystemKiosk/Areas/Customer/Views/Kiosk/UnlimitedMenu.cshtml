@model IEnumerable<SelfOrderingSystemKiosk.Models.MenuItem>
@inject SelfOrderingSystemKiosk.Services.KpItemsImageResolver KpImages
@using System.Text.Json
@{
    Layout = "~/Areas/Customer/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Unlimited Menu";
    var allMenuItems = (Model ?? Enumerable.Empty<SelfOrderingSystemKiosk.Models.MenuItem>()).ToList();
    var rememberedPersonCount = ViewBag.PersonCount is int count && count > 0
        ? count.ToString(System.Globalization.CultureInfo.InvariantCulture)
        : "null";
    var variantGroups = allMenuItems
        .Where(i => !string.IsNullOrWhiteSpace(i.Item)
            && (i.Item.StartsWith("Potato Thins ", StringComparison.OrdinalIgnoreCase)
                || i.Item.Equals("Plain Rice", StringComparison.OrdinalIgnoreCase)
                || i.Item.Equals("Garlic Rice", StringComparison.OrdinalIgnoreCase)))
        .GroupBy(i => i.Item.StartsWith("Potato Thins ", StringComparison.OrdinalIgnoreCase)
            ? "Potato Thins"
            : "Rice")
        .Where(g => g.Count() > 1)
        .ToDictionary(g => g.Key, g => g.OrderByDescending(i => i.MenuOrder).ToList(), StringComparer.OrdinalIgnoreCase);
    var variantMemberNames = variantGroups.Values.SelectMany(g => g).Select(i => i.Item).ToHashSet(StringComparer.OrdinalIgnoreCase);
    var renderedVariantBases = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
    var wingFlavors = allMenuItems
        .Where(i => string.Equals(i.Category, "Wings", StringComparison.Ordinal) && !string.IsNullOrWhiteSpace(i.Item))
        .OrderByDescending(i => i.MenuOrder)
        .ThenBy(i => i.Item)
        .ToList();
    var renderedWingFlavorChooser = false;

    static string VariantBaseName(string itemName) =>
        itemName.StartsWith("Potato Thins ", StringComparison.OrdinalIgnoreCase)
            ? "Potato Thins"
            : itemName.Equals("Plain Rice", StringComparison.OrdinalIgnoreCase) || itemName.Equals("Garlic Rice", StringComparison.OrdinalIgnoreCase)
            ? "Rice"
            : itemName;

    static string VariantLabel(string itemName) =>
        itemName.StartsWith("Potato Thins ", StringComparison.OrdinalIgnoreCase)
            ? itemName["Potato Thins ".Length..].Trim()
            : itemName.Equals("Plain Rice", StringComparison.OrdinalIgnoreCase)
            ? "Plain"
            : itemName.Equals("Garlic Rice", StringComparison.OrdinalIgnoreCase)
            ? "Garlic"
            : itemName;
}

<link rel="stylesheet" href="~/css/Kiosk.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/Menu.css" asp-append-version="true" />
@await Html.PartialAsync("_Loader")
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">

<div class="container">
    <div class="kiosk-page-actions">
        <form asp-action="ChooseExperience" method="get" class="kiosk-back-form">
            <button type="submit" class="back-btn" title="Back to Experience Selection">
                <i class="bi bi-arrow-left-circle-fill"></i>
            </button>
        </form>
    </div>

    <div class="menu-container">
        <!-- LEFT: MENU LIST -->
        <div class="menu-list">
            <div class="menu-header">
                @if (ViewBag.IsQrFlow == true && ViewBag.LocationLabel != null)
                {
                    <div style="background: rgba(255,107,53,0.12); border: 1px solid #ff6b35; border-radius: 10px; padding: 8px 12px; margin-bottom: 12px; font-size: 0.95rem;">
                        <i class="bi bi-qr-code" style="color: #ff6b35;"></i> <strong>Deliver to:</strong> @ViewBag.LocationLabel
                    </div>
                }
                <h1>CHICKEN WINGS MENU</h1>
                <p>Endless Wings — ₱477 per head</p>
                <h2 style="margin-top:20px;">UNLIMITED MENU</h2>
                <p>Choose wings, rice, sides, regular pasta, and drinks</p>
                <div style="background: rgba(255,255,255,0.95); border: 1px solid rgba(255,107,53,0.35); border-radius: 10px; padding: 9px 13px; margin: 12px auto; max-width: 360px; font-size: 0.92rem;">
                    <i class="bi bi-hourglass-split" style="color:#ff6b35;"></i>
                    Ordering session: @ViewBag.OrderingSessionHours hours after the first confirmed order.
                </div>
                <div style="background: rgba(255,255,255,0.95); border: 1px solid rgba(255,107,53,0.4); border-radius: 10px; padding: 12px 14px; margin: 14px auto; max-width: 520px; text-align: left; font-size: 0.92rem;">
                    <strong style="color:#ff6b35; display:block; margin-bottom:6px;">Unli inclusions</strong>
                    <span>Wings (regular and premium flavors), rice (garlic and plain), red iced tea, gravy, nachos, potato thins, regular pasta, coffee, and tea.</span>
                </div>
                <div id="session-timer" style="background: #e8f5e9; border: 2px solid #4caf50; border-radius: 10px; padding: 10px 15px; margin: 15px auto; display: none; max-width: 300px;">
                    <i class="bi bi-clock" style="color: #2e7d32; margin-right: 5px;"></i>
                    <strong style="color: #2e7d32;">Session Time: <span id="timer-display">--:--</span></strong>
                </div>
                <div id="session-timer-expired" style="background: #ffebee; border: 2px solid #f44336; border-radius: 10px; padding: 10px 15px; margin: 15px auto; display: none; max-width: 300px;">
                    <i class="bi bi-exclamation-triangle" style="color: #c62828; margin-right: 5px;"></i>
                    <strong style="color: #c62828;">Session Expired - Please start a new order</strong>
                </div>
            </div>

            @{
                var kioskCats = ViewBag.MenuCategories as IReadOnlyList<SelfOrderingSystemKiosk.Models.MenuCategoryOption>;
            }
            @if (kioskCats != null && kioskCats.Count > 0)
            {
                @await Html.PartialAsync("_MenuCategoryTabs", kioskCats)
            }
            else
            {
                <div class="menu-tabs">
                    <button type="button" class="active" data-filter="all"><i class="bi bi-grid-1x2-fill"></i> All Items</button>
                </div>
            }

            <!-- Scrollable Menu Items -->
            <div class="menu-scroll">
                @foreach (var item in allMenuItems)
                {
                    var menuLabel = item.Item ?? "";
                    var baseName = VariantBaseName(menuLabel);
                    if (variantMemberNames.Contains(menuLabel))
                    {
                        if (!renderedVariantBases.Add(baseName))
                        {
                            continue;
                        }

                        var groupItems = variantGroups[baseName];
                        var selected = groupItems.First();
                        var groupImage = KpImages.ResolveDisplayPath(selected.Item, selected.Image);
                        var variantsJson = JsonSerializer.Serialize(groupItems.Select(v => new
                        {
                            name = v.Item,
                            label = VariantLabel(v.Item),
                            image = Url.Content(KpImages.ResolveDisplayPath(v.Item, v.Image))
                        }));
                        <div class="menu-row" data-category="@selected.Category">
                            <img src="@Url.Content(groupImage)" alt="@baseName" />
                            <div class="menu-details">
                                <h4>@baseName.ToUpper()</h4>
                                <select class="menu-option-select variant-select" aria-label="Choose option">
                                    @foreach (var variant in groupItems)
                                    {
                                        var variantImage = KpImages.ResolveDisplayPath(variant.Item, variant.Image);
                                        <option value="@variant.Item" data-image="@Url.Content(variantImage)">@VariantLabel(variant.Item)</option>
                                    }
                                </select>
                                @if (string.Equals(baseName, "Rice", StringComparison.OrdinalIgnoreCase))
                                {
                                    <select class="menu-option-select serving-select" aria-label="Choose rice serving">
                                        <option value="Full cup">Full cup</option>
                                        <option value="Half cup">Half cup</option>
                                    </select>
                                }
                                <p style="color:#2e7d32;font-weight:700;margin:4px 0 0;">Included</p>
                            </div>
                            <button class="add-to-cart"
                                    data-name="@selected.Item"
                                    data-price="477"
                                    data-image="@Url.Content(groupImage)"
                                    data-is-wing-flavor="false"
                                    data-serving-size="@(string.Equals(baseName, "Rice", StringComparison.OrdinalIgnoreCase) ? "Full cup" : "")"
                                    data-variants='@variantsJson'>
                                Add to cart
                            </button>
                        </div>
                        continue;
                    }

                    var displayImage = KpImages.ResolveDisplayPath(item.Item, item.Image);
                    var isWingFlavor = string.Equals(item.Category, "Wings", StringComparison.Ordinal);
                    if (isWingFlavor)
                    {
                        if (renderedWingFlavorChooser)
                        {
                            continue;
                        }

                        renderedWingFlavorChooser = true;
                        var wingImage = Url.Content(displayImage);
                        <div class="menu-row" data-category="@item.Category">
                            <img src="@wingImage" alt="Chicken wings flavors" />
                            <div class="menu-details">
                                <h4>CHICKEN WINGS FLAVORS</h4>
                                <small class="wing-set-hint">Choose flavors on the next screen</small>
                                <p style="color:#2e7d32;font-weight:700;margin:4px 0 0;">Included</p>
                            </div>
                            <button type="button"
                                    class="unli-wing-flavor-launch"
                                    data-image="@wingImage">
                                Choose flavors
                            </button>
                        </div>
                        continue;
                    }
                    <div class="menu-row" data-category="@item.Category">
                        <img src="@Url.Content(displayImage)" alt="@menuLabel" />
                        <div class="menu-details">
                            <h4>@menuLabel.ToUpper()</h4>
                            <p style="color:#2e7d32;font-weight:700;margin:4px 0 0;">Included</p>
                        </div>
                        <button class="add-to-cart"
                                data-name="@item.Item"
                                data-price="477"
                                data-image="@Url.Content(displayImage)"
                                data-is-wing-flavor="@(isWingFlavor ? "true" : "false")">
                            Add to cart
                        </button>
                    </div>
                }
            </div>
        </div>

        <!-- RIGHT: ORDER SUMMARY -->
        <div class="order-summary">
            <div class="summary-header">
                <h3>Order Summary</h3>
                <p class="item-count">0 Items</p>
                <p class="person-count">0 Person(s)</p>
                <button type="button" class="add-person-btn" id="addPersonBtn"><i class="bi bi-person-plus"></i> Add person</button>
                <p class="serving-note"><i class="bi bi-stopwatch"></i> Serving time: 8 - 12 minutes</p>
            </div>

            <div class="summary-list">
                <div class="empty-cart">
                    <i class="bi bi-cart-x-fill" style="font-size: 3rem;"></i>
                    <p>Your cart is empty<br>Add items from the menu to get started</p>
                </div>
            </div>

            <div class="summary-footer">
                <div class="order-breakdown">
                    <div class="breakdown-row">
                        <span>Per Person (₱477 × <span id="person-count-display">0</span>):</span>
                        <span id="per-person-subtotal">₱0.00</span>
                    </div>
                    <div class="breakdown-row subtotal-row">
                        <span><strong>Subtotal:</strong></span>
                        <span id="subtotal-amount"><strong>₱0.00</strong></span>
                    </div>
                    <div class="breakdown-row total-row">
                        <span><strong>TOTAL:</strong></span>
                        <span class="order-total"><strong>₱0.00</strong></span>
                    </div>
                </div>
                <button class="confirm-btn">CONFIRM ORDER</button>
            </div>
        </div>
    </div>
</div>

<div class="wing-flavor-screen" id="unliWingFlavorScreen" aria-hidden="true">
    <div class="wing-flavor-shell">
        <header class="wing-flavor-header">
            <button type="button" class="wing-flavor-back back-btn" id="unliWingFlavorBack" title="Back to menu">
                <i class="bi bi-arrow-left"></i>
            </button>
            <div>
                <p>Unlimited wings</p>
                <h2>Choose flavors</h2>
            </div>
        </header>

        <section class="wing-flavor-product">
            <img id="unliWingFlavorImage" src="" alt="Chicken wings flavors" />
            <div>
                <strong>Included</strong>
                <span id="unliWingFlavorInstruction">Choose flavors for this order.</span>
            </div>
        </section>

        <section class="wing-flavor-grid" id="unliWingFlavorGrid">
            @foreach (var flavor in wingFlavors)
            {
                var flavorImage = Url.Content(KpImages.ResolveDisplayPath(flavor.Item, flavor.Image));
                <button type="button" class="wing-flavor-card" data-flavor="@flavor.Item" data-image="@flavorImage">@flavor.Item</button>
            }
        </section>

        <footer class="wing-flavor-footer">
            <div>
                <strong id="unliWingFlavorCount">0 selected</strong>
                <span id="unliWingFlavorLimitText">Choose flavors for this order</span>
            </div>
            <button type="button" class="wing-flavor-add" id="unliWingFlavorAdd" disabled>
                <i class="bi bi-cart-plus"></i> Add flavors
            </button>
        </footer>
    </div>
</div>

<div id="notificationContainer" style="
    position: fixed;
    top: 20px;
    right: 20px;
    z-index: 10000;
    display: flex;
    flex-direction: column;
    gap: 10px;
"></div>

@await Html.PartialAsync("~/Areas/Customer/Views/Shared/Modals/_PersonModal.cshtml")
@await Html.PartialAsync("~/Areas/Customer/Views/Shared/Modals/_RulesModal.cshtml")

<script>
    // Pass reorder information to JavaScript
    window.isReorder = @(ViewBag.IsReorder != null && (bool)ViewBag.IsReorder ? "true" : "false");
    window.reorderPersonCount = @rememberedPersonCount;
    window.orderingSessionPersonCount = @rememberedPersonCount;
</script>
<script src="~/js/booking_cart.js"></script>
<script src="~/js/mobile_order_summary.js" asp-append-version="true"></script>

<script>
    // Category filter functionality
    document.querySelectorAll('.menu-tabs button').forEach(button => {
        button.addEventListener('click', function() {
            // Remove active class from all buttons
            document.querySelectorAll('.menu-tabs button').forEach(btn => btn.classList.remove('active'));
            // Add active class to clicked button
            this.classList.add('active');
            
            // Get filter value
            const filter = this.getAttribute('data-filter');
            const menuRows = document.querySelectorAll('.menu-row');
            
            // Filter menu items
            menuRows.forEach(row => {
                if (filter === 'all') {
                    row.style.display = '';
                } else {
                    const category = row.getAttribute('data-category');
                    if (category === filter) {
                        row.style.display = '';
                    } else {
                        row.style.display = 'none';
                    }
                }
            });
        });
    });

    // Confirm Order
    document.querySelector('.confirm-btn').addEventListener('click', function() {
        if(cart.length === 0){
            alert("Your cart is empty!");
            return;
        }

        // For reorders, personCount should already be set from previous order
        // For new orders, require personCount input
        if(personCount === 0 && !window.isReorder){
            alert("Please enter the number of persons first!");
            openModal("personModal");
            return;
        }
        
        // If it's a reorder but personCount is still 0, something went wrong
        if(personCount === 0 && window.isReorder){
            alert("Error: Unable to determine number of persons. Please start a new order.");
            return;
        }

        // Prepare order items
        let orderItems = cart.map(c => ({
            ItemName: c.servingSize ? `${c.name} (${c.servingSize})` : c.name,
            Quantity: c.quantity,
            Price: 0 // Unlimited items are included, no individual price
        }));

        // Send personCount as query parameter for unlimited orders
        fetch(`/Customer/Kiosk/ConfirmOrder?orderType=Unlimited&personCount=${personCount}`, {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json'
        },
        body: JSON.stringify(orderItems)
    })
        .then(async res => {
            if (!res.ok) {
                const errorText = await res.text();
                console.error('Server error:', errorText);
                alert('Error creating order. Please try again.');
                return;
            }
            return res.json();
        })
        .then(data => {
            if(data && data.success){
                // Redirect to order tracking page
                window.location.href = '/Customer/Kiosk/Confirmation?orderNumber=' + data.orderNumber;
            } else {
                alert(data?.message || 'Error creating order. Please try again.');
            }
        })
        .catch(err => {
            console.error('Error:', err);
            alert('Error creating order. Please try again.');
        });
    });

    // Session timer
    (function() {
        let timerInterval = null;

        function updateTimer() {
            fetch('/Customer/Kiosk/GetSessionInfo')
                .then(response => response.json())
                .then(data => {
                    const timerDisplay = document.getElementById('timer-display');
                    const timerContainer = document.getElementById('session-timer');
                    const expiredContainer = document.getElementById('session-timer-expired');

                    if (data.hasSession) {
                        const submitBtn = document.querySelector('button[type="submit"]') || 
                                        document.querySelector('.confirm-btn') ||
                                        document.querySelector('.btn-primary');
                        
                        if (data.isExpired) {
                            timerContainer.style.display = 'none';
                            expiredContainer.style.display = 'block';
                            if (submitBtn) {
                                submitBtn.disabled = true;
                                submitBtn.style.opacity = '0.5';
                                submitBtn.style.cursor = 'not-allowed';
                                submitBtn.title = 'Session expired. Please start a new order.';
                            }
                            if (timerInterval) {
                                clearInterval(timerInterval);
                            }
                        } else {
                            timerContainer.style.display = 'block';
                            expiredContainer.style.display = 'none';
                            
                            const minutes = Math.floor(data.timeRemainingSeconds / 60);
                            const seconds = data.timeRemainingSeconds % 60;
                            timerDisplay.textContent = `${minutes.toString().padStart(2, '0')}:${seconds.toString().padStart(2, '0')}`;
                            
                            // Change color when less than 10 minutes remaining
                            if (data.timeRemainingSeconds < 600) {
                                timerContainer.style.background = '#fff3e0';
                                timerContainer.style.borderColor = '#ff9800';
                                timerDisplay.style.color = '#e65100';
                            }
                            
                            // Enable order button if it was disabled
                            if (submitBtn) {
                                submitBtn.disabled = false;
                                submitBtn.style.opacity = '1';
                                submitBtn.style.cursor = 'pointer';
                                submitBtn.title = '';
                            }
                        }
                    } else {
                        timerContainer.style.display = 'none';
                        expiredContainer.style.display = 'none';
                    }
                })
                .catch(error => {
                    console.error('Error fetching session info:', error);
                });
        }

        updateTimer();
        timerInterval = setInterval(updateTimer, 15000);
    })();

</script>
