@model IEnumerable<SelfOrderingSystemKiosk.Models.MenuItem>
@using System.Text.Json
@inject SelfOrderingSystemKiosk.Services.KpItemsImageResolver KpImages
@{
    Layout = "~/Areas/Customer/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Unlimited Menu";
    var allMenuItems = (Model ?? Enumerable.Empty<SelfOrderingSystemKiosk.Models.MenuItem>()).ToList();
    var rememberedPersonCount = ViewBag.PersonCount is int count && count > 0
        ? count.ToString(System.Globalization.CultureInfo.InvariantCulture)
        : "null";
    var variantGroups = allMenuItems
        .Where(i => !string.IsNullOrWhiteSpace(i.Item)
            && !IsSulitWingRiceMeal(i)
            && (i.Item.Contains(" - ", StringComparison.Ordinal)
                || i.Item.StartsWith("Potato Thins ", StringComparison.OrdinalIgnoreCase)
                || i.Item.Equals("Plain Rice", StringComparison.OrdinalIgnoreCase)
                || i.Item.Equals("Garlic Rice", StringComparison.OrdinalIgnoreCase)))
        .GroupBy(i => i.Item.StartsWith("Potato Thins ", StringComparison.OrdinalIgnoreCase)
            ? "Potato Thins"
            : i.Item.Equals("Plain Rice", StringComparison.OrdinalIgnoreCase) || i.Item.Equals("Garlic Rice", StringComparison.OrdinalIgnoreCase)
            ? "Rice"
            : i.Item[..i.Item.IndexOf(" - ", StringComparison.Ordinal)].Trim())
        .Where(g => g.Count() > 1)
        .ToDictionary(g => g.Key, g => g.OrderByDescending(i => i.MenuOrder).ToList(), StringComparer.OrdinalIgnoreCase);
    var variantMemberNames = variantGroups.Values.SelectMany(g => g).Select(i => i.Item).ToHashSet(StringComparer.OrdinalIgnoreCase);
    var renderedVariantBases = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
    var renderedSulitMealBases = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
    var wingFlavors = allMenuItems
        .Where(i => string.Equals(i.Category, "Wings", StringComparison.Ordinal) && !string.IsNullOrWhiteSpace(i.Item))
        .OrderByDescending(i => i.MenuOrder)
        .ThenBy(i => i.Item)
        .Select(i => i.Item)
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .ToList();
    if (wingFlavors.Count == 0)
    {
        wingFlavors = new List<string>
        {
            "Buffalo Cong",
            "Chief Parm",
            "Colonel Mustard",
            "Konsi Honey Soy",
            "Konsi Soy Garlic",
            "Konsi Soy Spicy",
            "Mayora Sriracha Honey",
            "Mayora Sriracha Mayo",
            "Mayora Sriracha Original",
            "SK Salt and Pepper",
            "Teriyaki Sen",
            "Usec Salted Egg",
            "Usec Salted Egg Spicy",
            "Vice Thai"
        };
    }

    static string VariantBaseName(string itemName) =>
        itemName.StartsWith("Potato Thins ", StringComparison.OrdinalIgnoreCase)
            ? "Potato Thins"
            : itemName.Equals("Plain Rice", StringComparison.OrdinalIgnoreCase) || itemName.Equals("Garlic Rice", StringComparison.OrdinalIgnoreCase)
            ? "Rice"
            : itemName.Contains(" - ", StringComparison.Ordinal)
            ? itemName[..itemName.IndexOf(" - ", StringComparison.Ordinal)].Trim()
            : itemName;

    static string VariantLabel(string itemName) =>
        itemName.StartsWith("Potato Thins ", StringComparison.OrdinalIgnoreCase)
            ? itemName["Potato Thins ".Length..].Trim()
            : itemName.Equals("Plain Rice", StringComparison.OrdinalIgnoreCase)
            ? "Plain"
            : itemName.Equals("Garlic Rice", StringComparison.OrdinalIgnoreCase)
            ? "Garlic"
            : itemName.Contains(" - ", StringComparison.Ordinal)
            ? itemName[(itemName.IndexOf(" - ", StringComparison.Ordinal) + 3)..].Trim()
            : itemName;

    static bool IsCoffeeItem(string itemName) =>
        itemName.Equals("Coffee", StringComparison.OrdinalIgnoreCase);

    static bool IsSulitWingRiceMeal(SelfOrderingSystemKiosk.Models.MenuItem item) =>
        string.Equals(item.Category, "Sulit Kap Meals", StringComparison.Ordinal)
        && !string.IsNullOrWhiteSpace(item.Item)
        && item.Item.Contains("Chicken Wings With Rice - ", StringComparison.OrdinalIgnoreCase);

    static string SulitMealBaseName(string itemName) =>
        itemName.Contains(" - ", StringComparison.Ordinal)
            ? itemName[..itemName.IndexOf(" - ", StringComparison.Ordinal)].Trim()
            : itemName;
}

<link rel="stylesheet" href="~/css/Kiosk.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/Menu.css" />
@await Html.PartialAsync("_Loader")
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
@Html.AntiForgeryToken()

<div class="container">
    <div class="kiosk-page-actions">
        <form asp-action="ChooseExperience" method="get" class="kiosk-back-form">
            <button type="submit" class="back-btn" title="Back to Experience Selection">
                <i class="bi bi-arrow-left-circle-fill" style="font-size: 2rem;"></i>
            </button>
        </form>
    </div>

    <div class="menu-container">
        <!-- LEFT: MENU LIST -->
        <div class="menu-list">
            <div class="menu-header">
                @if (ViewBag.IsQrFlow == true && ViewBag.LocationLabel != null)
                {
                    <div style="background: rgba(255,107,53,0.12); border: 1px solid #ff6b35; border-radius: 10px; padding: 8px 12px; margin-bottom: 12px; font-size: 0.95rem;">
                        <i class="bi bi-qr-code" style="color: #ff6b35;"></i> <strong>Deliver to:</strong> @ViewBag.LocationLabel
                    </div>
                }
                <h1>CHICKEN WINGS MENU</h1>
                <p>Endless Wings — ₱477 per head</p>
                <h2 style="margin-top:20px;">UNLIMITED MENU</h2>
                <p>Choose wings, rice, sides, regular pasta, and drinks</p>
                <div style="background: rgba(255,255,255,0.95); border: 1px solid rgba(255,107,53,0.35); border-radius: 10px; padding: 9px 13px; margin: 12px auto; max-width: 360px; font-size: 0.92rem;">
                    <i class="bi bi-hourglass-split" style="color:#ff6b35;"></i>
                    Ordering session: @ViewBag.OrderingSessionHours hours after staff starts your first Unlimited order.
                </div>
                <div style="background: rgba(255,255,255,0.95); border: 1px solid rgba(255,107,53,0.4); border-radius: 10px; padding: 12px 14px; margin: 14px auto; max-width: 520px; text-align: left; font-size: 0.92rem;">
                    <strong style="color:#ff6b35; display:block; margin-bottom:6px;">Ala Carte add-ons</strong>
                    <span>Items with prices are charged on top of the unlimited rate. Items marked Included stay part of the unlimited order.</span>
                </div>
                <div id="session-timer" style="background: #e8f5e9; border: 2px solid #4caf50; border-radius: 10px; padding: 10px 15px; margin: 15px auto; display: none; max-width: 300px;">
                    <i class="bi bi-clock" style="color: #2e7d32; margin-right: 5px;"></i>
                    <strong style="color: #2e7d32;">Session Time: <span id="timer-display">--:--:--</span></strong>
                </div>
                <div id="session-timer-expired" style="background: #ffebee; border: 2px solid #f44336; border-radius: 10px; padding: 10px 15px; margin: 15px auto; display: none; max-width: 300px;">
                    <i class="bi bi-exclamation-triangle" style="color: #c62828; margin-right: 5px;"></i>
                    <strong style="color: #c62828;">Session Expired - Please start a new order</strong>
                </div>
            </div>

            @{
                var kioskCats = ViewBag.MenuCategories as IReadOnlyList<SelfOrderingSystemKiosk.Models.MenuCategoryOption>;
            }
            @if (kioskCats != null && kioskCats.Count > 0)
            {
                @await Html.PartialAsync("_MenuCategoryTabs", kioskCats)
            }
            else
            {
                <div class="menu-tabs">
                    <button type="button" class="active" data-filter="all"><i class="bi bi-grid-1x2-fill"></i> All Items</button>
                </div>
            }

            <!-- Scrollable Menu Items -->
            <div class="menu-scroll">
                @foreach (var item in allMenuItems)
                {
                    var menuLabel = item.Item ?? "";
                    var baseName = VariantBaseName(menuLabel);
                    if (IsSulitWingRiceMeal(item))
                    {
                        var sulitBaseName = SulitMealBaseName(menuLabel);
                        if (!renderedSulitMealBases.Add(sulitBaseName))
                        {
                            continue;
                        }

                        var sulitItems = allMenuItems
                            .Where(IsSulitWingRiceMeal)
                            .Where(i => string.Equals(SulitMealBaseName(i.Item), sulitBaseName, StringComparison.OrdinalIgnoreCase))
                            .OrderBy(i => i.Price)
                            .ToList();
                        var selectedSulit = sulitItems.First();
                        var sulitImage = KpImages.ResolveDisplayPath(selectedSulit.Item, selectedSulit.Image);
                        var sulitVariantsJson = JsonSerializer.Serialize(sulitItems.Select(v => new
                        {
                            name = v.Item,
                            label = VariantLabel(v.Item),
                            price = v.Price,
                            image = Url.Content(KpImages.ResolveDisplayPath(v.Item, v.Image))
                        }));
                        var minPrice = sulitItems.Min(i => i.Price);
                        var maxPrice = sulitItems.Max(i => i.Price);
                        <div class="menu-row" data-category="@selectedSulit.Category">
                            <img src="@Url.Content(sulitImage)" alt="@sulitBaseName" />
                            <div class="menu-details">
                                <h4>@sulitBaseName.ToUpper()</h4>
                                <p class="wing-order-note">Customize flavor, rice, and rice service</p>
                                <p style="color:#ff6b35;font-weight:700;margin:4px 0 0;">₱@(minPrice == maxPrice ? minPrice.ToString("0.00") : $"{minPrice:0.00} - ₱{maxPrice:0.00}")</p>
                            </div>
                            <button type="button"
                                    class="customize-sulit-meal"
                                    data-base-name="@sulitBaseName"
                                    data-image="@Url.Content(sulitImage)"
                                    data-variants='@sulitVariantsJson'>
                                Customize
                            </button>
                        </div>
                        continue;
                    }

                    if (variantMemberNames.Contains(menuLabel))
                    {
                        if (!renderedVariantBases.Add(baseName))
                        {
                            continue;
                        }

                        var groupItems = variantGroups[baseName];
                        var selected = groupItems.First();
                        var groupImage = KpImages.ResolveDisplayPath(selected.Item, selected.Image);
                        <div class="menu-row" data-category="@selected.Category">
                            <img src="@Url.Content(groupImage)" alt="@baseName" />
                            <div class="menu-details">
                                <h4>@baseName.ToUpper()</h4>
                                <select class="menu-option-select variant-select" aria-label="Choose option">
                                    @foreach (var variant in groupItems)
                                    {
                                        var variantImage = KpImages.ResolveDisplayPath(variant.Item, variant.Image);
                                        <option value="@variant.Item" data-price="@variant.Price" data-image="@Url.Content(variantImage)">@VariantLabel(variant.Item) @(variant.Price <= 0 ? "- Included" : $"- ₱{variant.Price:0.00}")</option>
                                    }
                                </select>
                                <p class="menu-price" style="color:@(selected.Price <= 0 ? "#2e7d32" : "#ff6b35");font-weight:700;margin:4px 0 0;">@(selected.Price <= 0 ? "Included" : $"₱{selected.Price:0.00}")</p>
                            </div>
                            <button class="add-to-cart"
                                    data-name="@selected.Item"
                                    data-price="@selected.Price"
                                    data-image="@Url.Content(groupImage)"
                                    data-is-wing-flavor="false">
                                Add to cart
                            </button>
                        </div>
                        continue;
                    }

                    var displayImage = KpImages.ResolveDisplayPath(item.Item, item.Image);
                    var isWingFlavor = string.Equals(item.Category, "Wings", StringComparison.Ordinal);
                    var isCoffee = IsCoffeeItem(menuLabel);
                    var coffeeVariantsJson = isCoffee
                        ? JsonSerializer.Serialize(new[]
                        {
                            new { name = "Coffee - Black (Hot)", label = "Black - Hot", price = item.Price, image = Url.Content(displayImage) },
                            new { name = "Coffee - White (Cold)", label = "White - Cold", price = item.Price, image = Url.Content(displayImage) }
                        })
                        : "[]";
                    <div class="menu-row" data-category="@item.Category">
                        <img src="@Url.Content(displayImage)" alt="@menuLabel" />
                        <div class="menu-details">
                            <h4>@menuLabel.ToUpper()</h4>
                            @if (isCoffee)
                            {
                                <select class="menu-option-select variant-select" aria-label="Choose coffee option">
                                    <option value="Coffee - Black (Hot)" data-price="@item.Price" data-image="@Url.Content(displayImage)">Black - Hot @(item.Price <= 0 ? "- Included" : $"- ₱{item.Price:0.00}")</option>
                                    <option value="Coffee - White (Cold)" data-price="@item.Price" data-image="@Url.Content(displayImage)">White - Cold @(item.Price <= 0 ? "- Included" : $"- ₱{item.Price:0.00}")</option>
                                </select>
                            }
                            @if (isWingFlavor)
                            {
                                <p class="wing-order-note">Max 4 pieces per flavor</p>
                            }
                            <p style="color:@(item.Price <= 0 ? "#2e7d32" : "#ff6b35");font-weight:700;margin:4px 0 0;">@(item.Price <= 0 ? "Included" : $"₱{item.Price:0.00}")</p>
                        </div>
                        @if (isWingFlavor)
                        {
                            <div class="menu-quantity-control" data-max-quantity="4">
                                <button type="button" class="menu-qty-btn menu-qty-minus" aria-label="Decrease quantity">-</button>
                                <span class="menu-qty-value">4</span>
                                <button type="button" class="menu-qty-btn menu-qty-plus" aria-label="Increase quantity" disabled>+</button>
                            </div>
                        }
                        <button class="add-to-cart"
                                data-name="@item.Item"
                                data-price="@item.Price"
                                data-image="@Url.Content(displayImage)"
                                data-variants='@coffeeVariantsJson'
                                data-is-wing-flavor="@(isWingFlavor ? "true" : "false")">
                            Add to cart
                        </button>
                    </div>
                }
            </div>
        </div>

        <!-- RIGHT: ORDER SUMMARY -->
        <div class="order-summary">
            <div class="summary-header">
                <h3>Order Summary</h3>
                <p class="item-count">0 Items</p>
                <p class="person-count">0 Person(s)</p>
                <button type="button" class="add-person-btn">
                    <i class="bi bi-person-plus"></i> Add Person
                </button>
                <p class="serving-note"><i class="bi bi-stopwatch"></i> Serving time: 8 - 12 minutes</p>
            </div>

            <div class="summary-list">
                <div class="empty-cart">
                    <i class="bi bi-cart-x-fill" style="font-size: 3rem;"></i>
                    <p>Your cart is empty<br>Add items from the menu to get started</p>
                </div>
            </div>

            <div class="summary-footer">
                <div class="order-breakdown">
                    <div class="breakdown-row">
                        <span>Per Person (₱477 × <span id="person-count-display">0</span>):</span>
                        <span id="per-person-subtotal">₱0.00</span>
                    </div>
                    <div class="breakdown-row">
                        <span>Ala Carte add-ons:</span>
                        <span id="ala-carte-subtotal">₱0.00</span>
                    </div>
                    <div class="breakdown-row total-row">
                        <span><strong>TOTAL:</strong></span>
                        <span class="order-total"><strong>₱0.00</strong></span>
                    </div>
                </div>
                <button class="confirm-btn">CONFIRM ORDER</button>
            </div>
        </div>
    </div>
</div>

<div id="notificationContainer" style="
    position: fixed;
    top: 20px;
    right: 20px;
    z-index: 10000;
    display: flex;
    flex-direction: column;
    gap: 10px;
"></div>

<section id="sulitMealScreen" class="sulit-screen" aria-hidden="true">
    <div class="sulit-screen-shell">
        <div class="sulit-screen-topbar">
            <button type="button" class="sulit-meal-back-btn sulit-back-btn" aria-label="Back to menu">
                <i class="bi bi-arrow-left"></i>
            </button>
            <h2>Customize Sulit Kap Meal</h2>
        </div>

        <div class="sulit-screen-grid">
            <div class="sulit-preview">
                <img id="sulitMealImage" src="" alt="Sulit Kap Meal" />
                <h3 id="sulitMealTitle"></h3>
                <p id="sulitMealPrice">₱0.00</p>
            </div>

            <div class="sulit-options">
                <div class="sulit-option-block">
                    <h4>Chicken flavor</h4>
                    <div id="sulitFlavorGrid" class="sulit-choice-grid">
                        @foreach (var flavor in wingFlavors)
                        {
                            <button type="button" class="sulit-choice" data-flavor="@flavor">@flavor</button>
                        }
                    </div>
                </div>

                <div class="sulit-option-block">
                    <h4>Rice variant</h4>
                    <div class="sulit-choice-grid compact">
                        <button type="button" class="sulit-choice rice-choice selected" data-rice="Plain Rice">Plain Rice</button>
                        <button type="button" class="sulit-choice rice-choice" data-rice="Garlic Rice">Garlic Rice</button>
                    </div>
                </div>

                <div class="sulit-option-block">
                    <h4>Rice service</h4>
                    <div id="sulitServiceGrid" class="sulit-choice-grid compact"></div>
                </div>

                <button type="button" id="addSulitMealToCart" class="sulit-confirm-btn">
                    <i class="bi bi-cart-plus"></i> Add to cart
                </button>
            </div>
        </div>
    </div>
</section>

<style>
    .sulit-screen {
        position: fixed;
        inset: 0;
        z-index: 220;
        display: none;
        overflow-y: auto;
        background: #fffaf4;
        padding: 22px;
    }

    .sulit-screen.active {
        display: block;
    }

    .sulit-screen-shell {
        width: min(1120px, 100%);
        margin: 0 auto;
    }

    .sulit-screen-topbar {
        display: flex;
        align-items: center;
        gap: 14px;
        margin-bottom: 20px;
    }

    .sulit-screen-topbar h2 {
        margin: 0;
        color: #d35400;
        font-size: 1.45rem;
    }

    .sulit-back-btn {
        width: 44px;
        height: 44px;
        border: 0;
        border-radius: 50%;
        background: #fff;
        color: #d35400;
        box-shadow: 0 4px 14px rgba(0,0,0,0.12);
        cursor: pointer;
    }

    .sulit-screen-grid {
        display: grid;
        grid-template-columns: minmax(260px, 420px) minmax(0, 1fr);
        gap: 28px;
        align-items: start;
    }

    .sulit-preview {
        position: sticky;
        top: 18px;
        background: #fff;
        border: 1px solid #f2c094;
        border-radius: 12px;
        padding: 16px;
        box-shadow: 0 10px 24px rgba(0,0,0,0.08);
    }

    .sulit-preview img {
        width: 100%;
        aspect-ratio: 4 / 3;
        object-fit: cover;
        border-radius: 10px;
    }

    .sulit-preview h3 {
        margin: 14px 0 4px;
        color: #d35400;
        font-size: 1.25rem;
    }

    .sulit-preview p {
        margin: 0;
        color: #111827;
        font-size: 1.1rem;
        font-weight: 900;
    }

    .sulit-options {
        display: grid;
        gap: 18px;
    }

    .sulit-option-block {
        background: #fff;
        border: 1px solid #f2c094;
        border-radius: 12px;
        padding: 16px;
    }

    .sulit-option-block h4 {
        margin: 0 0 12px;
        color: #333;
        font-size: 1rem;
    }

    .sulit-choice-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 9px;
    }

    .sulit-choice-grid.compact {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .sulit-choice {
        min-height: 42px;
        padding: 9px 10px;
        border: 1px solid #ddd;
        border-radius: 8px;
        background: #fff;
        color: #333;
        font-size: 0.86rem;
        font-weight: 800;
        cursor: pointer;
        line-height: 1.15;
    }

    .sulit-choice.selected {
        background: #ff6b35;
        border-color: #ff6b35;
        color: #fff;
    }

    .sulit-confirm-btn {
        min-height: 50px;
        border: 0;
        border-radius: 10px;
        background: #e67e22;
        color: #fff;
        font-weight: 900;
        cursor: pointer;
    }

    @@media (max-width: 768px) {
        .sulit-screen {
            padding: 14px;
        }

        .sulit-screen-grid {
            grid-template-columns: 1fr;
            gap: 14px;
        }

        .sulit-preview {
            position: static;
        }

        .sulit-choice-grid,
        .sulit-choice-grid.compact {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }
</style>

@await Html.PartialAsync("~/Areas/Customer/Views/Shared/Modals/_PersonModal.cshtml")
@await Html.PartialAsync("~/Areas/Customer/Views/Shared/Modals/_RulesModal.cshtml")

<script>
    // Pass reorder information to JavaScript
    window.isReorder = @(ViewBag.IsReorder != null && (bool)ViewBag.IsReorder ? "true" : "false");
    window.reorderPersonCount = @rememberedPersonCount;
    window.orderingSessionPersonCount = @rememberedPersonCount;
</script>
<script src="~/js/booking_cart.js"></script>
<script src="~/js/mobile_order_summary.js" asp-append-version="true"></script>

<script>
    let activeSulitMeal = null;

    function formatPeso(value) {
        return `₱${Number(value || 0).toFixed(2)}`;
    }

    function setSingleChoice(button, selector) {
        document.querySelectorAll(selector).forEach(choice => choice.classList.remove('selected'));
        button.classList.add('selected');
    }

    function selectedChoiceValue(selector, attrName) {
        return document.querySelector(`${selector}.selected`)?.getAttribute(attrName) || '';
    }

    function updateSulitMealPrice() {
        if (!activeSulitMeal) return;
        const selectedService = document.querySelector('#sulitServiceGrid .sulit-choice.selected');
        const price = Number(selectedService?.getAttribute('data-price') || '0');
        const priceEl = document.getElementById('sulitMealPrice');
        if (priceEl) priceEl.textContent = formatPeso(price);
    }

    function openSulitMealScreen(button) {
        if (personCount === 0) {
            showNotification("Please enter the number of persons first.", 'error');
            openModal("personModal");
            return;
        }

        const variants = JSON.parse(button.getAttribute('data-variants') || '[]');
        if (variants.length === 0) return;

        activeSulitMeal = {
            baseName: button.getAttribute('data-base-name') || 'Sulit Kap Meal',
            image: button.getAttribute('data-image') || '',
            variants
        };

        const screen = document.getElementById('sulitMealScreen');
        const image = document.getElementById('sulitMealImage');
        const title = document.getElementById('sulitMealTitle');
        const serviceGrid = document.getElementById('sulitServiceGrid');

        if (image) image.src = activeSulitMeal.image;
        if (title) title.textContent = activeSulitMeal.baseName;
        if (serviceGrid) {
            serviceGrid.innerHTML = variants.map((variant, index) => `
                <button type="button"
                        class="sulit-choice service-choice ${index === 0 ? 'selected' : ''}"
                        data-name="${escapeHtml(variant.name)}"
                        data-label="${escapeHtml(variant.label)}"
                        data-price="${variant.price}"
                        data-image="${escapeHtml(variant.image || activeSulitMeal.image)}">
                    ${escapeHtml(variant.label)} - ${formatPeso(variant.price)}
                </button>
            `).join('');
        }

        document.querySelectorAll('#sulitFlavorGrid .sulit-choice').forEach(choice => choice.classList.remove('selected'));
        document.querySelector('#sulitFlavorGrid .sulit-choice')?.classList.add('selected');
        document.querySelectorAll('.rice-choice').forEach(choice => choice.classList.remove('selected'));
        document.querySelector('.rice-choice')?.classList.add('selected');
        updateSulitMealPrice();

        screen?.classList.add('active');
        screen?.setAttribute('aria-hidden', 'false');
    }

    function closeSulitMealScreen() {
        const screen = document.getElementById('sulitMealScreen');
        screen?.classList.remove('active');
        screen?.setAttribute('aria-hidden', 'true');
        activeSulitMeal = null;
    }

    document.querySelectorAll('.customize-sulit-meal').forEach(button => {
        button.addEventListener('click', function() {
            openSulitMealScreen(this);
        });
    });

    document.querySelector('.sulit-meal-back-btn')?.addEventListener('click', closeSulitMealScreen);

    document.getElementById('sulitFlavorGrid')?.addEventListener('click', function(e) {
        const button = e.target.closest('.sulit-choice');
        if (!button) return;
        setSingleChoice(button, '#sulitFlavorGrid .sulit-choice');
    });

    document.querySelectorAll('.rice-choice').forEach(button => {
        button.addEventListener('click', function() {
            setSingleChoice(this, '.rice-choice');
        });
    });

    document.getElementById('sulitServiceGrid')?.addEventListener('click', function(e) {
        const button = e.target.closest('.service-choice');
        if (!button) return;
        setSingleChoice(button, '#sulitServiceGrid .service-choice');
        updateSulitMealPrice();
    });

    document.getElementById('addSulitMealToCart')?.addEventListener('click', function() {
        if (!activeSulitMeal) return;

        const service = document.querySelector('#sulitServiceGrid .service-choice.selected');
        const flavor = selectedChoiceValue('#sulitFlavorGrid .sulit-choice', 'data-flavor');
        const rice = selectedChoiceValue('.rice-choice', 'data-rice');

        if (!service || !flavor || !rice) {
            alert('Please complete the meal selections.');
            return;
        }

        const price = Number(service.getAttribute('data-price') || '0');
        const newItem = {
            name: service.getAttribute('data-name'),
            price: Number.isFinite(price) ? price : 0,
            image: service.getAttribute('data-image') || activeSulitMeal.image,
            quantity: 1,
            isWingFlavor: false,
            isAlaCarteAddOn: Number.isFinite(price) && price > 0,
            flavors: [flavor, rice],
            variants: [],
            variantLabel: service.getAttribute('data-label') || ''
        };

        const existingItem = cart.find(item => cartKey(item) === cartKey(newItem));
        if (existingItem) {
            const quantityLimit = getQuantityLimit();
            if (existingItem.quantity >= quantityLimit) {
                showNotification(`You can only add up to ${quantityLimit} per Ala Carte add-on.`, 'error');
                return;
            }
            existingItem.quantity += 1;
        } else {
            cart.push(newItem);
        }

        updateCartDisplay();
        closeSulitMealScreen();
        showNotification('Added customized meal to cart.', 'success');
    });

    // Category filter functionality
    document.querySelectorAll('.menu-tabs button').forEach(button => {
        button.addEventListener('click', function() {
            // Remove active class from all buttons
            document.querySelectorAll('.menu-tabs button').forEach(btn => btn.classList.remove('active'));
            // Add active class to clicked button
            this.classList.add('active');
            
            // Get filter value
            const filter = this.getAttribute('data-filter');
            const menuRows = document.querySelectorAll('.menu-row');
            
            // Filter menu items
            menuRows.forEach(row => {
                if (filter === 'all') {
                    row.style.display = '';
                } else {
                    const category = row.getAttribute('data-category');
                    if (category === filter) {
                        row.style.display = '';
                    } else {
                        row.style.display = 'none';
                    }
                }
            });
        });
    });

    const defaultUnlimitedFilter = document.querySelector('.menu-tabs button.active');
    if (defaultUnlimitedFilter) {
        defaultUnlimitedFilter.click();
    }

    // Confirm Order
    document.querySelector('.confirm-btn').addEventListener('click', function() {
        if(cart.length === 0){
            alert("Your cart is empty!");
            return;
        }

        // For reorders, personCount should already be set from previous order
        // For new orders, require personCount input
        if(personCount === 0 && !window.isReorder){
            alert("Please enter the number of persons first!");
            openModal("personModal");
            return;
        }
        
        // If it's a reorder but personCount is still 0, something went wrong
        if(personCount === 0 && window.isReorder){
            alert("Error: Unable to determine number of persons. Please start a new order.");
            return;
        }

        // Prepare order items
        let orderItems = cart.map(c => ({
            ItemName: c.flavors && c.flavors.length > 0
                ? `${c.name} (Flavors: ${c.flavors.join(', ')})`
                : c.name,
            Quantity: c.quantity,
            Price: c.price || 0
        }));

        // Send personCount as query parameter for unlimited orders
        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
        fetch(`/Customer/Kiosk/ConfirmOrder?orderType=Unlimited&personCount=${personCount}`, {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
            'RequestVerificationToken': token
        },
        body: JSON.stringify(orderItems)
    })
        .then(async res => {
            if (!res.ok) {
                const errorText = await res.text();
                console.error('Server error:', errorText);
                alert('Error creating order. Please try again.');
                return;
            }
            return res.json();
        })
        .then(data => {
            if(data && data.success){
                // Redirect to order tracking page
                window.location.href = '/Customer/Kiosk/Confirmation?orderNumber=' + encodeURIComponent(data.orderNumber) + '&accessToken=' + encodeURIComponent(data.accessToken || '');
            } else {
                if (data?.resetPersonCount) {
                    personCount = 0;
                    window.isReorder = false;
                    window.reorderPersonCount = 0;
                    window.orderingSessionPersonCount = 0;
                    const personCountLabel = document.querySelector(".person-count");
                    if (personCountLabel) personCountLabel.textContent = "0 Persons";
                    updateOrderSummary();
                    setPersonModalMode("initial");
                    openModal("personModal");
                }
                alert(data?.message || 'Error creating order. Please try again.');
            }
        })
        .catch(err => {
            console.error('Error:', err);
            alert('Error creating order. Please try again.');
        });
    });

    // Session timer
    (function() {
        let timerInterval = null;
        let endedSessionHandled = false;

        function formatSessionTime(totalSeconds) {
            const safeSeconds = Math.max(0, Number(totalSeconds) || 0);
            const hours = Math.floor(safeSeconds / 3600);
            const minutes = Math.floor((safeSeconds % 3600) / 60);
            const seconds = safeSeconds % 60;
            return `${hours.toString().padStart(2, '0')}:${minutes.toString().padStart(2, '0')}:${seconds.toString().padStart(2, '0')}`;
        }

        function updateTimer() {
            fetch('/Customer/Kiosk/GetSessionInfo')
                .then(response => response.json())
                .then(data => {
                    const timerDisplay = document.getElementById('timer-display');
                    const timerContainer = document.getElementById('session-timer');
                    const expiredContainer = document.getElementById('session-timer-expired');

                    if ((data.sessionEnded || data.resetPersonCount) && !endedSessionHandled) {
                        endedSessionHandled = true;
                        personCount = 0;
                        cart = [];
                        window.isReorder = false;
                        window.reorderPersonCount = 0;
                        window.orderingSessionPersonCount = 0;
                        const personCountLabel = document.querySelector(".person-count");
                        if (personCountLabel) personCountLabel.textContent = "0 Persons";
                        updateCartDisplay();
                        setPersonModalMode("initial");
                        openModal("personModal");
                    }

                    if (data.hasSession) {
                        const submitBtn = document.querySelector('button[type="submit"]') || 
                                        document.querySelector('.confirm-btn') ||
                                        document.querySelector('.btn-primary');
                        
                        if (data.isExpired) {
                            timerContainer.style.display = 'none';
                            expiredContainer.style.display = 'block';
                            if (submitBtn) {
                                submitBtn.disabled = true;
                                submitBtn.style.opacity = '0.5';
                                submitBtn.style.cursor = 'not-allowed';
                                submitBtn.title = 'Session expired. Please start a new order.';
                            }
                            if (timerInterval) {
                                clearInterval(timerInterval);
                            }
                        } else {
                            timerContainer.style.display = 'block';
                            expiredContainer.style.display = 'none';
                            
                            timerDisplay.textContent = formatSessionTime(data.timeRemainingSeconds);
                            
                            // Change color when less than 10 minutes remaining
                            if (data.timeRemainingSeconds < 600) {
                                timerContainer.style.background = '#fff3e0';
                                timerContainer.style.borderColor = '#ff9800';
                                timerDisplay.style.color = '#e65100';
                            }
                            
                            // Enable order button if it was disabled
                            if (submitBtn) {
                                submitBtn.disabled = false;
                                submitBtn.style.opacity = '1';
                                submitBtn.style.cursor = 'pointer';
                                submitBtn.title = '';
                            }
                        }
                    } else {
                        timerContainer.style.display = 'none';
                        expiredContainer.style.display = 'none';
                    }
                })
                .catch(error => {
                    console.error('Error fetching session info:', error);
                });
        }

        updateTimer();
        timerInterval = setInterval(updateTimer, 15000);
    })();

</script>
