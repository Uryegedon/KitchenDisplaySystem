@model IEnumerable<SelfOrderingSystemKiosk.Models.MenuItem>
@using System.Text.Json
@inject SelfOrderingSystemKiosk.Services.KpItemsImageResolver KpImages
@{
    ViewData["Title"] = "Ala Carte Menu";
    Layout = "~/Areas/Customer/Views/Shared/_Layout.cshtml";
    var allMenuItems = (Model ?? Enumerable.Empty<SelfOrderingSystemKiosk.Models.MenuItem>()).ToList();
    var variantCategories = new HashSet<string>(StringComparer.Ordinal) { "Pasta", "Drinks" };
    var variantGroups = allMenuItems
        .Where(i => !string.IsNullOrWhiteSpace(i.Item)
            && !string.IsNullOrWhiteSpace(i.Category)
            && ((variantCategories.Contains(i.Category) && i.Item.Contains(" - ", StringComparison.Ordinal))
                || i.Item.StartsWith("Potato Thins ", StringComparison.OrdinalIgnoreCase)))
        .GroupBy(i => i.Item.StartsWith("Potato Thins ", StringComparison.OrdinalIgnoreCase)
            ? "Potato Thins"
            : i.Item[..i.Item.IndexOf(" - ", StringComparison.Ordinal)].Trim())
        .Where(g => g.Count() > 1)
        .ToDictionary(g => g.Key, g => g.OrderByDescending(i => i.MenuOrder).ToList(), StringComparer.OrdinalIgnoreCase);
    var variantMemberNames = variantGroups.Values.SelectMany(g => g).Select(i => i.Item).ToHashSet(StringComparer.OrdinalIgnoreCase);
    var renderedVariantBases = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
    var renderedSulitMealBases = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
    var renderedWingSetCard = false;
    var wingFlavors = allMenuItems
        .Where(i => string.Equals(i.Category, "Wings", StringComparison.Ordinal) && !string.IsNullOrWhiteSpace(i.Item))
        .OrderByDescending(i => i.MenuOrder)
        .ThenBy(i => i.Item)
        .Select(i => i.Item)
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .ToList();
    if (wingFlavors.Count == 0)
    {
        wingFlavors = new List<string>
        {
            "Buffalo Cong",
            "Chief Parm",
            "Colonel Mustard",
            "Konsi Honey Soy",
            "Konsi Soy Garlic",
            "Konsi Soy Spicy",
            "Mayora Sriracha Honey",
            "Mayora Sriracha Mayo",
            "Mayora Sriracha Original",
            "SK Salt and Pepper",
            "Teriyaki Sen",
            "Usec Salted Egg",
            "Usec Salted Egg Spicy",
            "Vice Thai"
        };
    }

    static int ExtractFlavorLimit(string itemName)
    {
        var marker = "Flavors Only";
        var markerIndex = itemName.IndexOf(marker, StringComparison.OrdinalIgnoreCase);
        if (markerIndex < 0) return 0;

        var before = itemName[..markerIndex].TrimEnd(' ', ')', '(');
        var start = before.LastIndexOf('(');
        if (start >= 0)
            before = before[(start + 1)..];

        var digits = new string(before.Where(char.IsDigit).ToArray());
        return int.TryParse(digits, out var limit) ? limit : 0;
    }

    static string VariantBaseName(string itemName) =>
        itemName.StartsWith("Potato Thins ", StringComparison.OrdinalIgnoreCase)
            ? "Potato Thins"
            : itemName.Contains(" - ", StringComparison.Ordinal)
            ? itemName[..itemName.IndexOf(" - ", StringComparison.Ordinal)].Trim()
            : itemName;

    static string VariantLabel(string itemName) =>
        itemName.StartsWith("Potato Thins ", StringComparison.OrdinalIgnoreCase)
            ? itemName["Potato Thins ".Length..].Trim()
            : itemName.Contains(" - ", StringComparison.Ordinal)
            ? itemName[(itemName.IndexOf(" - ", StringComparison.Ordinal) + 3)..].Trim()
            : itemName;

    static bool IsCoffeeItem(string itemName) =>
        itemName.Equals("Coffee", StringComparison.OrdinalIgnoreCase);

    static bool IsSulitWingRiceMeal(SelfOrderingSystemKiosk.Models.MenuItem item) =>
        string.Equals(item.Category, "Sulit Kap Meals", StringComparison.Ordinal)
        && !string.IsNullOrWhiteSpace(item.Item)
        && item.Item.Contains("Chicken Wings With Rice - ", StringComparison.OrdinalIgnoreCase);

    static bool IsWingSet(SelfOrderingSystemKiosk.Models.MenuItem item) =>
        string.Equals(item.Category, "Wings Ala Carte", StringComparison.Ordinal)
        && !string.IsNullOrWhiteSpace(item.Item)
        && item.Item.Contains("Chicken Wings", StringComparison.OrdinalIgnoreCase);

    static int ExtractPieceCount(string itemName)
    {
        var marker = "Piece";
        var markerIndex = itemName.IndexOf(marker, StringComparison.OrdinalIgnoreCase);
        if (markerIndex < 0) return 0;

        var before = itemName[..markerIndex].Trim();
        var digits = new string(before.Where(char.IsDigit).ToArray());
        return int.TryParse(digits, out var pieces) ? pieces : 0;
    }

    static string SulitMealBaseName(string itemName) =>
        itemName.Contains(" - ", StringComparison.Ordinal)
            ? itemName[..itemName.IndexOf(" - ", StringComparison.Ordinal)].Trim()
            : itemName;
}

<link rel="stylesheet" href="~/css/Kiosk.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/Menu.css" />
@await Html.PartialAsync("_Loader")
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
@Html.AntiForgeryToken()

<div class="container">
    <div class="kiosk-page-actions">
        <form asp-action="ChooseExperience" method="get" class="kiosk-back-form">
            <button type="submit" class="back-btn" title="Back to Experience Selection">
                <i class="bi bi-arrow-left-circle-fill" style="font-size: 2rem;"></i>
            </button>
        </form>
    </div>

    <div class="menu-container">
        <!-- LEFT: MENU LIST -->
        <div class="menu-list">
            <div class="menu-header">
                @if (ViewBag.IsQrFlow == true && ViewBag.LocationLabel != null)
                {
                    <div style="background: rgba(255,107,53,0.12); border: 1px solid #ff6b35; border-radius: 10px; padding: 8px 12px; margin-bottom: 12px; font-size: 0.95rem;">
                        <i class="bi bi-qr-code" style="color: #ff6b35;"></i> <strong>Deliver to:</strong> @ViewBag.LocationLabel
                    </div>
                }
                <h1>CHICKEN WINGS MENU</h1>
                <p>Order your favorite dishes with ease</p>
                <h2 style="margin-top:20px;">ALA CARTE MENU</h2>
                <p>Pick and enjoy our flavorful chicken wings and special sides</p>
            </div>

            @{
                var kioskCats = ViewBag.MenuCategories as IReadOnlyList<SelfOrderingSystemKiosk.Models.MenuCategoryOption>;
            }
            @if (kioskCats != null && kioskCats.Count > 0)
            {
                @await Html.PartialAsync("_MenuCategoryTabs", kioskCats)
            }
            else
            {
                <div class="menu-tabs">
                    <button type="button" class="active" data-filter="all"><i class="bi bi-grid-1x2-fill"></i> All Items</button>
                </div>
            }

            <!-- Scrollable Menu Items -->
            <div class="menu-scroll">
                @foreach (var item in allMenuItems)
                {
                    if (string.Equals(item.Category, "Wings", StringComparison.Ordinal))
                    {
                        continue;
                    }

                    var menuLabel = item.Item ?? "";
                    var baseName = VariantBaseName(menuLabel);
                    if (IsWingSet(item))
                    {
                        if (renderedWingSetCard)
                        {
                            continue;
                        }

                        renderedWingSetCard = true;
                        var wingSetItems = allMenuItems
                            .Where(IsWingSet)
                            .OrderBy(i => ExtractPieceCount(i.Item))
                            .ThenBy(i => i.Price)
                            .ToList();
                        var selectedWingSet = wingSetItems.First();
                        var wingSetImage = KpImages.ResolveDisplayPath(selectedWingSet.Item, selectedWingSet.Image);
                        var wingSetOptionsJson = JsonSerializer.Serialize(wingSetItems.Select(v => new
                        {
                            name = v.Item,
                            pieces = ExtractPieceCount(v.Item),
                            flavorLimit = ExtractFlavorLimit(v.Item),
                            price = v.Price,
                            image = Url.Content(KpImages.ResolveDisplayPath(v.Item, v.Image))
                        }));
                        var minWingSetPrice = wingSetItems.Min(i => i.Price);
                        var maxWingSetPrice = wingSetItems.Max(i => i.Price);
                        <div class="menu-row" data-category="@selectedWingSet.Category">
                            <img src="@Url.Content(wingSetImage)" alt="Chicken Wings Set" />
                            <div class="menu-details">
                                <h4>CHICKEN WINGS SET</h4>
                                <p class="wing-order-note">Choose pieces and flavors</p>
                                <p>₱@(minWingSetPrice == maxWingSetPrice ? minWingSetPrice.ToString("0.00") : $"{minWingSetPrice:0.00} - ₱{maxWingSetPrice:0.00}")</p>
                            </div>
                            <button type="button"
                                    class="customize-wing-set"
                                    data-image="@Url.Content(wingSetImage)"
                                    data-options='@wingSetOptionsJson'>
                                Customize
                            </button>
                        </div>
                        continue;
                    }

                    if (IsSulitWingRiceMeal(item))
                    {
                        var sulitBaseName = SulitMealBaseName(menuLabel);
                        if (!renderedSulitMealBases.Add(sulitBaseName))
                        {
                            continue;
                        }

                        var sulitItems = allMenuItems
                            .Where(IsSulitWingRiceMeal)
                            .Where(i => string.Equals(SulitMealBaseName(i.Item), sulitBaseName, StringComparison.OrdinalIgnoreCase))
                            .OrderBy(i => i.Price)
                            .ToList();
                        var selectedSulit = sulitItems.First();
                        var sulitImage = KpImages.ResolveDisplayPath(selectedSulit.Item, selectedSulit.Image);
                        var sulitVariantsJson = JsonSerializer.Serialize(sulitItems.Select(v => new
                        {
                            name = v.Item,
                            label = VariantLabel(v.Item),
                            price = v.Price,
                            image = Url.Content(KpImages.ResolveDisplayPath(v.Item, v.Image))
                        }));
                        var minPrice = sulitItems.Min(i => i.Price);
                        var maxPrice = sulitItems.Max(i => i.Price);
                        <div class="menu-row" data-category="@selectedSulit.Category">
                            <img src="@Url.Content(sulitImage)" alt="@sulitBaseName" />
                            <div class="menu-details">
                                <h4>@sulitBaseName.ToUpper()</h4>
                                <p class="wing-order-note">Customize flavor, rice, and rice service</p>
                                <p>₱@(minPrice == maxPrice ? minPrice.ToString("0.00") : $"{minPrice:0.00} - ₱{maxPrice:0.00}")</p>
                            </div>
                            <button type="button"
                                    class="customize-sulit-meal"
                                    data-base-name="@sulitBaseName"
                                    data-image="@Url.Content(sulitImage)"
                                    data-variants='@sulitVariantsJson'>
                                Customize
                            </button>
                        </div>
                        continue;
                    }

                    if (variantMemberNames.Contains(menuLabel))
                    {
                        if (!renderedVariantBases.Add(baseName))
                        {
                            continue;
                        }

                        var groupItems = variantGroups[baseName];
                        var selected = groupItems.First();
                        var groupImage = KpImages.ResolveDisplayPath(selected.Item, selected.Image);
                        var variantsJson = JsonSerializer.Serialize(groupItems.Select(v => new
                        {
                            name = v.Item,
                            label = VariantLabel(v.Item),
                            price = v.Price,
                            image = Url.Content(KpImages.ResolveDisplayPath(v.Item, v.Image))
                        }));
                        <div class="menu-row" data-category="@selected.Category">
                            <img src="@Url.Content(groupImage)" alt="@baseName" />
                            <div class="menu-details">
                                <h4>@baseName.ToUpper()</h4>
                                <select class="menu-option-select variant-select" aria-label="Choose option">
                                    @foreach (var variant in groupItems)
                                    {
                                        var variantImage = KpImages.ResolveDisplayPath(variant.Item, variant.Image);
                                        <option value="@variant.Item" data-price="@variant.Price" data-image="@Url.Content(variantImage)">@VariantLabel(variant.Item) - ₱@variant.Price.ToString("0.00")</option>
                                    }
                                </select>
                                <p class="menu-price">₱@selected.Price.ToString("0.00")</p>
                            </div>
                            <button class="add-to-cart"
                                    data-name="@selected.Item"
                                    data-price="@selected.Price"
                                    data-image="@Url.Content(groupImage)"
                                    data-variants='@variantsJson'>
                                Add to cart
                            </button>
                        </div>
                        continue;
                    }

                    var displayImage = KpImages.ResolveDisplayPath(item.Item, item.Image);
                    var isCoffee = IsCoffeeItem(menuLabel);
                    var isWingFlavor = string.Equals(item.Category, "Wings", StringComparison.Ordinal);
                    var coffeeVariantsJson = isCoffee
                        ? JsonSerializer.Serialize(new[]
                        {
                            new { name = "Coffee - Black (Hot)", label = "Black - Hot", price = item.Price, image = Url.Content(displayImage) },
                            new { name = "Coffee - White (Cold)", label = "White - Cold", price = item.Price, image = Url.Content(displayImage) }
                        })
                        : "[]";
                    <div class="menu-row" data-category="@item.Category">
                        <img src="@Url.Content(displayImage)" alt="@menuLabel" />
                        <div class="menu-details">
                            <h4>@menuLabel.ToUpper()</h4>
                            @if (isCoffee)
                            {
                                <select class="menu-option-select variant-select" aria-label="Choose coffee option">
                                    <option value="Coffee - Black (Hot)" data-price="@item.Price" data-image="@Url.Content(displayImage)">Black - Hot - ₱@item.Price.ToString("0.00")</option>
                                    <option value="Coffee - White (Cold)" data-price="@item.Price" data-image="@Url.Content(displayImage)">White - Cold - ₱@item.Price.ToString("0.00")</option>
                                </select>
                            }
                            @if (isWingFlavor)
                            {
                                <p class="wing-order-note">4 wings per order</p>
                            }
                            <p>₱@item.Price.ToString("0.00")</p>
                        </div>
                        @if (isWingFlavor)
                        {
                            <div class="menu-quantity-control" data-max-quantity="4">
                                <button type="button" class="menu-qty-btn menu-qty-minus" aria-label="Decrease quantity">-</button>
                                <span class="menu-qty-value">4</span>
                                <button type="button" class="menu-qty-btn menu-qty-plus" aria-label="Increase quantity" disabled>+</button>
                            </div>
                        }
                        <button class="add-to-cart"
                                data-name="@item.Item"
                                data-price="@item.Price"
                                data-image="@Url.Content(displayImage)"
                                data-variants='@coffeeVariantsJson'
                                data-flavor-limit="0"
                                data-is-wing-flavor="@(isWingFlavor ? "true" : "false")">
                            Add to cart
                        </button>
                    </div>
                }
            </div>
        </div>

        <!-- RIGHT: ORDER SUMMARY -->
        <div class="order-summary">
            <div class="summary-header">
                <h3>Order Summary</h3>
                <p class="item-count">0 Items</p>
                <p class="serving-note"><i class="bi bi-stopwatch"></i> Serving time: 8 - 12 minutes</p>
            </div>

            <div class="summary-list">
                <div class="empty-cart">
                    <i class="bi bi-cart-x-fill" style="font-size: 3rem;"></i>
                    <p>Your cart is empty<br>Add items from the menu to get started</p>
                </div>
            </div>

            <div class="summary-footer">
                <p class="order-total">TOTAL: ₱0.00</p>
                <button class="confirm-btn">CONFIRM ORDER</button>
            </div>
        </div>
    </div>
</div>

<section id="wingSetScreen" class="sulit-screen" aria-hidden="true">
    <div class="sulit-screen-shell">
        <div class="sulit-screen-topbar">
            <button type="button" class="wing-set-back-btn sulit-back-btn" aria-label="Back to menu">
                <i class="bi bi-arrow-left"></i>
            </button>
            <h2>Customize Wings Set</h2>
        </div>

        <div class="sulit-screen-grid">
            <div class="sulit-preview">
                <img id="wingSetImage" src="" alt="Chicken Wings Set" />
                <h3 id="wingSetTitle">Chicken Wings Set</h3>
                <p id="wingSetPrice">₱0.00</p>
            </div>

            <div class="sulit-options">
                <div class="sulit-option-block">
                    <h4>How many wings?</h4>
                    <div id="wingPieceGrid" class="sulit-choice-grid compact"></div>
                </div>

                <div class="sulit-option-block">
                    <h4>Chicken flavors</h4>
                    <div id="wingSetFlavorGrid" class="sulit-choice-grid">
                        @foreach (var flavor in wingFlavors)
                        {
                            <button type="button" class="sulit-choice" data-flavor="@flavor">@flavor</button>
                        }
                    </div>
                    <small id="wingSetFlavorCount" class="flavor-count">Choose flavors</small>
                </div>

                <button type="button" id="addWingSetToCart" class="sulit-confirm-btn">
                    <i class="bi bi-cart-plus"></i> Add to cart
                </button>
            </div>
        </div>
    </div>
</section>

<section id="sulitMealScreen" class="sulit-screen" aria-hidden="true">
    <div class="sulit-screen-shell">
        <div class="sulit-screen-topbar">
            <button type="button" class="sulit-meal-back-btn sulit-back-btn" aria-label="Back to menu">
                <i class="bi bi-arrow-left"></i>
            </button>
            <h2>Customize Sulit Kap Meal</h2>
        </div>

        <div class="sulit-screen-grid">
            <div class="sulit-preview">
                <img id="sulitMealImage" src="" alt="Sulit Kap Meal" />
                <h3 id="sulitMealTitle"></h3>
                <p id="sulitMealPrice">₱0.00</p>
            </div>

            <div class="sulit-options">
                <div class="sulit-option-block">
                    <h4>Chicken flavor</h4>
                    <div id="sulitFlavorGrid" class="sulit-choice-grid">
                        @foreach (var flavor in wingFlavors)
                        {
                            <button type="button" class="sulit-choice" data-flavor="@flavor">@flavor</button>
                        }
                    </div>
                </div>

                <div class="sulit-option-block">
                    <h4>Rice variant</h4>
                    <div class="sulit-choice-grid compact">
                        <button type="button" class="sulit-choice rice-choice selected" data-rice="Plain Rice">Plain Rice</button>
                        <button type="button" class="sulit-choice rice-choice" data-rice="Garlic Rice">Garlic Rice</button>
                    </div>
                </div>

                <div class="sulit-option-block">
                    <h4>Rice service</h4>
                    <div id="sulitServiceGrid" class="sulit-choice-grid compact"></div>
                </div>

                <button type="button" id="addSulitMealToCart" class="sulit-confirm-btn">
                    <i class="bi bi-cart-plus"></i> Add to cart
                </button>
            </div>
        </div>
    </div>
</section>

<link rel="stylesheet" href="~/css/kiosk-alacarte.css" asp-append-version="true" />
<script src="~/js/mobile_order_summary.js" asp-append-version="true"></script>

<script>
    window.kioskAlaCarteConfig = {
        wingFlavorOptions: @Html.Raw(JsonSerializer.Serialize(wingFlavors))
    };
</script>
<script src="~/js/kiosk-alacarte.js" asp-append-version="true"></script>


