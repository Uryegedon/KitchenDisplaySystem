@model SelfOrderingSystemKiosk.Areas.Customer.Models.Order
@{
    ViewData["Title"] = "Order Confirmation";
    Layout = "~/Areas/Customer/Views/Shared/_Layout.cshtml";
    var currentUrl = Context.Request.Path + Context.Request.QueryString;
    var hasOrderingSession = ViewBag.HasOrderingSession is bool hasSession && hasSession;
    var orderingSessionRemaining = ViewBag.OrderingSessionRemaining is TimeSpan remaining ? remaining : TimeSpan.Zero;
    var sessionHours = ViewBag.OrderingSessionHours is int hours ? hours : 2;
    var sessionRemainingLabel = $"{(int)orderingSessionRemaining.TotalMinutes:D2}:{orderingSessionRemaining.Seconds:D2}";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">

<style>
    /* Container */
    .confirmation-container {
        max-width: 1000px;
        margin: 50px auto;
        background: #fff;
        border-radius: 20px;
        padding: 40px;
        box-shadow: 0 10px 40px rgba(0,0,0,0.1);
        font-family: 'Segoe UI', sans-serif;
    }

    /* Success icon */
    .success-icon {
        width: 90px;
        height: 90px;
        background: #28a745;
        border-radius: 50%;
        margin: 0 auto 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        animation: scaleIn 0.5s ease-out;
    }
    @@keyframes scaleIn {
        from

    {
        transform: scale(0);
        opacity: 0;
    }

    to {
        transform: scale(1);
        opacity: 1;
    }

    }

    /* Titles and order number */
    .order-number {
        font-size: 2.5rem;
        font-weight: bold;
        color: #ff6b35;
        margin: 10px 0 25px 0;
        text-align: center;
    }

    .section-title {
        font-size: 1.5rem;
        font-weight: bold;
        color: #ff6b35;
        margin-bottom: 20px;
    }

    /* Order details */
    .order-details {
        background: #f8f9fa;
        padding: 20px;
        border-radius: 10px;
    }

    .order-item {
        display: flex;
        justify-content: space-between;
        padding: 8px 0;
        border-bottom: 1px solid #dee2e6;
    }

        .order-item:last-child {
            border-bottom: none;
        }

    .order-total-row {
        display: flex;
        justify-content: space-between;
        font-size: 1.3rem;
        font-weight: bold;
        margin-top: 20px;
        padding-top: 20px;
        border-top: 2px solid #dee2e6;
        color: #ff6b35;
    }

    /* Horizontal Tracking */
    .tracking-container {
        margin-top: 20px;
    }

    .tracking-horizontal {
        display: flex;
        justify-content: space-between;
        position: relative;
        margin-top: 40px;
    }

        .tracking-horizontal::before {
            content: '';
            position: absolute;
            top: 20px;
            left: 10%;
            width: 80%;
            height: 4px;
            background: #dee2e6;
            z-index: 0;
        }

    .tracking-step-horizontal {
        text-align: center;
        position: relative;
        z-index: 1;
        width: 33.33%;
    }

    .tracking-icon-horizontal {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: #6c757d;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 10px;
        color: white;
        font-size: 1.2rem;
        transition: all 0.3s;
    }

    .tracking-step-horizontal.completed .tracking-icon-horizontal {
        background: #28a745;
    }

    .tracking-step-horizontal.in-progress .tracking-icon-horizontal {
        background: #ff6b35;
    }

    .tracking-step-horizontal.pending .tracking-icon-horizontal {
        background: #6c757d;
    }

    .status-badge-large {
        display: inline-block;
        padding: 15px 25px;
        border-radius: 10px;
        font-size: 1.1rem;
        background: #f8f9fa;
        border: 2px solid #dee2e6;
    }

    .status-badge-large.pending {
        background: #fff3cd;
        border-color: #ffc107;
        color: #856404;
    }

    .status-badge-large.in-progress {
        background: #d1ecf1;
        border-color: #0dcaf0;
        color: #0c5460;
    }

    .status-badge-large.completed {
        background: #d4edda;
        border-color: #28a745;
        color: #155724;
    }

    .status-badge-large.canceled {
        background: #f8d7da;
        border-color: #dc3545;
        color: #721c24;
    }

    .tracking-step-horizontal p {
        margin: 0;
        font-size: 0.9rem;
        color: #666;
    }

    /* Buttons */
    .action-buttons {
        margin-top: 40px;
        display: flex;
        gap: 20px;
        justify-content: center;
    }

    .btn-primary {
        background: #ff6b35;
        color: white;
        border: none;
        padding: 12px 35px;
        border-radius: 10px;
        font-size: 1.1rem;
        cursor: pointer;
        transition: all 0.3s;
    }

        .btn-primary:hover {
            background: #e55a2b;
            transform: translateY(-2px);
        }

    .btn-secondary {
        background: #6c757d;
        color: white;
        border: none;
        padding: 12px 35px;
        border-radius: 10px;
        font-size: 1.1rem;
        cursor: pointer;
        transition: all 0.3s;
    }

    .btn-secondary:hover {
        background: #5a6268;
        transform: translateY(-2px);
    }

    .btn-danger {
        background: #dc3545;
        color: white;
        border: none;
        padding: 12px 35px;
        border-radius: 10px;
        font-size: 1.1rem;
        cursor: pointer;
        transition: all 0.3s;
    }

        .btn-danger:hover {
            background: #c82333;
            transform: translateY(-2px);
        }

        .btn-danger:disabled {
            background: #6c757d;
            opacity: 0.6;
            cursor: not-allowed;
        }

    .refresh-indicator {
        position: fixed;
        top: 20px;
        right: 20px;
        background: rgba(0, 0, 0, 0.7);
        color: white;
        padding: 8px 15px;
        border-radius: 20px;
        font-size: 0.85rem;
        z-index: 1000;
        display: none;
        align-items: center;
        gap: 8px;
    }

        .refresh-indicator.show {
            display: flex;
        }

        .refresh-indicator .spinner {
            width: 14px;
            height: 14px;
            border: 2px solid rgba(255, 255, 255, 0.3);
            border-top-color: white;
            border-radius: 50%;
            animation: spin 0.8s linear infinite;
        }

    @@keyframes spin {
        to { transform: rotate(360deg); }
    }

    .session-window {
        max-width: 460px;
        margin: 18px auto 0;
        padding: 12px 16px;
        border-radius: 10px;
        border: 2px solid #4caf50;
        background: #e8f5e9;
        color: #2e7d32;
        font-size: 1rem;
    }

    .session-window.expired {
        border-color: #f44336;
        background: #ffebee;
        color: #c62828;
    }

</style>

<div class="confirmation-container">
    <!-- Header -->
    <div class="text-center mb-4">
        <div class="success-icon">
            <i class="bi bi-check-lg" style="font-size: 2.5rem; color: white;"></i>
        </div>
        <h1>Order Confirmed!</h1>
        <p class="text-muted">Thank you for your order</p>
        <div class="order-number">@Model.OrderNumber</div>
        <p class="text-muted">
            <i class="bi bi-clock"></i> Order placed on @Model.OrderDate.ToLocalTime().ToString("MMMM dd, yyyy h:mm tt")
        </p>
        <div id="confirmation-session-timer" class="session-window @(hasOrderingSession && orderingSessionRemaining == TimeSpan.Zero ? "expired" : "")">
            @if (hasOrderingSession)
            {
                <i class="bi bi-hourglass-split"></i>
                <strong>Ordering session:</strong>
                <span id="confirmation-session-label">@sessionRemainingLabel remaining</span>
            }
            else
            {
                <i class="bi bi-hourglass-split"></i>
                <strong>Ordering session:</strong>
                <span id="confirmation-session-label">@sessionHours-hour window starts from your first confirmed order.</span>
            }
        </div>
    </div>

    <!-- Two Column Layout -->
    <div class="row">
        <!-- LEFT: Order Details -->
        <div class="col-md-6">
            <div class="order-details">
                <h3 class="section-title">Order Details</h3>
                
                <!-- Order Type Badge -->
                <div class="mb-3">
                    <span class="badge bg-primary p-2 px-3" style="font-size: 0.9rem;">
                        <i class="bi bi-@(Model.OrderType == "Unlimited" ? "infinity" : "menu-button-wide")"></i> 
                        @(Model.OrderType == "Unlimited" ? "Unlimited Experience" : "Ala Carte")
                    </span>
                    @if (string.Equals(Model.OrderChannel, "Qr", StringComparison.OrdinalIgnoreCase))
                    {
                        <span class="badge bg-success p-2 px-3 ms-1" style="font-size: 0.9rem;"><i class="bi bi-qr-code"></i> QR order</span>
                    }
                    else if (string.Equals(Model.OrderChannel, "Kiosk", StringComparison.OrdinalIgnoreCase) || string.IsNullOrEmpty(Model.OrderChannel))
                    {
                        <span class="badge bg-secondary p-2 px-3 ms-1" style="font-size: 0.9rem;"><i class="bi bi-display"></i> Kiosk</span>
                    }
                </div>
                @if (!string.IsNullOrEmpty(Model.TableNumber) || !string.IsNullOrEmpty(Model.Floor))
                {
                    <p class="mb-3" style="font-size: 1rem;">
                        <i class="bi bi-geo-alt-fill text-warning"></i>
                        <strong>Service location:</strong>
                        @if (!string.IsNullOrEmpty(Model.Floor)) { <span>Floor @Model.Floor</span> }
                        @if (!string.IsNullOrEmpty(Model.Floor) && !string.IsNullOrEmpty(Model.TableNumber)) { <span> · </span> }
                        @if (!string.IsNullOrEmpty(Model.TableNumber)) { <span>Table @Model.TableNumber</span> }
                    </p>
                }

                <!-- Order Items -->
                @if (Model.Items != null && Model.Items.Any())
                {
                    @foreach (var item in Model.Items)
                    {
                        <div class="order-item">
                            <div>
                                <strong>@item.ItemName</strong>
                                <span style="color: #666;"> x @item.Quantity</span>
                                @if (Model.OrderType == "Unlimited")
                                {
                                    <br /><small style="color: #999; font-size: 0.85em;">Unlimited Menu Item</small>
                                }
                            </div>
                            <div>
                                @if (Model.OrderType == "Unlimited")
                                {
                                    <span style="color: #666; text-decoration: line-through;">₱@((item.Price * item.Quantity).ToString("0.00"))</span>
                                    <br /><span style="color: #28a745; font-weight: bold;">Included</span>
                                }
                                else
                                {
                                    <span>₱@((item.Price * item.Quantity).ToString("0.00"))</span>
                                }
                            </div>
                        </div>
                    }
                }
                else
                {
                    <p class="text-muted">No items in this order.</p>
                }

                <!-- Order Summary -->
                <div style="margin-top: 15px; padding-top: 15px; border-top: 2px solid #dee2e6;">
                    <div class="d-flex justify-content-between mb-2">
                        <span style="font-weight: 500;">Subtotal:</span>
                        <span style="font-weight: 500;">₱@Model.Subtotal.ToString("N2")</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span style="font-weight: 500;">Tax (12%):</span>
                        <span style="font-weight: 500;">₱@Model.Tax.ToString("N2")</span>
                    </div>
                </div>
                <div class="order-total-row">
                    <span>Total Amount:</span>
                    <span>₱@Model.Total.ToString("N2")</span>
                </div>
                
                <!-- Order Status Badge -->
                <div class="mt-3">
                    @{
                        var statusClass = Model.Status.ToLower().Replace(" ", "-");
                        var badgeClass = statusClass switch
                        {
                            "pending" => "bg-warning text-dark",
                            "in-progress" => "bg-info text-white",
                            "completed" => "bg-success text-white",
                            "canceled" => "bg-danger text-white",
                            _ => "bg-secondary text-white"
                        };
                    }
                    <span class="badge @badgeClass p-2 px-3" style="font-size: 0.95rem;">
                        <i class="bi bi-@(statusClass == "pending" ? "hourglass-split" : statusClass == "in-progress" ? "arrow-repeat" : statusClass == "completed" ? "check-circle" : "x-circle")"></i> 
                        <strong>Status: @Model.Status</strong>
                    </span>
                </div>
            </div>
        </div>

        <!-- RIGHT: Horizontal Order Tracking -->
        <div class="col-md-6">
            <h3 class="section-title">Order Status</h3>
            <div class="tracking-horizontal">
                <div class="tracking-step-horizontal" data-step="pending">
                    <div class="tracking-icon-horizontal"><i class="bi bi-hourglass-split"></i></div>
                    <p>Pending</p>
                </div>
                <div class="tracking-step-horizontal" data-step="in-progress">
                    <div class="tracking-icon-horizontal"><i class="bi bi-fire"></i></div>
                    <p>In Progress</p>
                </div>
                <div class="tracking-step-horizontal" data-step="completed">
                    <div class="tracking-icon-horizontal"><i class="bi bi-check-circle"></i></div>
                    <p>Completed</p>
                </div>
            </div>
            <div class="mt-4 text-center">
                <div id="statusBadge" class="status-badge-large">
                    <i class="bi bi-info-circle"></i> Current Status: <strong>@Model.Status</strong>
                </div>
            </div>
        </div>
    </div>

    <!-- Action Buttons -->
    <div class="action-buttons">
        @{
            var canCancel = Model.Status != null && 
                           !Model.Status.Equals("In Progress", StringComparison.OrdinalIgnoreCase) &&
                           !Model.Status.Equals("Completed", StringComparison.OrdinalIgnoreCase) &&
                           !Model.Status.Equals("Canceled", StringComparison.OrdinalIgnoreCase);
        }
        @if (canCancel)
        {
            <button class="btn-danger" id="cancelOrderBtn" onclick="cancelOrder('@Model.OrderNumber')">
                <i class="bi bi-x-circle"></i> Cancel Order
            </button>
        }
        else
        {
            <button class="btn-secondary" disabled style="opacity: 0.6; cursor: not-allowed;">
                <i class="bi bi-x-circle"></i> Cannot Cancel
            </button>
        }
        @if (Model.OrderType == "Unlimited")
        {
            <a asp-action="UnlimitedMenu" asp-controller="Kiosk" asp-area="Customer" asp-route-isReorder="true" asp-route-previousOrderNumber="@Model.OrderNumber" class="btn-primary" style="text-decoration: none; background: #F39C12;">
                <i class="bi bi-arrow-repeat"></i> Reorder (Unlimited)
            </a>
        }
        else
        {
            <a asp-action="AlaCarteMenu" asp-controller="Kiosk" asp-area="Customer" asp-route-isReorder="true" asp-route-previousOrderNumber="@Model.OrderNumber" class="btn-primary" style="text-decoration: none; background: #F39C12;">
                <i class="bi bi-arrow-repeat"></i> Reorder (Ala Carte)
            </a>
        }
        <a asp-action="Receipt" asp-controller="Kitchen" asp-area="Kitchen" asp-route-orderNumber="@Model.OrderNumber" asp-route-returnUrl="@currentUrl" class="btn-primary" style="text-decoration: none; background: #111827;">
            <i class="bi bi-receipt"></i> Receipt / Bill
        </a>
        <a asp-action="Index" asp-controller="Kiosk" asp-area="Customer" class="btn-primary" style="text-decoration: none;">
            <i class="bi bi-house"></i> New Order
        </a>
    </div>

    <div class="text-center mt-4">
        <p class="text-muted" style="font-size: 0.9rem; margin-bottom: 10px;">
            <i class="bi bi-info-circle"></i> <strong>Save your order number:</strong> <span style="font-size: 1.2rem; color: #ff6b35; font-weight: bold;">@Model.OrderNumber</span>
        </p>
        <p class="text-muted" style="font-size: 0.85rem;">
            Lost this page? Go to the homepage and enter your order number to track your order status anytime.
        </p>
        <a asp-action="Index" asp-controller="Kiosk" asp-area="Customer" style="color: #ff6b35; text-decoration: underline; font-size: 0.9rem;">
            <i class="bi bi-arrow-left"></i> Back to Home / Track Another Order
        </a>
    </div>
</div>

<div class="refresh-indicator" id="refreshIndicator">
    <div class="spinner"></div>
    <span>Checking status...</span>
</div>

<script>
    // Highlight current step based on actual order status
    const orderStatus = "@Model.Status".toLowerCase().replace(" ", "-");
    const statusSteps = ["pending", "in-progress", "completed"];
    const currentStepIndex = statusSteps.indexOf(orderStatus);
    
    document.querySelectorAll('.tracking-step-horizontal').forEach((step, index) => {
        const stepStatus = step.getAttribute('data-step');
        if (index < currentStepIndex) {
            step.classList.add('completed');
        } else if (index === currentStepIndex) {
            step.classList.add('in-progress');
        } else {
            step.classList.add('pending');
        }
    });

    // Update status badge
    const statusBadge = document.getElementById('statusBadge');
    if (statusBadge) {
        statusBadge.className = 'status-badge-large ' + orderStatus;
    }

    // Poll order status: 5s while in progress; 20s when completed/canceled (page reloads on transition)
    let refreshInterval;
    const indicator = document.getElementById('refreshIndicator');
    const statusNorm = "@Model.Status".toLowerCase().replace(' ', '-');
    const pollMs = (statusNorm === 'completed' || statusNorm === 'canceled') ? 20000 : 5000;

    function checkOrderStatus() {
        if (document.hidden) {
            return; // Don't check if page is hidden
        }

        if (indicator) {
            indicator.classList.add('show');
        }

        fetch('/Customer/Kiosk/GetOrderStatus?orderNumber=@Model.OrderNumber')
            .then(response => {
                if (!response.ok) {
                    throw new Error('Network response was not ok');
                }
                return response.json();
            })
            .then(data => {
                if (indicator) {
                    indicator.classList.remove('show');
                }

                if (data.status && data.status !== '@Model.Status') {
                    location.reload();
                }
            })
            .catch(error => {
                console.log('Status check failed:', error);
                if (indicator) {
                    indicator.classList.remove('show');
                }
            });
    }

    refreshInterval = setInterval(checkOrderStatus, pollMs);

    document.addEventListener('visibilitychange', function() {
        if (document.hidden) {
            if (refreshInterval) {
                clearInterval(refreshInterval);
                refreshInterval = null;
            }
        } else {
            if (!refreshInterval) {
                refreshInterval = setInterval(checkOrderStatus, pollMs);
                checkOrderStatus();
            }
        }
    });

    setTimeout(checkOrderStatus, 2000);

    // Ordering session timer
    (function () {
        const timerBox = document.getElementById('confirmation-session-timer');
        const timerLabel = document.getElementById('confirmation-session-label');
        if (!timerBox || !timerLabel) return;

        function updateSessionTimer() {
            fetch('/Customer/Kiosk/GetSessionInfo')
                .then(response => response.json())
                .then(data => {
                    if (!data.hasSession) {
                        timerBox.classList.remove('expired');
                        timerLabel.textContent = `${data.sessionHours || @sessionHours}-hour window starts from your first confirmed order.`;
                        return;
                    }

                    if (data.isExpired) {
                        timerBox.classList.add('expired');
                        timerLabel.textContent = 'expired';
                        return;
                    }

                    timerBox.classList.remove('expired');
                    const minutes = Math.floor(data.timeRemainingSeconds / 60);
                    const seconds = data.timeRemainingSeconds % 60;
                    timerLabel.textContent = `${minutes.toString().padStart(2, '0')}:${seconds.toString().padStart(2, '0')} remaining`;
                })
                .catch(error => console.log('Session timer check failed:', error));
        }

        updateSessionTimer();
        setInterval(updateSessionTimer, 15000);
    })();

    // Cancel order function
    function cancelOrder(orderNumber) {
        if (!confirm('Are you sure you want to cancel this order?')) {
            return;
        }

        const cancelBtn = document.getElementById('cancelOrderBtn');
        if (cancelBtn) {
            cancelBtn.disabled = true;
            cancelBtn.innerHTML = '<i class="bi bi-hourglass-split"></i> Cancelling...';
        }

        fetch('/Customer/Kiosk/CancelOrder?orderNumber=' + orderNumber, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            }
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                alert('Order has been cancelled successfully.');
                location.reload();
            } else {
                alert('Error: ' + (data.message || 'Failed to cancel order.'));
                if (cancelBtn) {
                    cancelBtn.disabled = false;
                    cancelBtn.innerHTML = '<i class="bi bi-x-circle"></i> Cancel Order';
                }
            }
        })
        .catch(error => {
            console.error('Error cancelling order:', error);
            alert('An error occurred while cancelling the order. Please try again.');
            if (cancelBtn) {
                cancelBtn.disabled = false;
                cancelBtn.innerHTML = '<i class="bi bi-x-circle"></i> Cancel Order';
            }
        });
    }
</script>
