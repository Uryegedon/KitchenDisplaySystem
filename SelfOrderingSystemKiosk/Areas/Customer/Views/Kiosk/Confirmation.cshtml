@model SelfOrderingSystemKiosk.Areas.Customer.Models.Order
@using System.Text.Json
@{
    ViewData["Title"] = "Order Confirmation";
    Layout = "~/Areas/Customer/Views/Shared/_Layout.cshtml";
    var currentUrl = Context.Request.Path + Context.Request.QueryString;
    var hasOrderingSession = ViewBag.HasOrderingSession is bool hasSession && hasSession;
    var orderingSessionRemaining = ViewBag.OrderingSessionRemaining is TimeSpan remaining ? remaining : TimeSpan.Zero;
    var orderingSessionExpired = ViewBag.OrderingSessionExpired is bool expired && expired;
    var confirmationBillPaid = ViewBag.ConfirmationBillPaid is bool billPaid && billPaid;
    var sessionHours = ViewBag.OrderingSessionHours is int hours ? hours : 2;
    var sessionRemainingLabel = $"{(int)orderingSessionRemaining.TotalHours:D2}:{orderingSessionRemaining.Minutes:D2}:{orderingSessionRemaining.Seconds:D2}";
    var hasPrivateOrderAccess = ViewBag.HasPrivateOrderAccess is bool privateAccess && privateAccess;
    var publicAccessToken = ViewBag.PublicAccessToken as string ?? "";
    var sessionEnded = Model.BillArchived;
    var canReorderUnlimited = Model.OrderType == "Unlimited" && !sessionEnded && !orderingSessionExpired;
    var serviceLocationLabel = string.Equals(Model.TableNumber, "KIOSK", StringComparison.OrdinalIgnoreCase) || string.Equals(Model.TableNumber, "0", StringComparison.OrdinalIgnoreCase)
        ? "Kiosk Counter"
        : string.Equals(Model.TableNumber, "TAKEOUT", StringComparison.OrdinalIgnoreCase)
            ? "Take Out"
            : !string.IsNullOrWhiteSpace(Model.TableNumber)
                ? $"Table {Model.TableNumber}"
                : string.Equals(Model.DiningType, "TakeOut", StringComparison.OrdinalIgnoreCase)
                    ? "Take Out"
                    : "Kiosk Counter";
    var confirmationQuickItems = ViewBag.ConfirmationQuickItems as IEnumerable<SelfOrderingSystemKiosk.Areas.Customer.Controllers.ConfirmationQuickItem>
        ?? Enumerable.Empty<SelfOrderingSystemKiosk.Areas.Customer.Controllers.ConfirmationQuickItem>();
    var quickItemsJson = JsonSerializer.Serialize(confirmationQuickItems.Select(i => new
    {
        i.Name,
        i.Label,
        i.Group,
        i.Quantity,
        i.IsWingFlavor
    }));
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
@Html.AntiForgeryToken()

<style>
    /* Container */
    .confirmation-container {
        max-width: 1000px;
        margin: 50px auto;
        background: #fff;
        border-radius: 20px;
        padding: 40px;
        box-shadow: 0 10px 40px rgba(0,0,0,0.1);
        font-family: 'Segoe UI', sans-serif;
    }

    /* Success icon */
    .success-icon {
        width: 90px;
        height: 90px;
        background: #28a745;
        border-radius: 50%;
        margin: 0 auto 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        animation: scaleIn 0.5s ease-out;
    }
    @@keyframes scaleIn {
        from

    {
        transform: scale(0);
        opacity: 0;
    }

    to {
        transform: scale(1);
        opacity: 1;
    }

    }

    /* Titles and order number */
    .order-number {
        font-size: 2.5rem;
        font-weight: bold;
        color: #ff6b35;
        margin: 10px 0 25px 0;
        text-align: center;
    }

    .section-title {
        font-size: 1.5rem;
        font-weight: bold;
        color: #ff6b35;
        margin-bottom: 20px;
    }

    /* Order details */
    .order-details {
        background: #f8f9fa;
        padding: 20px;
        border-radius: 10px;
    }

    .order-item {
        display: flex;
        justify-content: space-between;
        padding: 8px 0;
        border-bottom: 1px solid #dee2e6;
    }

        .order-item:last-child {
            border-bottom: none;
        }

    .order-total-row {
        display: flex;
        justify-content: space-between;
        font-size: 1.3rem;
        font-weight: bold;
        margin-top: 20px;
        padding-top: 20px;
        border-top: 2px solid #dee2e6;
        color: #ff6b35;
    }

    /* Horizontal Tracking */
    .tracking-container {
        margin-top: 20px;
    }

    .tracking-horizontal {
        display: flex;
        justify-content: space-between;
        position: relative;
        margin-top: 40px;
    }

        .tracking-horizontal::before {
            content: '';
            position: absolute;
            top: 20px;
            left: 10%;
            width: 80%;
            height: 4px;
            background: #dee2e6;
            z-index: 0;
        }

    .tracking-step-horizontal {
        text-align: center;
        position: relative;
        z-index: 1;
        width: 33.33%;
    }

    .tracking-icon-horizontal {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: #6c757d;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 10px;
        color: white;
        font-size: 1.2rem;
        transition: all 0.3s;
    }

    .tracking-step-horizontal.completed .tracking-icon-horizontal {
        background: #28a745;
    }

    .tracking-step-horizontal.in-progress .tracking-icon-horizontal {
        background: #ff6b35;
    }

    .tracking-step-horizontal.pending .tracking-icon-horizontal {
        background: #6c757d;
    }

    .status-badge-large {
        display: inline-block;
        padding: 15px 25px;
        border-radius: 10px;
        font-size: 1.1rem;
        background: #f8f9fa;
        border: 2px solid #dee2e6;
    }

    .status-badge-large.pending {
        background: #fff3cd;
        border-color: #ffc107;
        color: #856404;
    }

    .status-badge-large.in-progress {
        background: #d1ecf1;
        border-color: #0dcaf0;
        color: #0c5460;
    }

    .status-badge-large.completed {
        background: #d4edda;
        border-color: #28a745;
        color: #155724;
    }

    .status-badge-large.canceled {
        background: #f8d7da;
        border-color: #dc3545;
        color: #721c24;
    }

    .tracking-step-horizontal p {
        margin: 0;
        font-size: 0.9rem;
        color: #666;
    }

    /* Buttons */
    .action-buttons {
        margin-top: 40px;
        display: flex;
        gap: 20px;
        justify-content: center;
    }

    .btn-primary {
        background: #ff6b35;
        color: white;
        border: none;
        padding: 12px 35px;
        border-radius: 10px;
        font-size: 1.1rem;
        cursor: pointer;
        transition: all 0.3s;
    }

        .btn-primary:hover {
            background: #e55a2b;
            transform: translateY(-2px);
        }

    .btn-secondary {
        background: #6c757d;
        color: white;
        border: none;
        padding: 12px 35px;
        border-radius: 10px;
        font-size: 1.1rem;
        cursor: pointer;
        transition: all 0.3s;
    }

    .btn-secondary:hover {
        background: #5a6268;
        transform: translateY(-2px);
    }

    .btn-danger {
        background: #dc3545;
        color: white;
        border: none;
        padding: 12px 35px;
        border-radius: 10px;
        font-size: 1.1rem;
        cursor: pointer;
        transition: all 0.3s;
    }

        .btn-danger:hover {
            background: #c82333;
            transform: translateY(-2px);
        }

        .btn-danger:disabled {
            background: #6c757d;
            opacity: 0.6;
            cursor: not-allowed;
        }

    .refresh-indicator {
        position: fixed;
        top: 20px;
        right: 20px;
        background: rgba(0, 0, 0, 0.7);
        color: white;
        padding: 8px 15px;
        border-radius: 20px;
        font-size: 0.85rem;
        z-index: 1000;
        display: none;
        align-items: center;
        gap: 8px;
    }

        .refresh-indicator.show {
            display: flex;
        }

        .refresh-indicator .spinner {
            width: 14px;
            height: 14px;
            border: 2px solid rgba(255, 255, 255, 0.3);
            border-top-color: white;
            border-radius: 50%;
            animation: spin 0.8s linear infinite;
        }

    @@keyframes spin {
        to { transform: rotate(360deg); }
    }

    .session-window {
        max-width: 460px;
        margin: 18px auto 0;
        padding: 12px 16px;
        border-radius: 10px;
        border: 2px solid #4caf50;
        background: #e8f5e9;
        color: #2e7d32;
        font-size: 1rem;
    }

    .session-window.expired {
        border-color: #f44336;
        background: #ffebee;
        color: #c62828;
    }

    .session-alert {
        max-width: 720px;
        margin: 18px auto 0;
        padding: 14px 18px;
        border-radius: 12px;
        border: 2px solid #dc3545;
        background: #fff0f1;
        color: #842029;
        display: flex;
        align-items: flex-start;
        gap: 10px;
        text-align: left;
    }

    .session-alert i {
        font-size: 1.25rem;
        margin-top: 1px;
    }

    .btn-disabled {
        background: #adb5bd !important;
        color: #fff !important;
        opacity: 0.75;
        pointer-events: none;
        cursor: not-allowed;
        text-decoration: none;
    }

    .quick-order-panel {
        margin: 30px 0 8px;
        padding: 18px;
        background: #fffaf4;
        border: 1px solid #f2c094;
        border-radius: 14px;
        text-align: left;
    }

    .quick-order-head {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 14px;
        margin-bottom: 14px;
    }

    .quick-order-head h3 {
        margin: 0;
        color: #d35400;
        font-size: 1.25rem;
        font-weight: 800;
    }

    .quick-order-head p {
        margin: 4px 0 0;
        color: #666;
        font-size: 0.92rem;
    }

    .quick-order-link {
        color: #d35400;
        font-weight: 800;
        text-decoration: none;
        white-space: nowrap;
    }

    .quick-order-groups {
        display: grid;
        gap: 14px;
    }

    .quick-group-title {
        margin: 0 0 8px;
        color: #555;
        font-size: 0.82rem;
        font-weight: 900;
        text-transform: uppercase;
    }

    .quick-order-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 8px;
    }

    .quick-order-item {
        border: 1px solid #f0d0b2;
        border-radius: 10px;
        background: #fff;
        padding: 9px;
        min-height: 54px;
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        align-items: center;
        gap: 8px;
        cursor: pointer;
        text-align: left;
    }

    .quick-order-item span {
        font-size: 0.86rem;
        font-weight: 800;
        color: #333;
        overflow-wrap: anywhere;
    }

    .quick-order-item small {
        color: #2e7d32;
        font-weight: 800;
        white-space: nowrap;
    }

    .quick-order-cart {
        margin-top: 14px;
        padding-top: 14px;
        border-top: 1px solid #f2c094;
        display: grid;
        gap: 10px;
    }

    .quick-order-cart-list {
        display: grid;
        gap: 7px;
    }

    .quick-cart-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 10px;
        background: #fff;
        border: 1px solid #f0d0b2;
        border-radius: 9px;
        padding: 8px 10px;
        font-size: 0.9rem;
    }

    .quick-cart-row button {
        border: 0;
        background: #fff0e6;
        color: #c0392b;
        border-radius: 8px;
        padding: 5px 8px;
        font-weight: 900;
    }

    .quick-order-send {
        justify-self: end;
        border: 0;
        border-radius: 10px;
        background: #ff6b35;
        color: #fff;
        padding: 11px 18px;
        font-weight: 900;
        cursor: pointer;
    }

    @@media (max-width: 768px) {
        .confirmation-container {
            margin: 10px;
            padding: 16px;
            border-radius: 14px;
        }

    .order-received-state {
        background: #6c757d;
        color: white;
        border: none;
        padding: 12px 35px;
        border-radius: 10px;
        font-size: 1.1rem;
        opacity: 0.85;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
    }

    .pending-spinner {
        width: 16px;
        height: 16px;
        border: 2px solid rgba(255, 255, 255, 0.35);
        border-top-color: #fff;
        border-radius: 50%;
        animation: spin 0.8s linear infinite;
    }

        .success-icon {
            width: 58px;
            height: 58px;
            margin-bottom: 12px;
        }

        .success-icon i {
            font-size: 1.8rem !important;
        }

        .confirmation-container h1 {
            font-size: 1.45rem;
            margin-bottom: 4px;
        }

        .order-number {
            font-size: 1.9rem;
            margin: 6px 0 14px;
            overflow-wrap: anywhere;
        }

        .session-window,
        .session-alert {
            max-width: 100%;
            margin-top: 10px;
            padding: 10px 12px;
            font-size: 0.88rem;
        }

        .row {
            gap: 14px;
        }

        .order-details {
            padding: 14px;
        }

        .section-title {
            font-size: 1.1rem;
            margin-bottom: 12px;
        }

        .order-item {
            gap: 10px;
            font-size: 0.9rem;
        }

        .order-total-row {
            font-size: 1.05rem;
            margin-top: 12px;
            padding-top: 12px;
        }

        .tracking-horizontal {
            margin-top: 18px;
        }

        .tracking-icon-horizontal {
            width: 34px;
            height: 34px;
            font-size: 1rem;
        }

        .tracking-step-horizontal p {
            font-size: 0.78rem;
        }

        .status-badge-large {
            width: 100%;
            padding: 10px 12px;
            font-size: 0.92rem;
        }

        .action-buttons {
            margin-top: 20px;
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
        }

        .action-buttons .btn-primary,
        .action-buttons .btn-secondary,
        .action-buttons .btn-danger,
        .action-buttons .order-received-state {
            width: 100%;
            min-height: 44px;
            padding: 10px 12px;
            border-radius: 9px;
            font-size: 0.9rem;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            text-align: center;
        }

        .quick-order-head {
            flex-direction: column;
        }

        .quick-order-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 420px) {
        .confirmation-container {
            margin: 6px;
            padding: 12px;
        }

        .action-buttons {
            grid-template-columns: 1fr;
        }

        .quick-order-grid {
            grid-template-columns: 1fr;
        }
    }

</style>

<div class="confirmation-container">
    <!-- Header -->
    <div class="text-center mb-4">
        <div class="success-icon">
            <i class="bi bi-check-lg" style="font-size: 2.5rem; color: white;"></i>
        </div>
        <h1>Order Confirmed!</h1>
        <p class="text-muted">Thank you for your order</p>
        <div class="order-number">@Model.OrderNumber</div>
        <p class="text-muted">
            <i class="bi bi-clock"></i> Order placed on @AppClock.ToLocal(Model.OrderDate).ToString("MMMM dd, yyyy h:mm tt")
        </p>
        @if (Model.OrderType == "Unlimited")
        {
            <div id="confirmation-session-timer" class="session-window @(hasOrderingSession && orderingSessionRemaining == TimeSpan.Zero ? "expired" : "")" style="@(hasOrderingSession ? "" : "display:none;")">
                @if (hasOrderingSession)
                {
                    <i class="bi bi-hourglass-split"></i>
                    <strong>Ordering session:</strong>
                    <span id="confirmation-session-label">@sessionRemainingLabel remaining</span>
                }
                else
                {
                    <i class="bi bi-hourglass-split"></i>
                    <strong>Ordering session:</strong>
                    <span id="confirmation-session-label">@sessionHours-hour window starts when staff starts your first Unlimited order.</span>
                }
            </div>
        }
        @if (orderingSessionExpired)
        {
            <div class="session-alert" id="session-ended-alert">
                <i class="bi bi-exclamation-triangle-fill"></i>
                <div>
                    <strong>Your ordering session is already over.</strong>
                    You cannot add more orders to this session.
                    @if (!confirmationBillPaid)
                    {
                        <span>Please settle the pending bill before starting a new table session.</span>
                    }
                </div>
            </div>
        }
    </div>

    <!-- Two Column Layout -->
    <div class="row">
        <!-- LEFT: Order Details -->
        <div class="col-md-6">
            <div class="order-details">
                <h3 class="section-title">Order Details</h3>
                
                <!-- Order Type Badge -->
                <div class="mb-3">
                    <span class="badge bg-primary p-2 px-3" style="font-size: 0.9rem;">
                        <i class="bi bi-@(Model.OrderType == "Unlimited" ? "infinity" : "menu-button-wide")"></i> 
                        @(Model.OrderType == "Unlimited" ? "Unlimited Experience" : "Ala Carte")
                    </span>
                    @if (string.Equals(Model.OrderChannel, "Qr", StringComparison.OrdinalIgnoreCase))
                    {
                        <span class="badge bg-success p-2 px-3 ms-1" style="font-size: 0.9rem;"><i class="bi bi-qr-code"></i> QR order</span>
                    }
                    else if (string.Equals(Model.OrderChannel, "Kiosk", StringComparison.OrdinalIgnoreCase) || string.IsNullOrEmpty(Model.OrderChannel))
                    {
                        <span class="badge bg-secondary p-2 px-3 ms-1" style="font-size: 0.9rem;"><i class="bi bi-display"></i> Kiosk</span>
                    }
                </div>
                @if (!string.IsNullOrEmpty(serviceLocationLabel) || !string.IsNullOrEmpty(Model.Floor))
                {
                    <p class="mb-3" style="font-size: 1rem;">
                        <i class="bi bi-geo-alt-fill text-warning"></i>
                        <strong>Service location:</strong>
                        @if (!string.IsNullOrEmpty(Model.Floor)) { <span>Floor @Model.Floor</span> }
                        @if (!string.IsNullOrEmpty(Model.Floor) && !string.IsNullOrEmpty(serviceLocationLabel)) { <span> · </span> }
                        @if (!string.IsNullOrEmpty(serviceLocationLabel)) { <span>@serviceLocationLabel</span> }
                    </p>
                }

                <!-- Order Items -->
                @if (Model.Items != null && Model.Items.Any())
                {
                    @foreach (var item in Model.Items)
                    {
                        <div class="order-item">
                            <div>
                                <strong>@item.ItemName</strong>
                                <span style="color: #666;"> x @item.Quantity</span>
                                @if (Model.OrderType == "Unlimited")
                                {
                                    <br /><small style="color: #999; font-size: 0.85em;">@(item.Price > 0 ? "Ala Carte add-on" : "Unlimited Menu Item")</small>
                                }
                            </div>
                            <div>
                                @if (Model.OrderType == "Unlimited")
                                {
                                    @if (item.Price > 0)
                                    {
                                        <span>₱@((item.Price * item.Quantity).ToString("0.00"))</span>
                                        <br /><span style="color: #ff6b35; font-weight: bold;">Ala Carte add-on</span>
                                    }
                                    else
                                    {
                                        <span style="color: #28a745; font-weight: bold;">Included</span>
                                    }
                                }
                                else
                                {
                                    <span>₱@((item.Price * item.Quantity).ToString("0.00"))</span>
                                }
                            </div>
                        </div>
                    }
                }
                else
                {
                    <p class="text-muted">No items in this order.</p>
                }

                <!-- Order Summary -->
                <div style="margin-top: 15px; padding-top: 15px; border-top: 2px solid #dee2e6;">
                    <div class="d-flex justify-content-between mb-2">
                        <span style="font-weight: 500;">Subtotal:</span>
                        <span style="font-weight: 500;">₱@Model.Subtotal.ToString("N2")</span>
                    </div>
                </div>
                <div class="order-total-row">
                    <span>Total Amount:</span>
                    <span>₱@Model.Total.ToString("N2")</span>
                </div>
                
                <!-- Order Status Badge -->
                <div class="mt-3">
                    @{
                        var statusClass = Model.Status.ToLower().Replace(" ", "-");
                        var badgeClass = statusClass switch
                        {
                            "pending" => "bg-warning text-dark",
                            "in-progress" => "bg-info text-white",
                            "completed" => "bg-success text-white",
                            "canceled" => "bg-danger text-white",
                            _ => "bg-secondary text-white"
                        };
                    }
                    <span class="badge @badgeClass p-2 px-3" style="font-size: 0.95rem;">
                        <i class="bi bi-@(statusClass == "pending" ? "hourglass-split" : statusClass == "in-progress" ? "arrow-repeat" : statusClass == "completed" ? "check-circle" : "x-circle")"></i> 
                        <strong>Status: @Model.Status</strong>
                    </span>
                </div>
            </div>
        </div>

        <!-- RIGHT: Horizontal Order Tracking -->
        <div class="col-md-6">
            <h3 class="section-title">Order Status</h3>
            <div class="tracking-horizontal">
                <div class="tracking-step-horizontal" data-step="pending">
                    <div class="tracking-icon-horizontal"><i class="bi bi-hourglass-split"></i></div>
                    <p>Pending</p>
                </div>
                <div class="tracking-step-horizontal" data-step="in-progress">
                    <div class="tracking-icon-horizontal"><i class="bi bi-fire"></i></div>
                    <p>In Progress</p>
                </div>
                <div class="tracking-step-horizontal" data-step="completed">
                    <div class="tracking-icon-horizontal"><i class="bi bi-check-circle"></i></div>
                    <p>Completed</p>
                </div>
            </div>
            <div class="mt-4 text-center">
                <div id="statusBadge" class="status-badge-large">
                    <i class="bi bi-info-circle"></i> Current Status: <strong>@Model.Status</strong>
                </div>
            </div>
        </div>
    </div>

    @if (canReorderUnlimited && hasPrivateOrderAccess && confirmationQuickItems.Any())
    {
        <section class="quick-order-panel" id="confirmationQuickOrder">
            <div class="quick-order-head">
                <div>
                    <h3><i class="bi bi-lightning-charge-fill"></i> Quick Order</h3>
                    <p>Add more unlimited items from this page. Current wing flavors still follow the 4-flavor table limit.</p>
                </div>
                <a asp-action="UnlimitedMenu" asp-controller="Kiosk" asp-area="Customer" asp-route-isReorder="true" asp-route-previousOrderNumber="@Model.OrderNumber" class="quick-order-link reorder-unlimited-action">
                    Full menu
                </a>
            </div>

            <div class="quick-order-groups">
                @foreach (var group in confirmationQuickItems.GroupBy(i => i.Group))
                {
                    <div>
                        <p class="quick-group-title">@group.Key</p>
                        <div class="quick-order-grid">
                            @foreach (var item in group)
                            {
                                <button type="button"
                                        class="quick-order-item"
                                        data-name="@item.Name"
                                        data-quantity="@item.Quantity">
                                    <span>@item.Label</span>
                                    <small>+@item.Quantity</small>
                                </button>
                            }
                        </div>
                    </div>
                }
            </div>

            <div class="quick-order-cart" id="quickOrderCart" style="display:none;">
                <div class="quick-order-cart-list" id="quickOrderCartList"></div>
                <button type="button" class="quick-order-send" id="sendQuickOrder">
                    <i class="bi bi-send"></i> Send Quick Order
                </button>
            </div>
        </section>
    }

    <!-- Action Buttons -->
    <div class="action-buttons">
        @{
            var canCancel = Model.Status != null && 
                           hasPrivateOrderAccess &&
                           Model.Status.Equals("Pending", StringComparison.OrdinalIgnoreCase);
        }
        @if (canCancel)
        {
            <button class="btn-danger" id="cancelOrderBtn" onclick="cancelOrder('@Model.OrderNumber')">
                <i class="bi bi-x-circle"></i> Cancel Order
            </button>
        }
        else
        {
            <button class="btn-secondary" disabled style="opacity: 0.6; cursor: not-allowed;">
                <i class="bi bi-x-circle"></i> Cannot Cancel
            </button>
        }
        @if (Model.OrderType == "Unlimited")
        {
            if (canReorderUnlimited)
            {
                <a asp-action="UnlimitedMenu" asp-controller="Kiosk" asp-area="Customer" asp-route-isReorder="true" asp-route-previousOrderNumber="@Model.OrderNumber" class="btn-primary reorder-unlimited-action" style="text-decoration: none; background: #F39C12;">
                    <i class="bi bi-arrow-repeat"></i> Full Menu
                </a>
            }
            else
            {
                <button class="btn-secondary" disabled style="opacity: 0.6; cursor: not-allowed;">
                    <i class="bi bi-arrow-repeat"></i> Reorder Unavailable
                </button>
            }
        }
        @if (hasPrivateOrderAccess)
        {
            <a asp-action="Receipt" asp-controller="Kitchen" asp-area="Kitchen" asp-route-orderNumber="@Model.OrderNumber" asp-route-accessToken="@publicAccessToken" asp-route-returnUrl="@currentUrl" class="btn-primary" style="text-decoration: none; background: #111827;">
                <i class="bi bi-receipt"></i> Receipt / Bill
            </a>
        }
        @if (sessionEnded || orderingSessionExpired)
        {
            <a id="newOrderLink" asp-action="Index" asp-controller="Kiosk" asp-area="Customer" asp-route-startNewSession="true" class="btn-primary" style="text-decoration: none;">
                <i class="bi bi-house"></i> New Order
            </a>
        }
        else
        {
            <a id="newOrderLink" asp-action="Index" asp-controller="Kiosk" asp-area="Customer" class="btn-primary" style="text-decoration: none;">
                <i class="bi bi-house"></i> New Order
            </a>
        }
    </div>

    <div class="text-center mt-4">
        <p class="text-muted" style="font-size: 0.9rem; margin-bottom: 10px;">
            <i class="bi bi-info-circle"></i> <strong>Save your order number:</strong> <span style="font-size: 1.2rem; color: #ff6b35; font-weight: bold;">@Model.OrderNumber</span>
        </p>
        <p class="text-muted" style="font-size: 0.85rem;">
            Lost this page? Go to the homepage and enter your order number to track your order status anytime.
        </p>
        <a asp-action="Index" asp-controller="Kiosk" asp-area="Customer" style="color: #ff6b35; text-decoration: underline; font-size: 0.9rem;">
            <i class="bi bi-arrow-left"></i> Back to Home / Track Another Order
        </a>
    </div>
</div>

<div class="refresh-indicator" id="refreshIndicator">
    <div class="spinner"></div>
    <span>Checking status...</span>
</div>

<script>
    // Highlight current step based on actual order status
    const orderingSessionExpired = @orderingSessionExpired.ToString().ToLowerInvariant();
    const publicAccessToken = "@publicAccessToken";
    const confirmationQuickItems = @Html.Raw(quickItemsJson);
    const quickOrderCart = [];

    function renderQuickOrderCart() {
        const shell = document.getElementById('quickOrderCart');
        const list = document.getElementById('quickOrderCartList');
        if (!shell || !list) return;

        if (quickOrderCart.length === 0) {
            shell.style.display = 'none';
            list.innerHTML = '';
            return;
        }

        shell.style.display = '';
        list.innerHTML = quickOrderCart.map((item, index) => `
            <div class="quick-cart-row">
                <span><strong>${escapeQuickHtml(item.ItemName)}</strong> × ${item.Quantity}</span>
                <button type="button" data-remove-quick="${index}">Remove</button>
            </div>
        `).join('');
    }

    function escapeQuickHtml(value) {
        return String(value ?? '')
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#39;');
    }

    document.getElementById('confirmationQuickOrder')?.addEventListener('click', function(e) {
        const remove = e.target.closest('[data-remove-quick]');
        if (remove) {
            quickOrderCart.splice(Number(remove.getAttribute('data-remove-quick')), 1);
            renderQuickOrderCart();
            return;
        }

        const button = e.target.closest('.quick-order-item');
        if (!button) return;

        const name = button.getAttribute('data-name');
        const quantity = Number(button.getAttribute('data-quantity') || '1');
        const quickDefinition = confirmationQuickItems.find(item => item.Name === name);
        const existing = quickOrderCart.find(item => item.ItemName === name);
        if (existing) {
            const nextQuantity = existing.Quantity + (Number.isFinite(quantity) && quantity > 0 ? quantity : 1);
            if (quickDefinition?.IsWingFlavor && nextQuantity > 4) {
                alert('Maximum of 4 pieces per wing flavor.');
                return;
            }
            if (nextQuantity > 20) {
                alert('That quantity is too high for one quick order.');
                return;
            }
            existing.Quantity = nextQuantity;
        } else {
            quickOrderCart.push({
                ItemName: name,
                Quantity: Number.isFinite(quantity) && quantity > 0 ? quantity : 1,
                Price: 0
            });
        }
        renderQuickOrderCart();
    });

    document.getElementById('sendQuickOrder')?.addEventListener('click', function() {
        if (quickOrderCart.length === 0) return;

        const button = this;
        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
        button.disabled = true;
        button.innerHTML = '<i class="bi bi-hourglass-split"></i> Sending...';

        fetch('/Customer/Kiosk/QuickUnlimitedOrder?orderNumber=@Model.OrderNumber&accessToken=' + encodeURIComponent(publicAccessToken), {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': token
            },
            body: JSON.stringify(quickOrderCart)
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                alert(data.message || 'Quick order sent to the kitchen.');
                quickOrderCart.length = 0;
                renderQuickOrderCart();
                if (data.orderNumber && data.accessToken) {
                    window.location.href = '/Customer/Kiosk/Confirmation?orderNumber=' + encodeURIComponent(data.orderNumber) + '&accessToken=' + encodeURIComponent(data.accessToken);
                }
                return;
            }

            alert(data.message || 'Unable to send quick order.');
            if (data.sessionEnded) {
                disableReorderUnlimited();
                makeNewOrderStartNewSession();
            }
        })
        .catch(error => {
            console.error('Quick order failed:', error);
            alert('Unable to send quick order. Please try again.');
        })
        .finally(() => {
            button.disabled = false;
            button.innerHTML = '<i class="bi bi-send"></i> Send Quick Order';
        });
    });

    function disableReorderUnlimited() {
        document.querySelectorAll('.reorder-unlimited-action').forEach(reorderLink => {
            const disabled = document.createElement('button');
            disabled.type = 'button';
            disabled.className = reorderLink.classList.contains('quick-order-link') ? 'btn-secondary' : 'btn-secondary';
            disabled.disabled = true;
            disabled.style.opacity = '0.6';
            disabled.style.cursor = 'not-allowed';
            disabled.innerHTML = '<i class="bi bi-arrow-repeat"></i> Reorder Unavailable';
            reorderLink.replaceWith(disabled);
        });

        const quickPanel = document.getElementById('confirmationQuickOrder');
        if (quickPanel) quickPanel.style.display = 'none';
    }

    function makeNewOrderStartNewSession() {
        const newOrderLink = document.getElementById('newOrderLink');
        if (!newOrderLink) return;

        const url = new URL(newOrderLink.href, window.location.origin);
        url.searchParams.set('startNewSession', 'true');
        newOrderLink.href = url.toString();
    }

    if (orderingSessionExpired) {
        disableReorderUnlimited();
        makeNewOrderStartNewSession();
        setTimeout(() => {
            alert('Your ordering session is already over. You cannot add more orders to this session.');
        }, 350);
    }

    const orderStatus = "@Model.Status".toLowerCase().replace(" ", "-");
    const statusSteps = ["pending", "in-progress", "completed"];
    const currentStepIndex = statusSteps.indexOf(orderStatus);
    
    document.querySelectorAll('.tracking-step-horizontal').forEach((step, index) => {
        const stepStatus = step.getAttribute('data-step');
        if (index < currentStepIndex) {
            step.classList.add('completed');
        } else if (index === currentStepIndex) {
            step.classList.add('in-progress');
        } else {
            step.classList.add('pending');
        }
    });

    // Update status badge
    const statusBadge = document.getElementById('statusBadge');
    if (statusBadge) {
        statusBadge.className = 'status-badge-large ' + orderStatus;
    }

    // Poll order status: 5s while in progress; 20s when completed/canceled (page reloads on transition)
    let refreshInterval;
    const indicator = document.getElementById('refreshIndicator');
    const statusNorm = "@Model.Status".toLowerCase().replace(' ', '-');
    const pollMs = (statusNorm === 'completed' || statusNorm === 'canceled') ? 20000 : 5000;

    function checkOrderStatus() {
        if (document.hidden) {
            return; // Don't check if page is hidden
        }

        if (indicator) {
            indicator.classList.add('show');
        }

        fetch('/Customer/Kiosk/GetOrderStatus?orderNumber=@Model.OrderNumber&accessToken=' + encodeURIComponent(publicAccessToken))
            .then(response => {
                if (!response.ok) {
                    throw new Error('Network response was not ok');
                }
                return response.json();
            })
            .then(data => {
                if (indicator) {
                    indicator.classList.remove('show');
                }

                if (data.status && data.status !== '@Model.Status') {
                    location.reload();
                }
            })
            .catch(error => {
                console.log('Status check failed:', error);
                if (indicator) {
                    indicator.classList.remove('show');
                }
            });
    }

    refreshInterval = setInterval(checkOrderStatus, pollMs);

    document.addEventListener('visibilitychange', function() {
        if (document.hidden) {
            if (refreshInterval) {
                clearInterval(refreshInterval);
                refreshInterval = null;
            }
        } else {
            if (!refreshInterval) {
                refreshInterval = setInterval(checkOrderStatus, pollMs);
                checkOrderStatus();
            }
        }
    });

    setTimeout(checkOrderStatus, 2000);

    // Ordering session timer
    (function () {
        const timerBox = document.getElementById('confirmation-session-timer');
        const timerLabel = document.getElementById('confirmation-session-label');
        if (!timerBox || !timerLabel) return;

        function formatSessionTime(totalSeconds) {
            const safeSeconds = Math.max(0, Number(totalSeconds) || 0);
            const hours = Math.floor(safeSeconds / 3600);
            const minutes = Math.floor((safeSeconds % 3600) / 60);
            const seconds = safeSeconds % 60;
            return `${hours.toString().padStart(2, '0')}:${minutes.toString().padStart(2, '0')}:${seconds.toString().padStart(2, '0')}`;
        }

        function updateSessionTimer() {
            fetch('/Customer/Kiosk/GetSessionInfo?orderNumber=@Model.OrderNumber&accessToken=' + encodeURIComponent(publicAccessToken))
                .then(response => response.json())
                .then(data => {
                    if (data.sessionEnded || data.isExpired) {
                        disableReorderUnlimited();
                        makeNewOrderStartNewSession();
                    }

                    if (!data.hasSession) {
                        timerBox.classList.remove('expired');
                        timerBox.style.display = 'none';
                        timerLabel.textContent = `${data.sessionHours || @sessionHours}-hour window starts when staff starts your first Unlimited order.`;
                        return;
                    }

                    timerBox.style.display = '';
                    if (data.isExpired) {
                        timerBox.classList.add('expired');
                        timerLabel.textContent = 'expired';
                        return;
                    }

                    timerBox.classList.remove('expired');
                    timerLabel.textContent = `${formatSessionTime(data.timeRemainingSeconds)} remaining`;
                })
                .catch(error => console.log('Session timer check failed:', error));
        }

        updateSessionTimer();
        setInterval(updateSessionTimer, 15000);
    })();

    // Cancel order function
    function cancelOrder(orderNumber) {
        if (!confirm('Are you sure you want to cancel this order?')) {
            return;
        }

        const cancelBtn = document.getElementById('cancelOrderBtn');
        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
        if (cancelBtn) {
            cancelBtn.disabled = true;
            cancelBtn.innerHTML = '<i class="bi bi-hourglass-split"></i> Cancelling...';
        }

        fetch('/Customer/Kiosk/CancelOrder?orderNumber=' + encodeURIComponent(orderNumber) + '&accessToken=' + encodeURIComponent(publicAccessToken), {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': token
            }
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                alert('Order has been cancelled successfully.');
                location.reload();
            } else {
                alert('Error: ' + (data.message || 'Failed to cancel order.'));
                if (cancelBtn) {
                    cancelBtn.disabled = false;
                    cancelBtn.innerHTML = '<i class="bi bi-x-circle"></i> Cancel Order';
                }
            }
        })
        .catch(error => {
            console.error('Error cancelling order:', error);
            alert('An error occurred while cancelling the order. Please try again.');
            if (cancelBtn) {
                cancelBtn.disabled = false;
                cancelBtn.innerHTML = '<i class="bi bi-x-circle"></i> Cancel Order';
            }
        });
    }
</script>
