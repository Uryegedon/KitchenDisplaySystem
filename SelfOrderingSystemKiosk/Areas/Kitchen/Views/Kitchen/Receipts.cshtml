@model IEnumerable<SelfOrderingSystemKiosk.Areas.Kitchen.Models.TableOverviewViewModel>
@{
    ViewData["Title"] = "Receipts / Tables";
    var currentReturnUrl = Context.Request.Path + Context.Request.QueryString;
    var dateFilter = ViewBag.DateFilter as string ?? "all";
    var showArchived = ViewBag.ShowArchived is bool archived && archived;
    var tables = Model.ToList();
    var occupiedCount = tables.Count(t => t.IsOccupied);
    var pendingBillCount = tables.Sum(t => t.Receipts.Count(r => r.Orders.Any() && !r.Orders.All(o => string.Equals(o.PaymentStatus, "Paid", StringComparison.OrdinalIgnoreCase))));
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css" rel="stylesheet">
    <style>
        * { box-sizing: border-box; }
        body {
            margin: 0;
            min-height: 100vh;
            padding: 24px;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #FFB347 0%, #FFA07A 100%);
            color: #333;
        }

        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 16px;
            margin-bottom: 28px;
        }

        h1 {
            margin: 0;
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 2rem;
            color: #333;
        }

        .btn {
            border: 0;
            border-radius: 30px;
            padding: 11px 18px;
            color: #333;
            background: rgba(255, 255, 255, 0.92);
            text-decoration: none;
            font-weight: 800;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            cursor: pointer;
            box-shadow: 0 4px 15px rgba(0,0,0,0.12);
            transition: all 0.25s;
        }

        .btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(0,0,0,0.18);
        }

        .btn.subtle {
            background: rgba(255, 255, 255, 0.72);
            color: #555;
        }

        .header-actions {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
            justify-content: flex-end;
        }

        .summary-row {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
            margin-bottom: 20px;
        }

        .summary-pill {
            border: 0;
            background: rgba(255, 255, 255, 0.9);
            color: #555;
            padding: 10px 16px;
            border-radius: 999px;
            font-weight: 800;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
            display: inline-flex;
            align-items: center;
            gap: 7px;
        }

        .search-bar {
            position: relative;
            margin-bottom: 18px;
        }

        .search-bar i {
            position: absolute;
            left: 16px;
            top: 50%;
            transform: translateY(-50%);
            color: #6b7280;
        }

        .search-bar input {
            width: 100%;
            border: 0;
            border-radius: 18px;
            padding: 14px 18px 14px 44px;
            font-size: 1rem;
            background: rgba(255, 255, 255, 0.94);
            color: #333;
            box-shadow: 0 4px 15px rgba(0,0,0,0.12);
            outline: none;
        }

        .search-bar input:focus {
            box-shadow: 0 0 0 3px rgba(255, 87, 34, 0.22), 0 4px 15px rgba(0,0,0,0.12);
        }

        .grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
            gap: 16px;
            align-items: start;
        }

        .bill-card {
            background: rgba(255, 255, 255, 0.96);
            border-radius: 20px;
            padding: 18px;
            box-shadow: 0 6px 20px rgba(0,0,0,0.15);
            border-left: 6px solid #FF5722;
            transition: transform 0.25s, box-shadow 0.25s;
            align-self: start;
        }

        .bill-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 24px rgba(0,0,0,0.2);
        }

        .bill-head {
            display: flex;
            justify-content: space-between;
            gap: 12px;
            margin-bottom: 12px;
        }

        .receipt-number {
            font-size: 1.25rem;
            font-weight: 800;
            color: #333;
        }

        .meta {
            color: #6b7280;
            font-size: 0.92rem;
            line-height: 1.45;
        }

        .total {
            font-size: 1.4rem;
            font-weight: 900;
            color: #FF5722;
            text-align: right;
        }

        .pill {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            border-radius: 999px;
            background: #FFF3CD;
            color: #856404;
            padding: 4px 9px;
            font-size: 0.82rem;
            font-weight: 800;
            margin-top: 4px;
        }

        .pill.paid {
            background: #D4EDDA;
            color: #155724;
        }

        .pill.pending {
            background: #FFF3CD;
            color: #856404;
        }

        .pill.expired {
            background: #F8D7DA;
            color: #721C24;
        }

        .card-actions {
            margin-top: 14px;
            display: flex;
            justify-content: flex-end;
            gap: 8px;
            flex-wrap: wrap;
        }

        .card-actions form {
            margin: 0;
        }

        .lane-bills {
            display: grid;
            gap: 8px;
            margin-top: 12px;
        }

        .lane-bill {
            display: grid;
            grid-template-columns: minmax(0, 1fr) auto;
            align-items: center;
            gap: 10px;
            padding: 10px;
            border: 1px solid #FFE0A3;
            border-radius: 12px;
            background: #fffaf0;
        }

        .lane-bill strong,
        .lane-bill span {
            display: block;
        }

        .lane-bill .btn {
            padding: 8px 12px;
            font-size: 0.86rem;
            white-space: nowrap;
        }

        .empty {
            background: rgba(255, 255, 255, 0.96);
            padding: 28px;
            border-radius: 20px;
            text-align: center;
            color: #6b7280;
            box-shadow: 0 6px 20px rgba(0,0,0,0.12);
        }

        .flash {
            background: rgba(255, 255, 255, 0.96);
            border-radius: 12px;
            padding: 12px 14px;
            margin-bottom: 14px;
            font-weight: 800;
            box-shadow: 0 4px 15px rgba(0,0,0,0.12);
        }

        .flash.ok { color: #155724; }
        .flash.err { color: #721c24; }

        @@media (max-width: 640px) {
            body { padding: 14px; }
            .header { flex-direction: column; align-items: stretch; }
        }
    </style>
</head>
<body>
    <div class="header">
        <h1><i class="bi bi-table"></i> Receipts / Tables</h1>
        <div class="header-actions">
            <a class="btn subtle" asp-area="Kitchen" asp-controller="Kitchen" asp-action="Receipts" asp-route-showArchived="@(!showArchived)">
                <i class="bi @(showArchived ? "bi-eye-slash" : "bi-eye")"></i> @(showArchived ? "Hide closed bills" : "Show closed bills")
            </a>
            <a class="btn" asp-area="Kitchen" asp-controller="Kitchen" asp-action="Index">
                <i class="bi bi-arrow-left"></i> Kitchen
            </a>
            <form asp-area="Admin" asp-controller="Account" asp-action="Logout" method="post" style="display:inline;">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn">
                    <i class="bi bi-box-arrow-right"></i> Logout
                </button>
            </form>
        </div>
    </div>

    <div class="summary-row">
        <span class="summary-pill"><i class="bi bi-grid-3x3-gap"></i> 7 dine-in tables + counter/take out</span>
        <span class="summary-pill"><i class="bi bi-person-check"></i> @occupiedCount occupied</span>
        <span class="summary-pill"><i class="bi bi-receipt"></i> @pendingBillCount pending bill@(pendingBillCount == 1 ? "" : "s")</span>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="flash ok"><i class="bi bi-check-circle"></i> @TempData["SuccessMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="flash err"><i class="bi bi-exclamation-triangle"></i> @TempData["ErrorMessage"]</div>
    }

    <div class="search-bar">
        <i class="bi bi-search"></i>
        <input id="receiptSearch" type="search" placeholder="Search table, bill, status, or item..." autocomplete="off" />
    </div>

    @if (tables.Any())
    {
        <div class="empty" id="receiptSearchEmpty" style="display:none;">
            <i class="bi bi-search" style="font-size: 2rem;"></i>
            <p>No bills match your search.</p>
        </div>
        <div class="grid">
            @foreach (var table in tables)
            {
                var receipts = table.Receipts;
                var receipt = table.Receipt;
                var timerReceipt = receipts
                    .Where(r => r.IsTableSession
                        && r.HasSessionStarted
                        && string.Equals(r.TableNumber, table.TableNumber, StringComparison.OrdinalIgnoreCase)
                        && (string.IsNullOrWhiteSpace(table.BranchId)
                            || string.IsNullOrWhiteSpace(r.BranchId)
                            || string.Equals(r.BranchId, table.BranchId, StringComparison.OrdinalIgnoreCase))
                        && r.Orders.Any(o => o.SessionStartedAtUtc.HasValue
                            && string.Equals(o.OrderType, "Unlimited", StringComparison.OrdinalIgnoreCase)
                            && string.Equals(o.TableNumber, table.TableNumber, StringComparison.OrdinalIgnoreCase)))
                    .OrderByDescending(r => r.SessionStartUtc)
                    .FirstOrDefault();
                var isPaid = table.IsPaid;
                var isExpired = timerReceipt?.SessionEndUtc <= DateTime.UtcNow;
                var isClosed = !table.IsOccupied && table.HasBill && (isPaid || receipt?.Orders.All(o => o.BillArchived) == true);
                var isExpiredBill = !table.IsOccupied && table.HasBill && isExpired;
                var needsPayment = !table.IsOccupied && table.HasBill && !isPaid && !isExpiredBill;
                var endIso = timerReceipt?.SessionEndUtc.ToUniversalTime().ToString("O") ?? "";
                var stateLabel = table.IsOccupied ? "Occupied" : isExpiredBill ? "Expired Bill" : needsPayment ? "Needs Payment" : isClosed ? "Closed" : table.HasBill ? "Open Bills" : "Available";
                var stateIcon = table.IsOccupied ? "bi-person-check" : isExpiredBill ? "bi-hourglass-bottom" : needsPayment ? "bi-cash-coin" : isClosed ? "bi-check-circle" : "bi-door-open";
                var searchText = string.Join(" ", new[]
                {
                    table.LocationLabel,
                    table.TableNumber,
                    table.Floor,
                    stateLabel,
                    isPaid ? "Paid" : "Pending",
                    string.Join(" ", receipts.Select(r => r.ReceiptNumber)),
                    string.Join(" ", receipts.SelectMany(r => r.Orders).Select(o => $"{o.OrderNumber} {o.OrderType} {o.Status}")),
                    string.Join(" ", receipts.SelectMany(r => r.LineItems).Select(i => i.ItemName))
                });
                <div class="bill-card" data-search="@searchText.ToLowerInvariant()">
                    <div class="bill-head">
                        <div>
                            <div class="receipt-number">@table.LocationLabel</div>
                            <div class="meta">
                                @if (receipts.Count > 1)
                                {
                                    <span>@receipts.Count active bills</span>
                                }
                                else
                                {
                                    <span>@(receipt?.ReceiptNumber != null ? $"Bill #{receipt.ReceiptNumber}" : "No active bill")</span>
                                }
                            </div>
                            <span class="pill @(isExpiredBill ? "expired" : table.IsOccupied ? "pending" : isClosed ? "paid" : "")">
                                <i class="bi @stateIcon"></i> @stateLabel
                            </span>
                            @if (table.PersonCount > 0)
                            {
                                <span class="pill">
                                    <i class="bi bi-people"></i> @table.PersonCount pax
                                </span>
                            }
                            @if (table.HasBill)
                            {
                                <span class="pill @(isPaid ? "paid" : "pending")">
                                    <i class="bi bi-cash-coin"></i> @(isPaid ? "Paid" : "Pending")
                                </span>
                            }
                            @if (timerReceipt != null)
                            {
                                <span class="pill session-timer" data-session-end="@endIso">
                                    <i class="bi bi-hourglass-split"></i> <span>Checking</span>
                                </span>
                            }
                            else if (receipt?.Orders.Any(o => string.Equals(o.OrderType, "Unlimited", StringComparison.OrdinalIgnoreCase)) == true)
                            {
                                <span class="pill pending">
                                    <i class="bi bi-hourglass"></i> Starts when staff starts order
                                </span>
                            }
                        </div>
                        <div class="total">₱@table.Total.ToString("N2")</div>
                    </div>
                    <div class="meta">
                        @table.OrderCount order@(table.OrderCount == 1 ? "" : "s")
                        @if (receipt != null && receipts.Count == 1)
                        {
                            <span> · @receipt.TotalItems item@(receipt.TotalItems == 1 ? "" : "s")</span><br>
                            <span>@(receipt.HasSessionStarted ? AppClock.ToLocal(receipt.SessionStartUtc).ToString("MMM dd, h:mm tt") : "Session not started")</span>
                            @if (receipt.IsTableSession && receipt.HasSessionStarted)
                            {
                                <span> - @AppClock.ToLocal(receipt.SessionEndUtc).ToString("h:mm tt")</span>
                            }
                        }
                    </div>
                    @if (receipts.Count > 1 || (!table.CanManageOrdering && receipts.Count == 1))
                    {
                        <div class="lane-bills">
                            @foreach (var laneReceipt in receipts)
                            {
                                var lanePaid = laneReceipt.Orders.All(o => string.Equals(o.PaymentStatus, "Paid", StringComparison.OrdinalIgnoreCase));
                                var laneTime = AppClock.ToLocal(laneReceipt.Orders.Select(o => o.OrderDate).DefaultIfEmpty(laneReceipt.SessionStartUtc).Max());
                                <div class="lane-bill">
                                    <div>
                                        <strong>Bill #@laneReceipt.ReceiptNumber</strong>
                                        <span class="meta">@laneReceipt.TotalItems item@(laneReceipt.TotalItems == 1 ? "" : "s") · @laneTime.ToString("h:mm tt")</span>
                                        <span class="pill @(lanePaid ? "paid" : "pending")">
                                            <i class="bi bi-cash-coin"></i> @(lanePaid ? "Paid" : "Pending") · ₱@laneReceipt.Total.ToString("N2")
                                        </span>
                                    </div>
                                    @if (laneReceipt.AnchorOrder != null)
                                    {
                                        <a class="btn" asp-area="Kitchen" asp-controller="Kitchen" asp-action="Receipt" asp-route-id="@laneReceipt.AnchorOrder.Id" asp-route-returnUrl="@currentReturnUrl">
                                            Open
                                        </a>
                                    }
                                </div>
                            }
                        </div>
                    }
                    <div class="card-actions">
                        @if (table.CanManageOrdering)
                        {
                            var actionBranchId = table.OrderingSession?.BranchId ?? table.BranchId ?? table.Receipt?.AnchorOrder?.BranchId ?? string.Empty;
                            var nextOccupiedState = !table.IsOccupied;
                            <form method="post" asp-area="Kitchen" asp-controller="Kitchen" asp-action="ToggleTable">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="table" value="@table.TableNumber" />
                                <input type="hidden" name="branchId" value="@actionBranchId" />
                                <input type="hidden" name="occupied" value="@nextOccupiedState.ToString().ToLowerInvariant()" />
                                <input type="hidden" name="dateFilter" value="@dateFilter" />
                                <input type="hidden" name="showArchived" value="@showArchived.ToString().ToLowerInvariant()" />
                                <button class="btn @(table.IsOccupied ? "subtle" : "")" type="submit">
                                    <i class="bi bi-@(table.IsOccupied ? "toggle-on" : "toggle-off")"></i>
                                    @(table.IsOccupied ? "Occupied" : "Available")
                                </button>
                            </form>
                        }
                        @if (table.CanManageOrdering && receipt?.AnchorOrder != null)
                        {
                            <a class="btn" asp-area="Kitchen" asp-controller="Kitchen" asp-action="Receipt" asp-route-id="@receipt.AnchorOrder.Id" asp-route-returnUrl="@currentReturnUrl">
                                <i class="bi bi-box-arrow-up-right"></i> Open Bill
                            </a>
                        }
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="empty">
            <i class="bi bi-table" style="font-size: 2rem;"></i>
            <p>No tables found for this filter.</p>
        </div>
    }
    <script>
        (function () {
            function updateTimers() {
                document.querySelectorAll('.session-timer').forEach(timer => {
                    const label = timer.querySelector('span');
                    const end = new Date(timer.dataset.sessionEnd);
                    const remainingMs = end.getTime() - Date.now();

                    if (remainingMs <= 0) {
                        timer.classList.add('expired');
                        if (label) label.textContent = 'Expired';
                        return;
                    }

                    timer.classList.remove('expired');
                    const totalSeconds = Math.floor(remainingMs / 1000);
                    const minutes = Math.floor(totalSeconds / 60);
                    const seconds = totalSeconds % 60;
                    if (label) label.textContent = `${minutes}m ${seconds.toString().padStart(2, '0')}s`;
                });
            }

            updateTimers();
            setInterval(updateTimers, 1000);

            const search = document.getElementById('receiptSearch');
            const empty = document.getElementById('receiptSearchEmpty');
            const cards = Array.from(document.querySelectorAll('.bill-card'));

            function applySearch() {
                const query = (search?.value || '').trim().toLowerCase();
                let visible = 0;

                cards.forEach(card => {
                    const matches = !query || (card.dataset.search || '').includes(query);
                    card.style.display = matches ? '' : 'none';
                    if (matches) visible += 1;
                });

                if (empty) empty.style.display = visible === 0 ? 'block' : 'none';
            }

            if (search) search.addEventListener('input', applySearch);
        })();
    </script>
</body>
</html>
